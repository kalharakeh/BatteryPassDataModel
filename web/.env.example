MONGODB_URI=replace-with-your-mongodb-atlas-connection-string
MONGODB_DB=battery_pass_demo
APP_URL=http://localhost:5186
APP_BASE_URL=http://localhost:5186
REQUIRE_HTTPS_REDIRECTION=true
TRUSTED_PROXY_NETWORKS=10.0.0.0/20,10.0.16.0/20
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TIMEOUT_MINUTES=180
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=Password123!
DID_ISSUER_DID=did:web:local.battery.pass:issuer
DID_ISSUER_PRIVATE_KEY=
EXTERNAL_API_ENCRYPTION_KEY=replace-with-32-random-characters
ID_GENERATION_SECRET=battery-pass-local-development-id-secret
ENABLE_DEMO_DATA=true
ENABLE_PUBLIC_DEMO_READ_TOKEN=true
ENABLE_DEMO_WRITE_SIGN_TESTING=true
ENABLE_DEMO_ADMIN_FALLBACK=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_PER_WINDOW=10
EXTERNAL_API_READ_RATE_LIMIT_PER_WINDOW=120
EXTERNAL_API_WRITE_RATE_LIMIT_PER_WINDOW=30
EXTERNAL_API_LIFECYCLE_RATE_LIMIT_PER_WINDOW=10
FILE_UPLOAD_RATE_LIMIT_PER_WINDOW=10
MAX_AUTHORIZATION_HEADER_BYTES=4096
MAX_JSON_BODY_BYTES=1048576
MAX_TELEMETRY_POINTS=250
MAX_UPLOAD_BYTES=10485760
POWER_AUTOMATE_RESET_WEBHOOK_URL=https://replace-with-your-power-automate-http-trigger-url
POWER_AUTOMATE_RESET_WEBHOOK_SECRET=replace-with-a-long-random-shared-secret
PASSWORD_RESET_APP_NAME=Battery Pass
