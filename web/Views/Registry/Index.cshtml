@model IReadOnlyList<BatteryPassWeb.Models.ViewModels.PassportSummaryViewModel>
@{
    ViewData["Title"] = "Scania Passport Registry";
    var registryScopeLabel = ViewData["RegistryScopeLabel"] as string ?? "Search and open battery passports linked to your account.";
    var registryEmptyLabel = ViewData["RegistryEmptyLabel"] as string ?? "No batteries are currently linked to your account.";
}
<main class="bp-page">
    <h1 class="mb-1">Scania Passport Registry</h1>
    <p class="text-secondary mb-0">@registryScopeLabel</p>

    <form action="/registry" class="bp-search-form mt-4">
        <input
            name="q"
            value="@Context.Request.Query["q"]"
            placeholder="Search by battery ID, battery family, serial, or manufacturer" />
        <button type="submit">Search</button>
    </form>

    @if (Model.Count == 0)
    {
        <div class="bp-card mt-4">
            @registryEmptyLabel
        </div>
    }
    else
    {
        <div class="bp-card mt-4 p-0 overflow-auto">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-3 py-3">Battery ID</th>
                        <th class="px-3 py-3">Battery Family</th>
                        <th class="px-3 py-3">Battery version</th>
                        <th class="px-3 py-3">Battery serial number</th>
                        <th class="px-3 py-3">Passport status</th>
                        <th class="px-3 py-3">Updated</th>
                        <th class="px-3 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td class="px-3 py-3 text-break">@row.PassportId</td>
                            <td class="px-3 py-3">@row.BatteryFamily</td>
                            <td class="px-3 py-3">@row.BatteryVersion</td>
                            <td class="px-3 py-3">@row.BatterySerialNumber</td>
                            <td class="px-3 py-3">@row.PassportStatus</td>
                            <td class="px-3 py-3">@(string.IsNullOrWhiteSpace(row.UpdatedDate) ? "-" : row.UpdatedDate[..Math.Min(10, row.UpdatedDate.Length)])</td>
                            <td class="px-3 py-3">
                                <div class="bp-icon-action-row">
                                    <a href="/@Uri.EscapeDataString(row.PassportId)/summary" class="bp-report-action" aria-label="Summary report" title="Summary report" data-tooltip="Summary report">
                                        <svg class="bp-report-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M6 3h9l3 3v15H6z" />
                                            <path d="M15 3v4h4" />
                                            <path d="M9 11h6M9 15h6M9 19h4" />
                                        </svg>
                                    </a>
                                    <a href="/@Uri.EscapeDataString(row.PassportId)" class="bp-report-action" aria-label="Detailed report" title="Detailed report" data-tooltip="Detailed report">
                                        <svg class="bp-report-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M6 3h9l3 3v15H6z" />
                                            <path d="M15 3v4h4" />
                                            <path d="M10 12a3 3 0 1 0 4.24 4.24" />
                                            <path d="m14 16 3 3" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
