@model IReadOnlyList<BatteryPassWeb.Models.ViewModels.PassportSummaryViewModel>
@{
    ViewData["Title"] = "Scania Passport Registry";
    var registryScopeLabel = ViewData["RegistryScopeLabel"] as string ?? "Search and open battery passports linked to your account.";
    var registryEmptyLabel = ViewData["RegistryEmptyLabel"] as string ?? "No batteries are currently linked to your account.";
}
<main class="bp-page bp-admin-page bp-registry-page">
    <header class="bp-console-header">
        <div>
            <h1>Scania Passport Registry</h1>
            <p class="text-secondary mb-0">@registryScopeLabel</p>
        </div>
    </header>

    <section class="bp-console-toolbar">
        <form action="/registry" class="bp-search-form">
            <input
                name="q"
                value="@Context.Request.Query["q"]"
                placeholder="Search by battery ID, battery family, serial, or manufacturer" />
            <button type="submit">Search</button>
        </form>
    </section>

    @if (Model.Count == 0)
    {
        <div class="bp-card">
            @registryEmptyLabel
        </div>
    }
    else
    {
        <div class="bp-card bp-table-card">
            <div class="bp-table-scroll">
            <table class="table table-hover align-middle bp-console-table">
                <thead>
                    <tr>
                        <th>Battery ID</th>
                        <th>Battery Family</th>
                        <th>Battery version</th>
                        <th>Battery serial number</th>
                        <th>Passport status</th>
                        <th>Updated</th>
                        <th class="bp-action-cell">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        var passportStatusClass = row.PassportStatus.Equals("published", StringComparison.OrdinalIgnoreCase)
                            ? "bp-status-pill is-published"
                            : row.PassportStatus.Equals("signed", StringComparison.OrdinalIgnoreCase)
                                ? "bp-status-pill is-signed"
                                : "bp-status-pill is-draft";
                        <tr>
                            <td><span class="bp-battery-id-cell">@row.PassportId</span></td>
                            <td>@row.BatteryFamily</td>
                            <td>@row.BatteryVersion</td>
                            <td>@row.BatterySerialNumber</td>
                            <td><span class="@passportStatusClass">@row.PassportStatus</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.UpdatedDate) ? "-" : row.UpdatedDate[..Math.Min(10, row.UpdatedDate.Length)])</td>
                            <td class="bp-action-cell">
                                <div class="bp-icon-action-row">
                                    <a href="/@Uri.EscapeDataString(row.PassportId)/summary" class="bp-report-action" aria-label="Summary report" title="Summary report" data-tooltip="Summary report">
                                        <svg class="bp-report-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M6 3h9l3 3v15H6z" />
                                            <path d="M15 3v4h4" />
                                            <path d="M9 11h6M9 15h6M9 19h4" />
                                        </svg>
                                    </a>
                                    <a href="/@Uri.EscapeDataString(row.PassportId)" class="bp-report-action" aria-label="Detailed report" title="Detailed report" data-tooltip="Detailed report">
                                        <svg class="bp-report-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M6 3h9l3 3v15H6z" />
                                            <path d="M15 3v4h4" />
                                            <path d="M10 12a3 3 0 1 0 4.24 4.24" />
                                            <path d="m14 16 3 3" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
</main>
