@using BatteryPassWeb.Models.Trust
@model BatteryPassWeb.Models.ViewModels.ConformanceViewModel
@{
    ViewData["Title"] = "Passport conformance";
    var passport = Model.Passport;
    var readiness = Model.Readiness;
    var summary = Model.ValidationSummary;
    var isPublished = string.Equals(passport.RegistryStatus, "published", StringComparison.OrdinalIgnoreCase);
    var showSignPassport = readiness.NextActionKey == PassportReadinessAction.Sign && readiness.CanSign;
    var showPublishPassport = readiness.NextActionKey == PassportReadinessAction.Publish && readiness.CanPublish;
    var showWorkflowComplete = readiness.NextActionKey == PassportReadinessAction.None || (readiness.CanPublish && isPublished);
    var evidencePack = Model.EvidencePack;
}

<main class="bp-page bp-admin-page">
    <div class="bp-page-return-row bp-conformance-return-row">
        <a href="/admin/clusters?tab=passports" class="bp-page-return-link bp-conformance-return-link">Back to passport list</a>
    </div>

    <section class="bp-card bp-conformance-shell bp-readiness-hero bp-readiness-@readiness.Severity">
        <div class="bp-readiness-copy">
            <span class="bp-summary-title">Passport readiness</span>
            <h1>@Model.Readiness.StateLabel</h1>
            <p class="bp-passport-id">@passport.PassportId</p>
            <p class="bp-help-text mb-0">@readiness.PrimaryReason</p>
            <div class="bp-conformance-actions mt-3">
                <a href="/admin/help" class="bp-secondary-button">Admin help</a>
                <a href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/edit" class="bp-secondary-button">Edit passport</a>
                <a href="/@Uri.EscapeDataString(passport.PassportId)/summary" class="bp-secondary-button">Preview summary</a>
                <a href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/audit" class="bp-secondary-button">Audit trail</a>
                <a href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/revisions" class="bp-secondary-button">Revision history</a>
            </div>
        </div>
        <aside class="bp-next-action-panel bp-next-step-card">
            <span>Next action</span>
            <strong>@Model.Readiness.NextActionLabel</strong>
            <p>@readiness.NextActionDescription</p>
            <div class="bp-action-row bp-action-row-primary">
                <div class="bp-action-control">
                    <form method="post" action="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/validate">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="bp-secondary-button">Validate passport</button>
                    </form>
                </div>
                @if (showSignPassport)
                {
                    <div class="bp-action-control">
                        <form method="post" action="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/sign">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="bp-primary-button">Sign passport</button>
                        </form>
                        @if (isPublished)
                        {
                            <p class="bp-help-text mb-0">Signing will automatically publish the new revision.</p>
                        }
                    </div>
                }
                @if (showPublishPassport)
                {
                    <div class="bp-action-control">
                        <form method="post" action="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/publish">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="bp-primary-button">Publish passport</button>
                        </form>
                    </div>
                }
                @if (showWorkflowComplete)
                {
                    <p class="bp-empty-state mb-0">No trust action is needed right now.</p>
                }
            </div>
        </aside>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success mt-3 mb-0">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">@Model.ErrorMessage</div>
    }

    <section class="bp-readiness-strip" aria-label="Readiness metrics">
        <div class="bp-readiness-card is-muted">
            <p>Product template</p>
            <strong>@(string.IsNullOrWhiteSpace(passport.ProductName) ? "Unlinked" : passport.ProductName)</strong>
            <span>Template-owned data must be valid before signing; manual battery overrides stay dirty until re-signed.</span>
        </div>
        <div class="bp-readiness-card @(summary.BlockingErrorCount == 0 ? "is-ready" : "is-blocked")">
            <p>Blocking errors</p>
            <strong>@summary.BlockingErrorCount</strong>
            <span>@(summary.BlockingErrorCount == 0 ? "Schema and business blockers are clear." : "Fix these before signing.")</span>
        </div>
        <div class="bp-readiness-card @(summary.WarningCount == 0 ? "is-ready" : "is-warning")">
            <p>Warnings</p>
            <strong>@summary.WarningCount</strong>
            <span>Warnings are diagnostics. Official schema and selected required fields still decide signing.</span>
        </div>
        <div class="bp-readiness-card @(readiness.CanSign ? "is-ready" : "is-blocked")">
            <p>Can sign</p>
            <strong>@(readiness.CanSign ? "Yes" : "No")</strong>
            <span>@(readiness.CanSign ? "Ready for cryptographic proof." : "Complete required fields first.")</span>
        </div>
        <div class="bp-readiness-card @(readiness.CanPublish ? "is-ready" : "is-muted")">
            <p>Latest validation</p>
            <strong>@summary.State</strong>
            <span>@(string.IsNullOrWhiteSpace(summary.ValidatedAt) ? "Not validated yet." : summary.ValidatedAt)</span>
        </div>
    </section>

    <section class="bp-card bp-conformance-panel bp-evidence-panel">
        <div class="bp-panel-heading">
            <span class="bp-summary-title">Evidence readiness</span>
            <span class="bp-count-pill @(evidencePack.BlockingCount == 0 ? "is-ready" : string.Empty)">@evidencePack.BlockingCount blockers</span>
        </div>
        <h2>Supporting document evidence</h2>
        <p class="bp-help-text">Document hashes are checked against the latest signed revision. Replacing a file makes the passport dirty until it is signed again.</p>

        <div class="bp-evidence-metrics" aria-label="Evidence metrics">
            <div class="bp-readiness-card @(evidencePack.MissingRequiredCount == 0 ? "is-ready" : "is-blocked")">
                <p>Missing required</p>
                <strong>@evidencePack.MissingRequiredCount</strong>
                <span>Required supporting files that still need an upload.</span>
            </div>
            <div class="bp-readiness-card @(evidencePack.ChangedSinceSigningCount == 0 ? "is-ready" : "is-warning")">
                <p>Changed since signing</p>
                <strong>@evidencePack.ChangedSinceSigningCount</strong>
                <span>Uploaded hashes that differ from the latest signed revision.</span>
            </div>
            <div class="bp-readiness-card @(evidencePack.UploadedUnsignedCount == 0 ? "is-muted" : "is-warning")">
                <p>Uploaded unsigned</p>
                <strong>@evidencePack.UploadedUnsignedCount</strong>
                <span>Uploaded files waiting for the next signature.</span>
            </div>
            <div class="bp-readiness-card @(evidencePack.VerifiedCount == evidencePack.RequiredCount && evidencePack.RequiredCount > 0 ? "is-ready" : "is-muted")">
                <p>Verified documents</p>
                <strong>@evidencePack.VerifiedCount</strong>
                <span>Current hashes found in the latest signed revision.</span>
            </div>
        </div>

        <div class="bp-evidence-list">
            @foreach (var item in evidencePack.Items)
            {
                <article class="bp-evidence-item bp-evidence-status-@item.Status">
                    <div class="bp-evidence-item-header">
                        <div>
                            <span>@(item.IsRequired ? "Required evidence" : "Optional evidence")</span>
                            <strong>@item.Label</strong>
                        </div>
                        <span class="bp-evidence-status">@item.StatusLabel</span>
                    </div>
                    <dl class="bp-evidence-details">
                        <div><dt>Visibility</dt><dd>@(item.Visibility == "public" ? "Public" : "Private / privileged")</dd></div>
                        <div><dt>Current hash</dt><dd><code>@(string.IsNullOrWhiteSpace(item.CurrentHash) ? "-" : item.CurrentHash)</code></dd></div>
                        <div><dt>Signed hash</dt><dd><code>@(string.IsNullOrWhiteSpace(item.SignedHash) ? "-" : item.SignedHash)</code></dd></div>
                        <div><dt>Next action</dt><dd>@item.RecommendedAction</dd></div>
                    </dl>
                    <a class="bp-secondary-button bp-button-compact" href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/edit#@EvidenceEditAnchor(item.DocumentKey)">Upload or replace</a>
                </article>
            }
        </div>
    </section>

    <section class="bp-conformance-main-grid">
        <div class="bp-card bp-conformance-panel bp-workflow-panel bp-blocker-groups bp-completion-checklist">
            <div class="bp-panel-heading">
                <span class="bp-summary-title">Completion checklist</span>
                <span class="bp-count-pill">@summary.BlockingErrorCount</span>
            </div>
            <h2>Required data by section</h2>
            <p class="bp-help-text">What is stopping signing? Full-data requirements are grouped by section so the admin can jump straight to the field that needs work.</p>
            <div class="bp-panel-heading">
                <span class="bp-summary-title">Blocking data to fix</span>
                <span class="bp-count-pill">@summary.BlockingErrorCount</span>
            </div>
            @if (Model.GroupedBlockingIssues.Count == 0)
            {
                <p class="bp-empty-state">No blocking errors. The passport can move to the next trust action.</p>
            }
            else
            {
                <div class="bp-completion-sections">
                    @foreach (var group in Model.GroupedBlockingIssues)
                    {
                        <article class="bp-completion-section bp-blocker-group">
                            <div class="bp-completion-section-header">
                                <div>
                                    <span>Section</span>
                                    <strong>@group.SectionLabel</strong>
                                </div>
                                <a class="bp-secondary-button bp-button-compact" href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/edit#@group.EditAnchor">Edit section</a>
                            </div>
                            <div class="bp-completion-items">
                                @foreach (var issue in group.Issues)
                                {
                                    <div class="bp-completion-item">
                                        <div class="bp-completion-kind">@CompletionCategory(issue)</div>
                                        <dl>
                                            <div>
                                                <dt>Data point</dt>
                                                <dd><code>@FriendlyDataPoint(issue.Path)</code></dd>
                                            </div>
                                            <div>
                                                <dt>What to do</dt>
                                                <dd>@CompletionGuidance(issue)</dd>
                                            </div>
                                            <div>
                                                <dt>Validation message</dt>
                                                <dd>@issue.Message</dd>
                                            </div>
                                        </dl>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="bp-card bp-conformance-panel">
            <div class="bp-panel-heading">
                <span class="bp-summary-title">Publish gate</span>
                <span class="bp-count-pill @(readiness.CanPublish ? "is-ready" : "is-muted")">@(readiness.CanPublish ? "Ready" : "Locked")</span>
            </div>
            <h2>Validation and publish policy</h2>
            <dl class="bp-policy-list">
                <div><dt>Save draft</dt><dd>Save draft is always allowed for admins.</dd></div>
                <div><dt>Schema</dt><dd>Official schema violations block signing.</dd></div>
                <div><dt>Signing</dt><dd>Signing requires zero blocking errors.</dd></div>
                <div><dt>Publishing</dt><dd>Publish requires a current valid signature proof.</dd></div>
                <div><dt>Current gate</dt><dd>@(string.IsNullOrWhiteSpace(Model.PublishBlockReason) ? readiness.PrimaryReason : Model.PublishBlockReason)</dd></div>
            </dl>
        </div>
    </section>

    <section class="bp-card bp-conformance-panel bp-advanced-diagnostics bp-validation-drawer">
        <details>
            <summary>
                <strong>Advanced diagnostics</strong>
                <span>@summary.WarningCount warnings</span>
            </summary>
            <div class="bp-evidence-grid">
                <div>
                    <h2>Non-blocking warnings</h2>
                    @if (Model.GroupedWarningIssues.Count == 0)
                    {
                        <p class="bp-empty-state">No warnings were reported.</p>
                    }
                    else
                    {
                        @foreach (var group in Model.GroupedWarningIssues)
                        {
                            <h3 class="h6">@group.SectionLabel</h3>
                            <ol class="bp-issue-list is-warning">
                                @foreach (var issue in group.Issues)
                                {
                                    <li>
                                        <code>@issue.Path</code>
                                        <span>@issue.Message</span>
                                    </li>
                                }
                            </ol>
                        }
                    }
                </div>
                <div>
                    <h2>Verification diagnostics</h2>
                    <p class="bp-help-text">Proof and hash diagnostics for the latest signature check.</p>
                    <dl class="bp-diagnostics-list">
                        <div><dt>Issuer</dt><dd>@(string.IsNullOrWhiteSpace(Model.VerificationResult.Issuer) ? "-" : Model.VerificationResult.Issuer)</dd></div>
                        <div><dt>Signed date</dt><dd>@(string.IsNullOrWhiteSpace(Model.VerificationResult.SignedAt) ? "-" : Model.VerificationResult.SignedAt)</dd></div>
                        <div><dt>Dirty state</dt><dd>@(passport.TrustIsDirty ? "Dirty" : "Clean")</dd></div>
                        <div><dt>Message</dt><dd>@Model.VerificationResult.Message</dd></div>
                        <div><dt>Expected hash</dt><dd><code>@(string.IsNullOrWhiteSpace(Model.VerificationResult.ExpectedHash) ? "-" : Model.VerificationResult.ExpectedHash)</code></dd></div>
                        <div><dt>Current hash</dt><dd><code>@(string.IsNullOrWhiteSpace(Model.VerificationResult.CurrentHash) ? "-" : Model.VerificationResult.CurrentHash)</code></dd></div>
                    </dl>
                </div>
            </div>
        </details>
    </section>

    <section class="bp-card bp-conformance-panel bp-validation-drawer">
        <div class="bp-panel-heading">
            <span class="bp-summary-title">Detailed validation</span>
            <span class="bp-count-pill is-muted">@summary.Sections.Count sections</span>
        </div>
        <div class="bp-validation-sections">
            @foreach (var sectionResult in summary.Sections)
            {
                var sectionBlocking = sectionResult.Issues.Count(issue => issue.Severity == TrustValidationSeverity.BlockingError);
                var sectionWarnings = sectionResult.Issues.Count(issue => issue.Severity == TrustValidationSeverity.Warning);
                var actionableIssues = sectionResult.Issues
                    .Where(issue => issue.Severity != TrustValidationSeverity.Passed)
                    .ToList();
                <details class="bp-validation-section" open="@(sectionBlocking > 0)">
                    <summary>
                        <strong>@sectionResult.SectionLabel</strong>
                        <span>@sectionBlocking blockers</span>
                        <span>@sectionWarnings warnings</span>
                    </summary>
                    @if (actionableIssues.Count == 0)
                    {
                        <p class="bp-empty-state">All checks passed for this section.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Severity</th>
                                        <th>Path</th>
                                        <th>Message</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var issue in actionableIssues)
                                    {
                                        <tr>
                                            <td>@issue.Severity</td>
                                            <td><code>@issue.Path</code></td>
                                            <td>@issue.Message</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </details>
            }
        </div>
    </section>
</main>

@functions {
    private static string CompletionCategory(TrustValidationIssue issue)
    {
        var message = issue.Message.ToLowerInvariant();
        if (message.Contains("required by the schema", StringComparison.Ordinal) || message.Contains(" is required.", StringComparison.Ordinal))
        {
            return "Missing required data";
        }

        if (message.Contains("pattern", StringComparison.Ordinal))
        {
            return "Invalid format";
        }

        if (message.Contains("allowed schema values", StringComparison.Ordinal) || message.Contains("schema constant", StringComparison.Ordinal))
        {
            return "Invalid value";
        }

        if (message.Contains("cannot be negative", StringComparison.Ordinal))
        {
            return "Business-rule data";
        }

        if (message.Contains("payload must be an object", StringComparison.Ordinal))
        {
            return "Missing section payload";
        }

        return "Blocking check";
    }

    private static string CompletionGuidance(TrustValidationIssue issue)
    {
        var message = issue.Message.ToLowerInvariant();
        if (message.Contains("payload must be an object", StringComparison.Ordinal))
        {
            return "Create this section payload and provide its official required fields.";
        }

        if (message.Contains("required by the schema", StringComparison.Ordinal) || message.Contains(" is required.", StringComparison.Ordinal))
        {
            return "Fill this required Battery Pass data point in the section shown above.";
        }

        if (message.Contains("pattern", StringComparison.Ordinal))
        {
            return "Replace the current value with the official Battery Pass format for this data point.";
        }

        if (message.Contains("allowed schema values", StringComparison.Ordinal) || message.Contains("schema constant", StringComparison.Ordinal))
        {
            return "Choose one of the official Battery Pass allowed values for this field.";
        }

        if (message.Contains("cannot be negative", StringComparison.Ordinal))
        {
            return "Enter a non-negative measurement value.";
        }

        return "Review and correct this data point until the blocking validation message clears.";
    }

    private static string FriendlyDataPoint(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "Section payload";
        }

        var cleaned = path;
        const string payloadMarker = ".payload.";
        var payloadIndex = cleaned.IndexOf(payloadMarker, StringComparison.OrdinalIgnoreCase);
        if (payloadIndex >= 0)
        {
            cleaned = cleaned[(payloadIndex + payloadMarker.Length)..];
        }
        else if (cleaned.StartsWith("aspects.", StringComparison.OrdinalIgnoreCase))
        {
            cleaned = cleaned["aspects.".Length..];
        }

        return cleaned
            .Replace(".", " / ", StringComparison.Ordinal)
            .Replace("[", " [", StringComparison.Ordinal);
    }

    private static string EvidenceEditAnchor(string documentKey)
    {
        return documentKey switch
        {
            "conformityAssessment" or "euDeclarationOfConformity" => "admin-compliance",
            "sustainabilityReport" or "dueDiligenceReport" or "thirdPartyAudit" or "taxonomyReport" => "admin-supply-chain",
            "co2StudyReference" => "admin-carbon-footprint",
            _ => "admin-general"
        };
    }
}
