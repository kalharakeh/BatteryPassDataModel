@using BatteryPassWeb.Services
@using System.Text.Json
@model BatteryPassWeb.Models.ViewModels.ProductTemplateEditViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.ProductId) ? "New battery family" : $"Edit {Model.ProductName}";
    var isNew = string.IsNullOrWhiteSpace(Model.ProductId);
    var currentProductVersion = Model.ProductVersions.FirstOrDefault();
    var baseProductCatalogJson = JsonSerializer.Serialize(Model.BaseProductCatalog);
    var productVersionsJson = JsonSerializer.Serialize(Model.ProductVersions);
    var imageOptions = BatteryImageCatalog.Options;
    var selectedImageUrl = BatteryImageCatalog.NormalizeKnownImageUrl(Model.ImageUrl, string.Empty);
    var materialMasses = BatteryPassCanonicalDataCatalog.Materials
        .Select(material => new
        {
            material.Label,
            Value = Model.MaterialMassesKg.TryGetValue(material.Label, out var value) ? value : material.DemoMassKg
        })
        .ToList();
    var carbonStages = BatteryPassCanonicalDataCatalog.CarbonStages
        .Select(stage => new
        {
            stage.Stage,
            Value = Model.CarbonStages.TryGetValue(stage.Stage, out var value) ? value : stage.DemoValue
        })
        .ToList();
    var recycledContent = new[] { "Nickel", "Cobalt", "Lithium", "Lead" }
        .Select(material =>
        {
            var value = Model.RecycledContent.TryGetValue(material, out var existing)
                ? existing
                : new BatteryPassWeb.Models.ViewModels.ProductTemplateRecycledContentViewModel();
            return new { Material = material, value.PreConsumerShare, value.PostConsumerShare };
        })
        .ToList();
}

<main class="bp-page bp-admin-page">
    <div class="bp-page-return-row">
        <a href="/admin/clusters?tab=products" class="bp-page-return-link">Back to battery families</a>
    </div>

    <section class="bp-card bp-product-editor-hero">
        <div>
            <span class="bp-summary-title">Battery Family</span>
            <h1>@(isNew ? "Create battery family" : Model.ProductName)</h1>
            <p class="mb-0">
                Shared battery family, software, evidence, and completion-policy data stored in MongoDB.
                New batteries copy this data first, then battery-specific identifiers are added on top.
            </p>
        </div>
        <div class="bp-product-editor-preview">
            <img src="@selectedImageUrl" alt="Battery family preview image" />
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success mt-3 mb-0">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">@Model.ErrorMessage</div>
    }

    <script type="application/json" data-base-product-catalog>@Html.Raw(baseProductCatalogJson)</script>
    <script type="application/json" data-product-versions-json-source>@Html.Raw(productVersionsJson)</script>

    <form method="post" action="/admin/products/save" class="bp-product-editor-form mt-4">
        @Html.AntiForgeryToken()

        <div class="bp-product-editor-workspace">
            <section class="bp-card bp-product-version-console bp-console-form-card" data-product-version-manager>
                <div class="bp-product-version-console-header">
                    <div>
                        <h2>Battery Models</h2>
                        <p class="bp-help-text mb-0">Select a tab to edit its software, parameters, documents, and completion policy.</p>
                    </div>
                    <button type="button" class="bp-secondary-button bp-button-compact" data-add-product-version>Add version</button>
                </div>
                <input type="hidden" name="productVersion" value="@(currentProductVersion?.Version ?? "1.0")" data-current-product-version />
                <input type="hidden" name="productVersionsJson" value="" data-product-versions-json />
                <div class="bp-product-version-tab-rail bp-product-version-chip-rail" role="tablist" aria-label="Battery Models" data-product-version-list data-product-version-tab-rail>
                    @foreach (var productVersion in Model.ProductVersions)
                    {
                        var isCurrentVersion = currentProductVersion?.Version.Equals(productVersion.Version, StringComparison.OrdinalIgnoreCase) == true;
                        <article class="bp-product-version-tab bp-product-version-chip is-saved-version @(isCurrentVersion ? "is-active" : string.Empty)" data-product-version-row data-product-version-tab data-version="@productVersion.Version">
                            <button type="button" class="bp-product-version-tab-main" role="tab" aria-selected="@(isCurrentVersion ? "true" : "false")" title="Edit version @productVersion.Version" data-edit-product-version>
                                <span>Battery Model</span>
                                <strong>@productVersion.Version</strong>
                            </button>
                            <label class="bp-product-version-tab-input">
                                <span>Version number</span>
                                <input type="text" value="@productVersion.Version" readonly data-product-version-input />
                            </label>
                            <span class="bp-product-version-chip-pill">@(isCurrentVersion ? "Selected" : "Saved")</span>
                            <small>@(isCurrentVersion ? "Currently editing this model" : "Saved Battery Model")</small>
                        </article>
                    }
                </div>
                <div class="bp-product-version-selected-panel">
                    <label class="bp-product-version-selected-field">
                        <span>Currently editing</span>
                        @if (isNew)
                        {
                            <input type="text" value="@(currentProductVersion?.Version ?? "1.0")" data-selected-product-version-label data-selected-product-version-input />
                        }
                        else
                        {
                            <input type="text" value="@(currentProductVersion?.Version ?? "1.0")" readonly data-selected-product-version-label data-selected-product-version-input />
                        }
                    </label>
                    <div class="bp-product-version-selected-meta">
                        <strong>Push is version-level</strong>
                        <span>Push updates template-owned fields for batteries using this Battery Model. Manual battery overrides are preserved.</span>
                    </div>
                    <div class="bp-product-version-selected-actions">
                        @if (!isNew && currentProductVersion != null)
                        {
                            <button
                                type="submit"
                                form="push-product-version-@Model.ProductId-@currentProductVersion.Version"
                                class="bp-secondary-button bp-button-compact"
                                data-push-selected-product-version>
                                Push to batteries
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="bp-secondary-button bp-button-compact" data-push-selected-product-version disabled>Push to batteries</button>
                        }
                        <button type="button" class="bp-danger-button bp-button-compact" data-remove-product-version data-remove-selected-product-version>Remove</button>
                    </div>
                </div>
            </section>

            <div class="bp-product-editor-content">
                <div class="bp-product-editor-grid">
        @if (isNew)
        {
            <section class="bp-card bp-product-editor-section bp-span-all">
                <div class="bp-product-section-heading">
                    <div>
                        <h2>Base on existing template</h2>
                        <p class="bp-help-text mb-0">Start empty, or choose an existing battery family and Battery Model to fill the editable fields.</p>
                    </div>
                    <button type="button" class="bp-secondary-button bp-button-compact" data-apply-base-template>Use selected base</button>
                </div>
                <div class="bp-form-grid">
                    <label class="bp-field-shell">
                        <span>Base battery family</span>
                        <select data-base-product-select>
                            <option value="">No base battery family</option>
                            @foreach (var product in Model.BaseProductCatalog)
                            {
                                <option value="@product.ProductId">@product.ProductName</option>
                            }
                        </select>
                    </label>
                    <label class="bp-field-shell">
                        <span>Base Battery Model</span>
                        <select data-base-product-version-select>
                            <option value="">Select a battery family first</option>
                        </select>
                    </label>
                </div>
            </section>
        }

        <section class="bp-card bp-product-editor-section bp-product-identity-section">
            <h2>Battery family identity</h2>
            <div class="bp-form-grid bp-product-identity-grid">
                <label class="bp-field-shell">
                    <span>Battery family ID</span>
                    @if (isNew)
                    {
                        <input type="text" name="productId" value="@Model.ProductId" placeholder="compact-7m" required />
                    }
                    else
                    {
                        <input type="text" name="productId" value="@Model.ProductId" readonly />
                    }
                    <small class="bp-field-help">Stable MongoDB key used to link batteries to this battery family.</small>
                </label>
                <label class="bp-field-shell">
                    <span>Battery Family</span>
                    @if (isNew)
                    {
                        <input type="text" name="productName" value="@Model.ProductName" placeholder="Compact 7M" required />
                    }
                    else
                    {
                        <input type="text" name="productName" value="@Model.ProductName" readonly />
                    }
                    <small class="bp-field-help">Friendly battery family name shown in admin and signed metadata. Existing battery family names are locked.</small>
                </label>
                <label class="bp-field-shell bp-span-2">
                    <span>Description</span>
                    <textarea name="description">@Model.Description</textarea>
                    <small class="bp-field-help">Short description that helps admins pick the right baseline.</small>
                </label>
                <label class="bp-field-shell">
                    <span>Battery family image</span>
                    <select name="imageUrl">
                        @foreach (var imageOption in imageOptions)
                        {
                            <option value="@imageOption.Url" selected="@(imageOption.Url.Equals(selectedImageUrl, StringComparison.OrdinalIgnoreCase))">@imageOption.Label</option>
                        }
                    </select>
                    <small class="bp-field-help">The image copied to batteries created from this template.</small>
                </label>
                <label class="bp-field-shell">
                    <span>Module count</span>
                    <input type="number" name="moduleCount" min="1" step="1" value="@Model.ModuleCount" />
                    <small class="bp-field-help">Useful product context; Compact 7M has 7 modules and Compact 13M has 13.</small>
                </label>
            </div>
        </section>

        <section class="bp-card bp-product-editor-section bp-product-version-editor-shell" data-version-scoped-section>
            <div class="bp-product-section-heading">
                <div>
                    <h2>Software parameters</h2>
                    <p class="bp-help-text mb-0">Software version, release date, and latest update are parameters on the selected Battery Model.</p>
                </div>
                <button type="button" class="bp-secondary-button bp-button-compact" data-add-software-version>Add software version</button>
            </div>
            <div class="bp-template-version-list" data-software-version-list>
                @{ var softwareVersionRows = currentProductVersion?.SoftwareVersions.Count > 0
                    ? currentProductVersion.SoftwareVersions
                    : new[] { new BatteryPassWeb.Models.ViewModels.ProductSoftwareVersionEditViewModel
                        {
                            SoftwareVersion = currentProductVersion?.SoftwareVersion ?? string.Empty,
                            SoftwareReleaseDate = currentProductVersion?.SoftwareReleaseDate ?? string.Empty,
                            SoftwareLatestUpdate = currentProductVersion?.SoftwareLatestUpdate ?? string.Empty
                        } }; }
                @foreach (var softwareVersionRow in softwareVersionRows)
                {
                <article class="bp-template-version-row" data-software-version-row>
                    <label class="bp-field-shell">
                        <span>Software version</span>
                        <input type="text" name="softwareVersion" value="@softwareVersionRow.SoftwareVersion" required />
                    </label>
                    <label class="bp-field-shell">
                        <span>Release date</span>
                        <input type="date" name="softwareReleaseDate" value="@softwareVersionRow.SoftwareReleaseDate" required />
                    </label>
                    <label class="bp-field-shell">
                        <span>Latest update</span>
                        <input type="date" name="softwareLatestUpdate" value="@softwareVersionRow.SoftwareLatestUpdate" required />
                    </label>
                    <button type="button" class="bp-action-button is-danger" data-remove-software-version aria-label="Remove software version">Remove</button>
                </article>
                }
            </div>
            <p class="bp-help-text mb-0">Save battery family changes before pushing. Push updates only template-owned fields and preserves manual battery overrides.</p>
        </section>

        <section class="bp-card bp-product-editor-section bp-product-version-editor-shell" data-version-scoped-section>
            <h2>Shared battery family values</h2>
            <div class="bp-form-grid">
                <label class="bp-field-shell"><span>Battery mass kg</span><input type="number" step="any" name="batteryMassKg" value="@Model.BatteryMassKg" /></label>
                <label class="bp-field-shell"><span>Rated energy kWh</span><input type="number" step="any" name="ratedEnergyKwh" value="@Model.RatedEnergyKwh" /></label>
                <label class="bp-field-shell"><span>Rated capacity Ah</span><input type="number" step="any" name="ratedCapacityAh" value="@Model.RatedCapacityAh" /></label>
                <label class="bp-field-shell"><span>Maximum power kW</span><input type="number" step="any" name="ratedMaximumPowerKw" value="@Model.RatedMaximumPowerKw" /></label>
                <label class="bp-field-shell"><span>Nominal voltage V</span><input type="number" step="any" name="nominalVoltageV" value="@Model.NominalVoltageV" /></label>
                <label class="bp-field-shell"><span>Expected lifetime years</span><input type="number" step="any" name="expectedLifetimeYears" value="@Model.ExpectedLifetimeYears" /></label>
                <label class="bp-field-shell"><span>Expected cycles</span><input type="number" step="any" name="expectedCycles" value="@Model.ExpectedCycles" /></label>
                <label class="bp-field-shell"><span>Supply chain index</span><input type="number" step="any" name="supplyChainIndex" value="@Model.SupplyChainIndex" /></label>
                <label class="bp-field-shell"><span>Carbon footprint gCO2e/kWh</span><input type="number" step="any" name="carbonFootprint" value="@Model.CarbonFootprint" /></label>
                <label class="bp-field-shell"><span>Performance class</span><input type="text" name="performanceClass" value="@Model.PerformanceClass" /></label>
            </div>
        </section>

        <section class="bp-card bp-product-editor-section bp-product-version-editor-shell" data-version-scoped-section>
            <h2>Material composition</h2>
            <div class="bp-form-grid">
                @foreach (var material in materialMasses)
                {
                    <label class="bp-field-shell">
                        <span>@material.Label kg</span>
                        <input type="hidden" name="materialName" value="@material.Label" />
                        <input type="number" step="any" name="materialMass" value="@material.Value" />
                    </label>
                }
            </div>
        </section>

        <section class="bp-card bp-product-editor-section bp-product-version-editor-shell" data-version-scoped-section>
            <h2>Carbon lifecycle stages</h2>
            <div class="bp-form-grid">
                @foreach (var stage in carbonStages)
                {
                    <label class="bp-field-shell">
                        <span>@stage.Stage gCO2e/kWh</span>
                        <input type="hidden" name="carbonStage" value="@stage.Stage" />
                        <input type="number" step="any" name="carbonStageValue" value="@stage.Value" />
                    </label>
                }
            </div>
        </section>

        <section class="bp-card bp-product-editor-section bp-product-version-editor-shell" data-version-scoped-section>
            <h2>Circularity</h2>
            <p class="bp-help-text">Model-level recycled-content values copied to batteries using this Battery Model.</p>
            <div class="bp-form-grid">
                @foreach (var recycled in recycledContent)
                {
                    <label class="bp-field-shell">
                        <span>@recycled.Material pre consumer %</span>
                        <input type="number" step="any" name="recycled@(recycled.Material)Pre" value="@recycled.PreConsumerShare" />
                    </label>
                    <label class="bp-field-shell">
                        <span>@recycled.Material post consumer %</span>
                        <input type="number" step="any" name="recycled@(recycled.Material)Post" value="@recycled.PostConsumerShare" />
                    </label>
                }
            </div>
        </section>

        <section class="bp-card bp-product-editor-section bp-product-version-editor-shell" data-version-scoped-section>
            <div class="bp-product-section-heading">
                <div>
                    <h2>Template documents</h2>
                    <p class="bp-help-text mb-0">Document references copied into batteries created from the selected Battery Model.</p>
                </div>
            </div>
            <div class="bp-template-document-list" data-template-document-list>
                @foreach (var document in currentProductVersion?.TemplateDocuments ?? [])
                {
                    <article class="bp-template-document-row">
                        <div>
                            <strong>@document.Label</strong>
                            <span>@document.DocumentKey</span>
                        </div>
                        <code>@document.FileName</code>
                        <span class="bp-template-document-visibility">@document.Visibility</span>
                    </article>
                }
            </div>
        </section>

        <section class="bp-card bp-product-editor-section bp-span-all" data-version-scoped-section>
            @{
                var dataRequirements = Model.DataRequirements;
                var totalFields = dataRequirements.Sections.Sum(section => section.Fields.Count);
                var totalRequired = dataRequirements.Sections.Sum(section => section.RequiredCount);
            }
            <div class="bp-data-requirements-hero">
                <div>
                    <span class="bp-summary-title">Template completion policy</span>
                    <h2>Required and optional parameters</h2>
                    <p class="mb-0">These checkboxes are saved for the selected Battery Model in MongoDB and used by validation, signing, publishing, and the conformance page for batteries linked to that model.</p>
                </div>
                <div class="bp-requirement-stats">
                    <div><span>Parameters</span><strong data-requirement-total>@totalFields</strong></div>
                    <div><span>Required</span><strong data-requirement-required>@totalRequired</strong></div>
                    <div><span>Optional</span><strong data-requirement-optional>@(totalFields - totalRequired)</strong></div>
                </div>
            </div>
            <div class="bp-data-requirements-grid mt-3">
                @foreach (var requirementSection in dataRequirements.Sections.OrderBy(section => section.SortOrder))
                {
                    <article class="bp-requirement-section-card" data-requirement-section-card>
                        <div class="bp-requirement-section-header">
                            <div>
                                <span>Section</span>
                                <h3>@requirementSection.Label</h3>
                            </div>
                            <div class="bp-requirement-section-count">
                                <strong data-requirement-section-count>@requirementSection.RequiredCount</strong>
                                <span>required</span>
                            </div>
                        </div>
                        <div class="bp-requirement-list">
                            @foreach (var requirementField in requirementSection.Fields.OrderBy(field => field.SortOrder))
                            {
                                <label class="bp-requirement-switch">
                                    <input type="checkbox" name="requiredFieldKeys" value="@requirementField.FieldKey" checked="@requirementField.IsRequired" />
                                    <span class="bp-requirement-toggle" aria-hidden="true"></span>
                                    <span class="bp-requirement-copy">
                                        <strong>@requirementField.Label</strong>
                                        <small>@requirementField.Guidance</small>
                                        <code>@requirementField.DataPath</code>
                                    </span>
                                </label>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>

        <div class="bp-product-editor-savebar bp-span-all">
            <div>
                <strong>Save battery family to MongoDB</strong>
                <span>Existing batteries stay unchanged until you push a saved Battery Model update.</span>
            </div>
            <button type="submit" class="bp-primary-button">Save battery family</button>
        </div>
                </div>
            </div>
        </div>
    </form>

    @if (!isNew)
    {
        @foreach (var productVersion in Model.ProductVersions)
        {
            <form id="push-product-version-@Model.ProductId-@productVersion.Version" method="post" action="/admin/products/@Uri.EscapeDataString(Model.ProductId)/versions/@Uri.EscapeDataString(productVersion.Version)/push">
                @Html.AntiForgeryToken()
            </form>
        }
    }
</main>

@section Scripts {
    <script>
        (() => {
            const form = document.querySelector('.bp-product-editor-form');
            const softwareList = document.querySelector('[data-software-version-list]');
            const productVersionList = document.querySelector('[data-product-version-list]');
            const addProductVersionButton = document.querySelector('[data-add-product-version]');
            const selectedProductVersionLabels = document.querySelectorAll('[data-selected-product-version-label]');
            const selectedProductVersionInput = document.querySelector('[data-selected-product-version-input]');
            const pushSelectedProductVersionButton = document.querySelector('[data-push-selected-product-version]');
            const removeSelectedProductVersionButton = document.querySelector('[data-remove-selected-product-version]');
            const templateDocumentList = document.querySelector('[data-template-document-list]');
            const requiredFieldInputs = Array.from(document.querySelectorAll('[name="requiredFieldKeys"]'));
            const requirementRequired = document.querySelector('[data-requirement-required]');
            const requirementOptional = document.querySelector('[data-requirement-optional]');
            const productVersionsInput = document.querySelector('[data-product-versions-json]');
            const productVersionsSource = document.querySelector('[data-product-versions-json-source]');
            const currentProductVersionInput = document.querySelector('[data-current-product-version]');
            const baseCatalogElement = document.querySelector('[data-base-product-catalog]');
            const baseProductSelect = document.querySelector('[data-base-product-select]');
            const baseProductVersionSelect = document.querySelector('[data-base-product-version-select]');
            const applyBaseButton = document.querySelector('[data-apply-base-template]');
            const baseCatalog = parseBaseCatalog(baseCatalogElement?.textContent || '[]');
            const isNewProduct = @Html.Raw(JsonSerializer.Serialize(isNew));
            const productId = @Html.Raw(JsonSerializer.Serialize(Model.ProductId));
            const savedProductVersionKeys = new Set(parseBaseCatalog(productVersionsSource?.textContent || '[]')
                .map(version => normalizeVersionKey(version.Version))
                .filter(Boolean));
            let productVersions = parseBaseCatalog(productVersionsSource?.textContent || '[]');
            let currentProductVersion = currentProductVersionInput?.value || productVersions[0]?.Version || '1.0';

            if (!form || !softwareList || !productVersionList || !templateDocumentList || !productVersionsInput || !currentProductVersionInput) {
                return;
            }

            function parseBaseCatalog(rawJson) {
                try {
                    const parsed = JSON.parse(rawJson);
                    return Array.isArray(parsed) ? parsed : [];
                } catch {
                    return [];
                }
            }

            function normalizeVersionKey(value) {
                return String(value || '').trim().toLowerCase();
            }

            function setField(name, value) {
                const field = document.querySelector(`[name="${name}"]`);
                if (field) {
                    field.value = value ?? '';
                    field.dispatchEvent(new Event('input', { bubbles: true }));
                    field.dispatchEvent(new Event('change', { bubbles: true }));
                }
            }

            function numberField(name) {
                const value = Number(document.querySelector(`[name="${name}"]`)?.value || 0);
                return Number.isFinite(value) ? value : 0;
            }

            function collectNumberMap(nameKey, valueKey) {
                const names = Array.from(document.querySelectorAll(`[name="${nameKey}"]`));
                const values = Array.from(document.querySelectorAll(`[name="${valueKey}"]`));
                return names.reduce((result, nameInput, index) => {
                    const name = String(nameInput.value || '').trim();
                    if (name) {
                        result[name] = Number(values[index]?.value || 0);
                    }
                    return result;
                }, {});
            }

            function collectRecycledContent() {
                return ['Nickel', 'Cobalt', 'Lithium', 'Lead'].reduce((result, material) => {
                    result[material] = {
                        PreConsumerShare: numberField(`recycled${material}Pre`),
                        PostConsumerShare: numberField(`recycled${material}Post`)
                    };
                    return result;
                }, {});
            }

            function collectSoftwareParameters() {
                const softwareVersionRows = Array.from(softwareList.querySelectorAll('[data-software-version-row]'))
                    .map(row => ({
                        SoftwareVersion: row.querySelector('[name="softwareVersion"]')?.value?.trim() || '',
                        SoftwareReleaseDate: row.querySelector('[name="softwareReleaseDate"]')?.value || '',
                        SoftwareLatestUpdate: row.querySelector('[name="softwareLatestUpdate"]')?.value || ''
                    }))
                    .filter(row => row.SoftwareVersion);
                const highest = [...softwareVersionRows].sort((left, right) =>
                    String(right.SoftwareVersion || '').localeCompare(String(left.SoftwareVersion || ''), undefined, { numeric: true }))[0] || {};
                return {
                    SoftwareVersions: softwareVersionRows,
                    SoftwareVersion: highest.SoftwareVersion || '',
                    SoftwareReleaseDate: highest.SoftwareReleaseDate || '',
                    SoftwareLatestUpdate: highest.SoftwareLatestUpdate || ''
                };
            }

            function collectRequiredFieldKeys() {
                return requiredFieldInputs
                    .filter(input => input.checked)
                    .map(input => input.value)
                    .filter(Boolean);
            }

            function applyRequiredFieldKeys(keys) {
                const requiredKeys = new Set((keys || []).map(key => String(key || '').toLowerCase()));
                requiredFieldInputs.forEach(input => {
                    input.checked = requiredKeys.has(String(input.value || '').toLowerCase());
                });
                updateRequirementStats();
            }

            function updateRequirementStats() {
                const requiredCount = collectRequiredFieldKeys().length;
                if (requirementRequired) {
                    requirementRequired.textContent = requiredCount;
                }
                if (requirementOptional) {
                    requirementOptional.textContent = Math.max(0, requiredFieldInputs.length - requiredCount);
                }
                document.querySelectorAll('[data-requirement-section-card]').forEach(card => {
                    const sectionCount = card.querySelectorAll('[name="requiredFieldKeys"]:checked').length;
                    const countLabel = card.querySelector('[data-requirement-section-count]');
                    if (countLabel) {
                        countLabel.textContent = sectionCount;
                    }
                });
            }

            function collectCurrentProductVersion() {
                const current = currentVersionModel();
                return {
                    Version: currentProductVersion,
                    BatteryMassKg: numberField('batteryMassKg'),
                    RatedEnergyKwh: numberField('ratedEnergyKwh'),
                    RatedCapacityAh: numberField('ratedCapacityAh'),
                    RatedMaximumPowerKw: numberField('ratedMaximumPowerKw'),
                    NominalVoltageV: numberField('nominalVoltageV'),
                    ExpectedLifetimeYears: numberField('expectedLifetimeYears'),
                    ExpectedCycles: numberField('expectedCycles'),
                    SupplyChainIndex: numberField('supplyChainIndex'),
                    CarbonFootprint: numberField('carbonFootprint'),
                    PerformanceClass: document.querySelector('[name="performanceClass"]')?.value || '',
                    MaterialMassesKg: collectNumberMap('materialName', 'materialMass'),
                    CarbonStages: collectNumberMap('carbonStage', 'carbonStageValue'),
                    RecycledContent: collectRecycledContent(),
                    ...collectSoftwareParameters(),
                    TemplateDocuments: current?.TemplateDocuments || [],
                    RequiredFieldKeys: collectRequiredFieldKeys()
                };
            }

            function sortVersions(versions) {
                return versions.sort((left, right) => String(right.Version || '').localeCompare(String(left.Version || ''), undefined, { numeric: true }));
            }

            function saveCurrentVersion() {
                if (!currentProductVersion) {
                    return;
                }

                const next = collectCurrentProductVersion();
                const index = productVersions.findIndex(version =>
                    String(version.Version || '').toLowerCase() === String(currentProductVersion || '').toLowerCase());
                if (index >= 0) {
                    productVersions[index] = next;
                } else {
                    productVersions.push(next);
                }
                productVersions = sortVersions(productVersions.filter(version => version.Version));
                writeProductVersionsJson();
            }

            function writeProductVersionsJson() {
                productVersionsInput.value = JSON.stringify(productVersions);
                currentProductVersionInput.value = currentProductVersion;
                updateSelectedProductVersionLabels();
                updateSelectedProductVersionControls();
            }

            function updateSelectedProductVersionLabels() {
                selectedProductVersionLabels.forEach(label => {
                    if ('value' in label) {
                        label.value = currentProductVersion || '';
                    } else {
                        label.textContent = currentProductVersion || '';
                    }
                });
            }

            function updateSelectedProductVersionControls() {
                const currentKey = normalizeVersionKey(currentProductVersion);
                const currentIsSaved = !isNewProduct && savedProductVersionKeys.has(currentKey);
                if (selectedProductVersionInput) {
                    selectedProductVersionInput.readOnly = currentIsSaved;
                }
                if (pushSelectedProductVersionButton) {
                    const pushFormId = `push-product-version-${productId}-${currentProductVersion || ''}`;
                    pushSelectedProductVersionButton.setAttribute('form', pushFormId);
                    pushSelectedProductVersionButton.disabled = !currentIsSaved || !document.getElementById(pushFormId);
                }
                if (removeSelectedProductVersionButton) {
                    removeSelectedProductVersionButton.disabled = productVersions.length <= 1;
                }
            }

            function currentVersionModel() {
                return productVersions.find(version =>
                    String(version.Version || '').toLowerCase() === String(currentProductVersion || '').toLowerCase())
                    || productVersions[0];
            }

            function setNumberMap(nameKey, valueKey, values) {
                const names = Array.from(document.querySelectorAll(`[name="${nameKey}"]`));
                const inputs = Array.from(document.querySelectorAll(`[name="${valueKey}"]`));
                names.forEach((nameInput, index) => {
                    const key = nameInput.value || '';
                    if (Object.prototype.hasOwnProperty.call(values || {}, key) && inputs[index]) {
                        inputs[index].value = values[key];
                    }
                });
            }

            function setRecycledContent(values) {
                Object.entries(values || {}).forEach(([material, content]) => {
                    setField(`recycled${material}Pre`, content?.PreConsumerShare ?? 0);
                    setField(`recycled${material}Post`, content?.PostConsumerShare ?? 0);
                });
            }

            function renderSoftwareParameters(version) {
                softwareList.innerHTML = '';
                const rows = Array.isArray(version?.SoftwareVersions) && version.SoftwareVersions.length > 0
                    ? version.SoftwareVersions
                    : [{
                        SoftwareVersion: version?.SoftwareVersion || '',
                        SoftwareReleaseDate: version?.SoftwareReleaseDate || '',
                        SoftwareLatestUpdate: version?.SoftwareLatestUpdate || ''
                    }];
                rows.forEach((softwareVersion) => {
                    softwareList.appendChild(createSoftwareVersionRow(softwareVersion));
                });
            }

            function createSoftwareVersionRow(version) {
                const row = document.createElement('article');
                row.className = 'bp-template-version-row';
                row.dataset.softwareVersionRow = '';
                row.innerHTML = `
                    <label class="bp-field-shell">
                        <span>Software version</span>
                        <input type="text" name="softwareVersion" value="${escapeHtml(version?.SoftwareVersion || '')}" placeholder="4.0" required />
                    </label>
                    <label class="bp-field-shell">
                        <span>Release date</span>
                        <input type="date" name="softwareReleaseDate" value="${escapeHtml(version?.SoftwareReleaseDate || '')}" required />
                    </label>
                    <label class="bp-field-shell">
                        <span>Latest update</span>
                        <input type="date" name="softwareLatestUpdate" value="${escapeHtml(version?.SoftwareLatestUpdate || '')}" required />
                    </label>
                    <button type="button" class="bp-action-button is-danger" data-remove-software-version aria-label="Remove software version">Remove</button>`;
                return row;
            }

            function renderTemplateDocuments(documents) {
                templateDocumentList.innerHTML = '';
                const rows = documents?.length ? documents : [];
                if (rows.length === 0) {
                    const empty = document.createElement('p');
                    empty.className = 'bp-help-text mb-0';
                    empty.textContent = 'No template documents are configured for this Battery Model.';
                    templateDocumentList.appendChild(empty);
                    return;
                }

                rows.forEach(documentSeed => {
                    const row = document.createElement('article');
                    row.className = 'bp-template-document-row';
                    row.innerHTML = `
                        <div>
                            <strong>${escapeHtml(documentSeed.Label || documentSeed.DocumentKey || '')}</strong>
                            <span>${escapeHtml(documentSeed.DocumentKey || '')}</span>
                        </div>
                        <code>${escapeHtml(documentSeed.FileName || '')}</code>
                        <span class="bp-template-document-visibility">${escapeHtml(documentSeed.Visibility || 'private')}</span>`;
                    templateDocumentList.appendChild(row);
                });
            }

            function applyProductVersion(version) {
                if (!version) {
                    return;
                }

                currentProductVersion = version.Version || currentProductVersion;
                currentProductVersionInput.value = currentProductVersion;
                setField('productVersion', currentProductVersion);
                setField('batteryMassKg', version.BatteryMassKg);
                setField('ratedEnergyKwh', version.RatedEnergyKwh);
                setField('ratedCapacityAh', version.RatedCapacityAh);
                setField('ratedMaximumPowerKw', version.RatedMaximumPowerKw);
                setField('nominalVoltageV', version.NominalVoltageV);
                setField('expectedLifetimeYears', version.ExpectedLifetimeYears);
                setField('expectedCycles', version.ExpectedCycles);
                setField('supplyChainIndex', version.SupplyChainIndex);
                setField('carbonFootprint', version.CarbonFootprint);
                setField('performanceClass', version.PerformanceClass || '');
                setNumberMap('materialName', 'materialMass', version.MaterialMassesKg || {});
                setNumberMap('carbonStage', 'carbonStageValue', version.CarbonStages || {});
                setRecycledContent(version.RecycledContent || {});
                renderSoftwareParameters(version);
                renderTemplateDocuments(version.TemplateDocuments || []);
                applyRequiredFieldKeys(version.RequiredFieldKeys || []);
                renderProductVersionRows();
                writeProductVersionsJson();
            }

            function renderProductVersionRows() {
                productVersionList.innerHTML = '';
                productVersions.forEach(version => {
                    const versionKey = normalizeVersionKey(version.Version);
                    const isSavedVersion = !isNewProduct && savedProductVersionKeys.has(versionKey);
                    const isActive = String(version.Version || '').toLowerCase() === String(currentProductVersion || '').toLowerCase();
                    const row = document.createElement('article');
                    row.className = `bp-product-version-tab bp-product-version-chip bp-product-version-row ${isSavedVersion ? 'is-saved-version' : 'is-new-version'} ${isActive ? 'is-active' : ''}`;
                    row.dataset.productVersionRow = '';
                    row.dataset.productVersionTab = '';
                    row.dataset.version = version.Version || '';
                    const readonlyAttr = isSavedVersion ? 'readonly' : '';
                    row.innerHTML = `
                        <button type="button" class="bp-product-version-tab-main" role="tab" aria-selected="${isActive ? 'true' : 'false'}" title="Edit version ${escapeHtml(version.Version || '')}" data-edit-product-version>
                            <span>Battery Model</span>
                            <strong>${escapeHtml(version.Version || '')}</strong>
                        </button>
                        <label class="bp-product-version-tab-input">
                            <span>Version number</span>
                            <input type="text" value="${escapeHtml(version.Version || '')}" data-product-version-input ${readonlyAttr} required />
                        </label>
                        <span class="bp-product-version-chip-pill">${isActive ? 'Selected' : isSavedVersion ? 'Saved' : 'New'}</span>
                        <small>${isActive ? 'Currently editing this model' : isSavedVersion ? 'Saved Battery Model' : 'Save before pushing'}</small>`;
                    bindProductVersionRow(row, version);
                    productVersionList.appendChild(row);
                });
            }

            function removeProductVersion(version) {
                if (productVersions.length <= 1) {
                    selectedProductVersionInput?.focus();
                    return;
                }

                productVersions = productVersions.filter(candidate => candidate !== version);
                if (String(currentProductVersion || '').toLowerCase() === String(version.Version || '').toLowerCase()) {
                    currentProductVersion = productVersions[0]?.Version || '';
                    applyProductVersion(productVersions[0]);
                } else {
                    renderProductVersionRows();
                    writeProductVersionsJson();
                }
            }

            function bindProductVersionRow(row, version) {
                const input = row.querySelector('[data-product-version-input]');
                const selectProductVersion = targetVersion => {
                    const targetVersionKey = normalizeVersionKey(targetVersion?.Version);
                    saveCurrentVersion();
                    applyProductVersion(productVersions.find(candidate => normalizeVersionKey(candidate.Version) === targetVersionKey) || targetVersion);
                };
                row.addEventListener('click', event => {
                    const versionInput = event.target.closest('[data-product-version-input]');
                    if (versionInput && !versionInput.readOnly) {
                        return;
                    }
                    if (event.target.closest('[data-remove-product-version]')) {
                        return;
                    }
                    selectProductVersion(version);
                });
                row.querySelector('[data-edit-product-version]')?.addEventListener('click', event => {
                    event.preventDefault();
                    event.stopPropagation();
                    selectProductVersion(version);
                });
                input?.addEventListener('input', () => {
                    if (input.readOnly) {
                        return;
                    }

                    const previous = version.Version || '';
                    version.Version = input.value.trim();
                    if (String(currentProductVersion || '').toLowerCase() === String(previous).toLowerCase()) {
                        currentProductVersion = version.Version;
                    }
                    row.dataset.version = version.Version;
                    const tabLabel = row.querySelector('.bp-product-version-tab-main strong');
                    if (tabLabel) {
                        tabLabel.textContent = version.Version;
                    }
                    writeProductVersionsJson();
                });
            }

            selectedProductVersionInput?.addEventListener('input', () => {
                if (selectedProductVersionInput.readOnly) {
                    return;
                }

                const current = currentVersionModel();
                if (!current) {
                    return;
                }

                current.Version = selectedProductVersionInput.value.trim();
                currentProductVersion = current.Version;
                const activeRow = productVersionList.querySelector('.bp-product-version-tab.is-active');
                if (activeRow) {
                    activeRow.dataset.version = currentProductVersion;
                    const tabLabel = activeRow.querySelector('.bp-product-version-tab-main strong');
                    if (tabLabel) {
                        tabLabel.textContent = currentProductVersion;
                    }
                    const tabInput = activeRow.querySelector('[data-product-version-input]');
                    if (tabInput) {
                        tabInput.value = currentProductVersion;
                    }
                }
                writeProductVersionsJson();
            });

            removeSelectedProductVersionButton?.addEventListener('click', () => {
                const current = currentVersionModel();
                if (current) {
                    removeProductVersion(current);
                }
            });

            function escapeHtml(value) {
                return String(value)
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;');
            }

            function selectedBaseProduct() {
                return baseCatalog.find(product => String(product.ProductId || '').toLowerCase() === String(baseProductSelect?.value || '').toLowerCase());
            }

            function selectedBaseProductVersion() {
                const product = selectedBaseProduct();
                return (product?.ProductVersions || []).find(version => String(version.Version || '').toLowerCase() === String(baseProductVersionSelect?.value || '').toLowerCase());
            }

            function updateBaseProductVersions() {
                if (!baseProductVersionSelect) {
                    return;
                }

                const versions = selectedBaseProduct()?.ProductVersions || [];
                baseProductVersionSelect.innerHTML = '';
                versions.forEach(version => {
                    const option = document.createElement('option');
                    option.value = version.Version || '';
                    option.textContent = version.Version || '';
                    baseProductVersionSelect.appendChild(option);
                });
            }

            function applyBaseTemplate() {
                const product = selectedBaseProduct();
                const version = selectedBaseProductVersion();
                if (!product || !version) {
                    return;
                }

                setField('imageUrl', product.ImageUrl);
                setField('moduleCount', product.ModuleCount);
                saveCurrentVersion();
                currentProductVersion = version.Version || currentProductVersion;
                const existingIndex = productVersions.findIndex(candidate =>
                    String(candidate.Version || '').toLowerCase() === String(currentProductVersion || '').toLowerCase());
                if (existingIndex >= 0) {
                    productVersions[existingIndex] = { ...version };
                } else {
                    productVersions.push({ ...version });
                }
                applyProductVersion(productVersions.find(candidate =>
                    String(candidate.Version || '').toLowerCase() === String(currentProductVersion || '').toLowerCase()));
            }

            function nextProductVersion() {
                const major = productVersions
                    .map(version => Number.parseInt(String(version.Version || '').split('.')[0], 10))
                    .filter(Number.isFinite)
                    .reduce((max, value) => Math.max(max, value), 0);
                return `${major + 1}.0`;
            }

            requiredFieldInputs.forEach(input => input.addEventListener('change', updateRequirementStats));
            updateRequirementStats();
            renderProductVersionRows();
            updateSelectedProductVersionControls();
            baseProductSelect?.addEventListener('change', updateBaseProductVersions);
            baseProductVersionSelect?.addEventListener('change', () => {});
            applyBaseButton?.addEventListener('click', applyBaseTemplate);
            document.querySelector('[data-add-software-version]')?.addEventListener('click', () => {
                softwareList.appendChild(createSoftwareVersionRow({
                    SoftwareVersion: '',
                    SoftwareReleaseDate: '',
                    SoftwareLatestUpdate: ''
                }));
            });
            softwareList?.addEventListener('click', (event) => {
                const removeButton = event.target.closest?.('[data-remove-software-version]');
                if (!removeButton) {
                    return;
                }

                const rows = Array.from(softwareList.querySelectorAll('[data-software-version-row]'));
                if (rows.length <= 1) {
                    return;
                }

                removeButton.closest('[data-software-version-row]')?.remove();
            });
            addProductVersionButton?.addEventListener('click', () => {
                saveCurrentVersion();
                const version = {
                    ...collectCurrentProductVersion(),
                    Version: nextProductVersion()
                };
                productVersions.push(version);
                currentProductVersion = version.Version;
                applyProductVersion(version);
                selectedProductVersionInput?.focus();
            });
            form.addEventListener('submit', () => {
                saveCurrentVersion();
                writeProductVersionsJson();
            });
        })();
    </script>
}
