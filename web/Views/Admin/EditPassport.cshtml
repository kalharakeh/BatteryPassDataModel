@model BatteryPassWeb.Models.ViewModels.PassportSummaryViewModel
@{
    ViewData["Title"] = "Edit Passport";
}
<h1 class="h3">Edit Passport</h1>
<p class="text-secondary text-break">@Model.PassportId</p>
<div class="card mt-3">
    <div class="card-body">
        <p>This editor page is now routed in ASP.NET MVC. Full field-level editing migration is in progress.</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.DisplayName</dd>
            <dt class="col-sm-3">Model</dt><dd class="col-sm-9">@Model.ModelNumber</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.RegistryStatus</dd>
        </dl>
    </div>
</div>
