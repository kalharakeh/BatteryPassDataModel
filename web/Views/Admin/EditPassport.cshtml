@using BatteryPassWeb.Models.Trust
@using System.Text.Json
@model BatteryPassWeb.Models.ViewModels.EditPassportViewModel
@{
    var isNewBattery = Model.Mode.Equals("new-battery", StringComparison.OrdinalIgnoreCase);
    var isBatteryEdit = Model.Mode.Equals("battery-edit", StringComparison.OrdinalIgnoreCase);
    var isNew = Model.Mode.Equals("new", StringComparison.OrdinalIgnoreCase) || isNewBattery;
    ViewData["Title"] = isNewBattery ? "Create battery" : isBatteryEdit ? "Edit battery" : isNew ? "Create passport" : "Edit passport snapshot";
    var passport = Model.Passport;
    var formAction = isNewBattery ? "/admin/batteries/create" : isBatteryEdit ? $"/admin/batteries/{Uri.EscapeDataString(passport.BatteryId)}/save" : isNew ? "/admin/passports/create" : "/admin/passports/save";
    var submitLabel = isNewBattery ? "Create battery" : isBatteryEdit ? "Save battery" : isNew ? "Create passport" : "Save passport";
    var cancelHref = isNewBattery || isBatteryEdit ? "/admin/clusters?tab=batteries" : "/admin/passports";
    var batteryImageOptions = BatteryPassWeb.Services.BatteryImageCatalog.Options;
    var selectedBatteryImageUrl = BatteryPassWeb.Services.BatteryImageCatalog.NormalizeKnownImageUrl(passport.BatteryImageUrl, passport.PassportId);
    var selectedBatteryCategory = BatteryPassWeb.Services.BatteryImageCatalog.CategoryForImageUrl(selectedBatteryImageUrl);
    var productTemplateCatalogJson = JsonSerializer.Serialize(Model.ProductTemplateCatalog);
    var selectedCatalogProduct = Model.ProductTemplateCatalog.FirstOrDefault(product => product.ProductId.Equals(Model.SelectedProductId, StringComparison.OrdinalIgnoreCase));
    var selectedProductVersions = selectedCatalogProduct?.ProductVersions ?? Array.Empty<BatteryPassWeb.Models.ViewModels.ProductVersionEditViewModel>();
    var latestVersionByProductId = Model.ProductTemplateCatalog.ToDictionary(product => product.ProductId, product => product.LatestProductVersion, StringComparer.OrdinalIgnoreCase);

    double SegmentValue(string label, IReadOnlyList<BatteryPassWeb.Models.ViewModels.ChartSegmentViewModel> segments)
        => segments.FirstOrDefault(segment => segment.Label.Equals(label, StringComparison.OrdinalIgnoreCase))?.Value ?? 0;

    BatteryPassWeb.Models.ViewModels.RecycledContentChartViewModel Recycled(string material)
        => passport.RecycledContentCharts.FirstOrDefault(chart => chart.Material.Equals(material, StringComparison.OrdinalIgnoreCase))
            ?? new BatteryPassWeb.Models.ViewModels.RecycledContentChartViewModel { Material = material };

    bool IsPublicDocument(BatteryPassWeb.Models.ViewModels.PassportDocumentLinkViewModel document)
        => document.Visibility.Equals("public", StringComparison.OrdinalIgnoreCase);

    DataRequirementField? Requirement(string fieldKey)
        => Model.FieldRequirementByKey.TryGetValue(fieldKey, out var requirement) ? requirement : null;

    string RequirementLabel(string fieldKey)
        => Requirement(fieldKey)?.IsRequired == true ? "Required" : "Optional";

    string RequirementHelp(string fieldKey, string fallback)
        => string.IsNullOrWhiteSpace(Requirement(fieldKey)?.Guidance) ? fallback : Requirement(fieldKey)!.Guidance;

    string DirtySignedDataHelp(string fieldKey, string fallback)
        => $"{RequirementHelp(fieldKey, fallback)} Changing this after signing makes the passport dirty until it is validated and signed again.";

    string LiveOperationalHelp(string fieldKey, string fallback)
        => $"{RequirementHelp(fieldKey, fallback)} External HTTP updates to this live operational data do not dirty the passport signature.";

    var materialFields = new[]
    {
        new { Label = "Nickel kg", Name = "materialNickel", Key = "material.nickelMass", Value = SegmentValue("Nickel", passport.MaterialCompositionSegments), Help = "Nickel mass in kg." },
        new { Label = "Copper kg", Name = "materialCopper", Key = "material.copperMass", Value = SegmentValue("Copper", passport.MaterialCompositionSegments), Help = "Copper mass in kg." },
        new { Label = "Aluminium kg", Name = "materialAluminium", Key = "material.aluminiumMass", Value = SegmentValue("Aluminium", passport.MaterialCompositionSegments), Help = "Aluminium mass in kg." },
        new { Label = "Graphite kg", Name = "materialGraphite", Key = "material.graphiteMass", Value = SegmentValue("Graphite", passport.MaterialCompositionSegments), Help = "Graphite mass in kg." },
        new { Label = "Manganese kg", Name = "materialManganese", Key = "material.manganeseMass", Value = SegmentValue("Manganese", passport.MaterialCompositionSegments), Help = "Manganese mass in kg." },
        new { Label = "Cobalt kg", Name = "materialCobalt", Key = "material.cobaltMass", Value = SegmentValue("Cobalt", passport.MaterialCompositionSegments), Help = "Cobalt mass in kg." },
        new { Label = "Lithium kg", Name = "materialLithium", Key = "material.lithiumMass", Value = SegmentValue("Lithium", passport.MaterialCompositionSegments), Help = "Lithium mass in kg." },
        new { Label = "Electrolyte and separators kg", Name = "materialElectrolyte", Key = "material.electrolyteMass", Value = SegmentValue("Electrolyte and separators", passport.MaterialCompositionSegments), Help = "Electrolyte and separator mass in kg." }
    };

    var performanceFields = new[]
    {
        new { Label = "Rated energy kWh", Name = "ratedEnergy", Key = "performance.ratedEnergy", Value = passport.Performance.RatedEnergy, Help = "Rated energy in kWh.", IsLive = false },
        new { Label = "Rated capacity Ah", Name = "ratedCapacity", Key = "performance.ratedCapacity", Value = passport.Performance.RatedCapacity, Help = "Rated capacity in Ah.", IsLive = false },
        new { Label = "Maximum power kW", Name = "ratedMaximumPower", Key = "performance.ratedMaximumPower", Value = passport.Performance.RatedMaximumPower, Help = "Maximum rated power.", IsLive = false },
        new { Label = "Nominal voltage V", Name = "nominalVoltage", Key = "performance.nominalVoltage", Value = passport.Performance.NominalVoltage, Help = "Nominal voltage.", IsLive = false },
        new { Label = "Expected lifetime years", Name = "expectedLifetime", Key = "performance.expectedLifetime", Value = passport.Performance.ExpectedLifetime, Help = "Expected lifetime in years.", IsLive = false },
        new { Label = "Expected cycles", Name = "expectedNumberOfCycles", Key = "performance.expectedNumberOfCycles", Value = passport.Performance.ExpectedNumberOfCycles, Help = "Expected cycle count.", IsLive = false },
        new { Label = "State of charge %", Name = "stateOfCharge", Key = "performance.stateOfCharge", Value = passport.Performance.StateOfCharge, Help = "Current state of charge.", IsLive = true },
        new { Label = "Remaining capacity %", Name = "remainingCapacity", Key = "performance.remainingCapacity", Value = passport.Performance.RemainingCapacity, Help = "Remaining certified capacity.", IsLive = true },
        new { Label = "Remaining energy kWh", Name = "remainingEnergy", Key = "performance.remainingEnergy", Value = passport.Performance.RemainingEnergy, Help = "Remaining energy.", IsLive = true },
        new { Label = "Full cycles", Name = "fullCycles", Key = "performance.fullCycles", Value = passport.Performance.Cycles, Help = "Number of full cycles.", IsLive = true }
    };

    var complianceDocuments = new[]
    {
        new { Document = passport.Documents.ConformityAssessment, DocumentKey = "conformityAssessment", FieldName = "document_conformityAssessment", VisibilityName = "document_conformityAssessment_visibility", Key = "compliance.conformityAssessment", Help = "URL or reference for the conformity assessment report." },
        new { Document = passport.Documents.EuDeclarationOfConformity, DocumentKey = "euDeclarationOfConformity", FieldName = "document_euDeclarationOfConformity", VisibilityName = "document_euDeclarationOfConformity_visibility", Key = "compliance.euDeclarationOfConformity", Help = "URL or reference for the EU declaration." }
    };

    var supplyChainDocuments = new[]
    {
        new { Document = passport.Documents.SustainabilityReport, DocumentKey = "sustainabilityReport", FieldName = "document_sustainabilityReport", VisibilityName = "document_sustainabilityReport_visibility", Key = "supplyChain.sustainabilityReport", Help = "Sustainability report reference." },
        new { Document = passport.Documents.DueDiligenceReport, DocumentKey = "dueDiligenceReport", FieldName = "document_dueDiligenceReport", VisibilityName = "document_dueDiligenceReport_visibility", Key = "supplyChain.dueDiligenceReport", Help = "Due-diligence report reference." },
        new { Document = passport.Documents.ThirdPartyAudit, DocumentKey = "thirdPartyAudit", FieldName = "document_thirdPartyAudit", VisibilityName = "document_thirdPartyAudit_visibility", Key = "supplyChain.thirdPartyAudit", Help = "Third-party assurance/audit reference." },
        new { Document = passport.Documents.TaxonomyReport, DocumentKey = "taxonomyReport", FieldName = "document_taxonomyReport", VisibilityName = "document_taxonomyReport_visibility", Key = "supplyChain.taxonomyReport", Help = "Taxonomy report reference." }
    };

    var recycledFields = new[]
    {
        new { Label = "Nickel pre consumer %", Name = "recycledNickelPre", Key = "circularity.recycledNickelPre", Value = Recycled("Nickel").PreConsumerShare, Help = "Nickel pre-consumer recycled content share.", IsDirty = true },
        new { Label = "Nickel post consumer %", Name = "recycledNickelPost", Key = "circularity.recycledNickelPost", Value = Recycled("Nickel").PostConsumerShare, Help = "Nickel post-consumer recycled content share.", IsDirty = true },
        new { Label = "Nickel primary material %", Name = "recycledNickelPrimary", Key = "circularity.recycledNickelPrimary", Value = Recycled("Nickel").PrimaryMaterialShare, Help = "Nickel primary material share.", IsDirty = false },
        new { Label = "Cobalt pre consumer %", Name = "recycledCobaltPre", Key = "circularity.recycledCobaltPre", Value = Recycled("Cobalt").PreConsumerShare, Help = "Cobalt pre-consumer recycled content share.", IsDirty = true },
        new { Label = "Cobalt post consumer %", Name = "recycledCobaltPost", Key = "circularity.recycledCobaltPost", Value = Recycled("Cobalt").PostConsumerShare, Help = "Cobalt post-consumer recycled content share.", IsDirty = true },
        new { Label = "Cobalt primary material %", Name = "recycledCobaltPrimary", Key = "circularity.recycledCobaltPrimary", Value = Recycled("Cobalt").PrimaryMaterialShare, Help = "Cobalt primary material share.", IsDirty = false },
        new { Label = "Lithium pre consumer %", Name = "recycledLithiumPre", Key = "circularity.recycledLithiumPre", Value = Recycled("Lithium").PreConsumerShare, Help = "Lithium pre-consumer recycled content share.", IsDirty = true },
        new { Label = "Lithium post consumer %", Name = "recycledLithiumPost", Key = "circularity.recycledLithiumPost", Value = Recycled("Lithium").PostConsumerShare, Help = "Lithium post-consumer recycled content share.", IsDirty = true },
        new { Label = "Lithium primary material %", Name = "recycledLithiumPrimary", Key = "circularity.recycledLithiumPrimary", Value = Recycled("Lithium").PrimaryMaterialShare, Help = "Lithium primary material share.", IsDirty = false },
        new { Label = "Lead pre consumer %", Name = "recycledLeadPre", Key = "circularity.recycledLeadPre", Value = Recycled("Lead").PreConsumerShare, Help = "Lead pre-consumer recycled content share.", IsDirty = true },
        new { Label = "Lead post consumer %", Name = "recycledLeadPost", Key = "circularity.recycledLeadPost", Value = Recycled("Lead").PostConsumerShare, Help = "Lead post-consumer recycled content share.", IsDirty = true },
        new { Label = "Lead primary material %", Name = "recycledLeadPrimary", Key = "circularity.recycledLeadPrimary", Value = Recycled("Lead").PrimaryMaterialShare, Help = "Lead primary material share.", IsDirty = false }
    };

    var carbonFields = new[]
    {
        new { Label = "Amount gCO2e/kWh", Name = "carbonFootprint", Key = "carbon.amount", Value = passport.CarbonFootprint, Help = "Battery carbon footprint amount." },
        new { Label = "Raw material extraction gCO2e/kWh", Name = "carbonRawMaterial", Key = "carbon.rawMaterial", Value = SegmentValue("raw material extraction", passport.CarbonFootprintSegments), Help = "Raw material extraction lifecycle carbon value." },
        new { Label = "Main production gCO2e/kWh", Name = "carbonMainProduction", Key = "carbon.mainProduction", Value = SegmentValue("main production", passport.CarbonFootprintSegments), Help = "Main production lifecycle carbon value." },
        new { Label = "Distribution gCO2e/kWh", Name = "carbonDistribution", Key = "carbon.distribution", Value = SegmentValue("distribution", passport.CarbonFootprintSegments), Help = "Distribution lifecycle carbon value." },
        new { Label = "Recycling gCO2e/kWh", Name = "carbonRecycling", Key = "carbon.recycling", Value = SegmentValue("recycling", passport.CarbonFootprintSegments), Help = "Recycling lifecycle carbon value." }
    };
}
<main class="bp-page bp-admin-page">
    <h1 class="mb-1">@(isNewBattery ? "Create battery" : isBatteryEdit ? "Edit battery" : isNew ? "Create passport" : "Edit passport snapshot")</h1>
    @if (isBatteryEdit)
    {
        <p class="bp-passport-id">Battery ID: <span class="bp-id-copy-row"><span class="bp-id-value">@passport.BatteryId</span>@await Html.PartialAsync("_CopyIdButton", passport.BatteryId)</span></p>
    }
    else
    {
        <p class="bp-passport-id"><span class="bp-id-copy-row"><span class="bp-id-value">@passport.PassportId</span>@await Html.PartialAsync("_CopyIdButton", passport.PassportId)</span></p>
    }

    <div class="bp-card mt-3">
        <div class="d-flex justify-content-between flex-wrap gap-3 align-items-center">
            @if (isBatteryEdit)
            {
                <div>
                    <span class="bp-summary-title">Battery record</span>
                    <p class="mb-0"><strong>New passport needed after save</strong></p>
                    <p class="text-secondary mb-0">Saving battery data does not mutate existing passport snapshots.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/admin/clusters?tab=batteries" class="bp-secondary-button">Back to Batteries</a>
                    <a href="/admin/batteries/@Uri.EscapeDataString(passport.BatteryId)/passports" class="bp-secondary-button">Passport history</a>
                </div>
            }
            else
            {
                <div>
                    <span class="bp-summary-title">Trust state</span>
                    <p class="mb-0"><strong>@passport.TrustState</strong>@if (passport.TrustIsDirty) { <span class="bp-pill bp-pill-warn ms-2">Dirty</span> }</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/admin/help" class="bp-secondary-button">Admin help</a>
                    <a href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/conformance" class="bp-secondary-button">Open conformance</a>
                    <a href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/audit" class="bp-secondary-button">Audit trail</a>
                    <a href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/revisions" class="bp-secondary-button">Revision history</a>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-success mt-3 mb-0">@Model.StatusMessage</div> }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger mt-3 mb-0">@Model.ErrorMessage</div> }

    <script type="application/json" data-product-template-catalog>@Html.Raw(productTemplateCatalogJson)</script>

    <form method="post" action="@formAction" class="bp-edit-grid mt-4" data-edit-passport-form data-required-passport-validation="@isNew.ToString().ToLowerInvariant()" data-passport-id="@passport.PassportId">
        @Html.AntiForgeryToken()
        <nav class="bp-edit-nav" aria-label="Passport categories">
            @foreach (var section in passport.Sections)
            {
                var sectionId = "admin-" + section.ToLowerInvariant().Replace(" ", "-");
                <button type="button" class="bp-edit-nav-button" data-section-target="@sectionId" aria-pressed="false">@(section)</button>
            }
        </nav>

        <div class="bp-edit-form">
            <section id="admin-general" class="bp-card bp-edit-section">
                <h2>General</h2>
                <p class="bp-template-sync-note">
                    Select a battery family and Battery Model below. Shared technical fields update from the template; identity fields stay battery-specific and editable.
                </p>
                <div class="bp-form-grid">
                    @if (!isNewBattery)
                    {
                        <label class="bp-field-shell" data-field-key="general.passportId">
                            <span>@if (isBatteryEdit) { <text>Battery ID</text> } else { <text>Passport ID</text> } <em class="bp-field-marker">@RequirementLabel("general.passportId")</em></span>
                            @if (isBatteryEdit)
                            {
                                <input type="text" name="batteryId" value="@passport.BatteryId" readonly />
                            }
                            else if (isNew)
                            {
                                <input type="text" name="passportId" value="@passport.PassportId" required />
                            }
                            else
                            {
                                <input type="text" name="passportId" value="@passport.PassportId" readonly />
                            }
                            <small class="bp-field-help">@(isBatteryEdit ? "Locked stable identity for this physical battery." : DirtySignedDataHelp("general.passportId", "Unique DID-style battery passport identifier."))</small>
                        </label>
                    }
                    <label class="bp-field-shell" data-field-key="general.product"><span>Battery Family <em class="bp-field-marker">@RequirementLabel("general.product")</em></span>@if (isBatteryEdit) { <input type="hidden" name="productId" value="@Model.SelectedProductId" /> }<select name="productId" data-product-template-select disabled="@isBatteryEdit">@foreach (var productTemplate in Model.ProductTemplates) { var latestVersion = latestVersionByProductId.TryGetValue(productTemplate.ProductId, out var latest) ? latest : string.Empty; if (productTemplate.ProductId.Equals(Model.SelectedProductId, StringComparison.OrdinalIgnoreCase)) { <option value="@productTemplate.ProductId" data-latest-product-version="@latestVersion" selected>@productTemplate.ProductName</option> } else { <option value="@productTemplate.ProductId" data-latest-product-version="@latestVersion">@productTemplate.ProductName</option> } }</select><small class="bp-field-help">@(isNewBattery || isBatteryEdit ? "Battery Family and serial number are locked because they define the Battery ID." : DirtySignedDataHelp("general.product", "Battery family copied into this battery."))</small></label>
                    <label class="bp-field-shell" data-field-key="general.productVersion"><span>Battery Model <em class="bp-field-marker">@RequirementLabel("general.productVersion")</em></span><select name="productVersion" data-product-version-select>@foreach (var productVersion in selectedProductVersions) { if (productVersion.Version.Equals(Model.SelectedProductVersion, StringComparison.OrdinalIgnoreCase)) { <option value="@productVersion.Version" selected>@productVersion.Version</option> } else { <option value="@productVersion.Version">@productVersion.Version</option> } }</select><small class="bp-field-help">@DirtySignedDataHelp("general.productVersion", "Battery Model copied into this battery.")</small></label>
                    <label class="bp-field-shell" data-field-key="general.serialNumber"><span>Battery serial number <em class="bp-field-marker">@RequirementLabel("general.serialNumber")</em></span><input type="text" name="serialNumber" value="@passport.BatterySerialNumber" readonly="@isBatteryEdit" /><small class="bp-field-help">@(isNewBattery || isBatteryEdit ? "Battery Family and serial number are locked because they define the Battery ID." : DirtySignedDataHelp("general.serialNumber", "Manufacturer serial number."))</small></label>
                    @if (isNewBattery)
                    {
                        <div class="bp-field-shell bp-span-all" data-field-key="general.batteryIdPreview">
                            <span>Battery ID preview</span>
                            <code class="bp-battery-id-cell" data-battery-id-preview>-</code>
                            <small class="bp-field-help">Updates from the selected Battery Family and serial number.</small>
                        </div>
                    }
                    <label class="bp-field-shell"><span>Official schema category <em class="bp-field-marker">@RequirementLabel("general.category")</em></span><input type="text" name="category" value="@selectedBatteryCategory" readonly data-image-category /><small class="bp-field-help">@DirtySignedDataHelp("general.category", "Battery Pass schema category. Product is managed separately above.")</small></label>
                    <label class="bp-field-shell"><span>Battery status <em class="bp-field-marker">@RequirementLabel("general.batteryStatus")</em></span><input type="text" name="batteryStatus" value="@passport.BatteryStatus" /><small class="bp-field-help">@DirtySignedDataHelp("general.batteryStatus", "Lifecycle/original status for the battery.")</small></label>
                    <label class="bp-field-shell"><span>Weight kg <em class="bp-field-marker">@RequirementLabel("general.batteryMass")</em></span><input type="number" step="any" name="batteryMass" value="@passport.Weight" /><small class="bp-field-help">@DirtySignedDataHelp("general.batteryMass", "Battery mass in kg.")</small></label>
                    <label class="bp-field-shell"><span>Manufactured date <em class="bp-field-marker">@RequirementLabel("general.manufacturingDate")</em></span><input type="date" name="manufacturingDate" value="@passport.ManufacturedDate" /><small class="bp-field-help">@DirtySignedDataHelp("general.manufacturingDate", "Manufacturing date.")</small></label>
                    <label class="bp-field-shell"><span>Facility ID <em class="bp-field-marker">@RequirementLabel("general.facilityId")</em></span><input type="text" name="facilityId" value="@passport.FacilityId" /><small class="bp-field-help">@DirtySignedDataHelp("general.facilityId", "Production or facility identifier.")</small></label>
                    <label class="bp-field-shell"><span>Manufactured by <em class="bp-field-marker">@RequirementLabel("general.manufacturerName")</em></span><input type="text" name="manufacturerName" value="@passport.ManufacturerName" readonly="@isBatteryEdit" /><small class="bp-field-help">@(isBatteryEdit ? "Locked after battery creation." : DirtySignedDataHelp("general.manufacturerName", "Manufacturer legal/display name."))</small></label>
                    <label class="bp-field-shell"><span>Passport status <em class="bp-field-marker">@RequirementLabel("general.registryStatus")</em></span><select name="status">@if (passport.RegistryStatus != "archived") { <option value="draft" selected>Draft</option> } else { <option value="draft">Draft</option> } @if (passport.RegistryStatus == "archived") { <option value="archived" selected>Archived</option> } else { <option value="archived">Archived</option> }</select><small class="bp-field-help">@DirtySignedDataHelp("general.registryStatus", "Publishing is handled from the trust workflow after validation and signing.")</small></label>
                    <label class="bp-field-shell"><span>Battery image <em class="bp-field-marker">@RequirementLabel("general.batteryImageUrl")</em></span><select name="batteryImageUrl" data-battery-image-select>@foreach (var imageOption in batteryImageOptions) { if (imageOption.Url.Equals(selectedBatteryImageUrl, StringComparison.OrdinalIgnoreCase)) { <option value="@imageOption.Url" data-image-category="@imageOption.Category" selected>@imageOption.Label (@imageOption.Category)</option> } else { <option value="@imageOption.Url" data-image-category="@imageOption.Category">@imageOption.Label (@imageOption.Category)</option> } }</select><small class="bp-field-help">@RequirementHelp("general.batteryImageUrl", "Display image for the report.")</small></label>
                    <label class="bp-field-shell" data-field-key="general.softwareVersion"><span>Software version <em class="bp-field-marker">@RequirementLabel("general.softwareVersion")</em></span><input type="text" name="softwareVersion" value="@passport.SoftwareVersion" readonly data-product-software-version /><small class="bp-field-help">@DirtySignedDataHelp("general.softwareVersion", "Software version parameter copied from the selected Battery Model.")</small></label>
                    <label class="bp-field-shell"><span>Released date</span><input type="date" name="softwareReleaseDate" value="@passport.SoftwareReleaseDate" readonly data-product-software-release /></label>
                    <label class="bp-field-shell"><span>Software latest update</span><input type="date" name="softwareLatestUpdate" value="@passport.SoftwareLatestUpdate" readonly data-product-software-update /></label>
                </div>
            </section>

            <section id="admin-material-composition" class="bp-card bp-edit-section">
                <h2>Material composition</h2>
                <div class="bp-form-grid">
                    @foreach (var field in materialFields)
                    {
                        <label class="bp-field-shell"><span>@field.Label <em class="bp-field-marker">@RequirementLabel(field.Key)</em></span><input type="number" step="any" name="@field.Name" value="@field.Value" /><small class="bp-field-help">@DirtySignedDataHelp(field.Key, field.Help)</small></label>
                    }
                </div>
            </section>

            <section id="admin-performance" class="bp-card bp-edit-section">
                <h2>Performance</h2>
                <div class="bp-form-grid">
                    @foreach (var field in performanceFields)
                    {
                        <label class="bp-field-shell"><span>@field.Label <em class="bp-field-marker">@RequirementLabel(field.Key)</em></span><input type="number" step="any" name="@field.Name" value="@field.Value" /><small class="bp-field-help">@(field.IsLive ? LiveOperationalHelp(field.Key, field.Help) : DirtySignedDataHelp(field.Key, field.Help))</small></label>
                    }
                </div>
            </section>

            <section id="admin-compliance" class="bp-card bp-edit-section">
                <h2>Compliance</h2>
                <div class="bp-form-grid">
                    @foreach (var document in complianceDocuments)
                    {
                        <div class="bp-document-row bp-span-all" data-document-upload-card data-document-key="@document.DocumentKey" data-upload-state="idle">
                            <div class="bp-field-shell bp-document-field-shell">
                                <span>@document.Document.Label <em class="bp-field-marker">@RequirementLabel(document.Key)</em></span>
                                <div class="bp-document-main-line">
                                    <input type="text" name="@document.FieldName" value="@document.Document.Url" data-document-url="@document.DocumentKey" aria-label="@document.Document.Label URL or reference" />
                                    <button type="button" class="bp-secondary-button bp-button-compact bp-document-smart-upload" data-document-upload data-document-upload-label data-default-label="Choose file">Choose file</button>
                                    <input type="file" class="bp-document-hidden-file" accept="application/pdf,image/*" data-document-file aria-label="Upload @document.Document.Label file" />
                                </div>
                                <small class="bp-field-help">@DirtySignedDataHelp(document.Key, document.Help)</small>
                                <label class="bp-document-sha-field">
                                    <span>SHA-256</span>
                                    <input type="text" readonly data-document-sha value="@document.Document.Sha256" placeholder="No uploaded file hash yet" />
                                </label>
                                <p class="bp-document-upload-status" data-document-upload-status aria-live="polite" hidden></p>
                            </div>
                            <label class="bp-field-shell bp-document-visibility-field"><span>@document.Document.Label visibility <em class="bp-field-marker">@RequirementLabel(document.Key)</em></span><select name="@document.VisibilityName" data-document-visibility="@document.DocumentKey"><option value="private" selected="@(!IsPublicDocument(document.Document))">Private / privileged</option><option value="public" selected="@(IsPublicDocument(document.Document))">Public document</option></select><small class="bp-field-help">@DirtySignedDataHelp(document.Key, "Controls who can download this document.")</small></label>
                        </div>
                    }
                </div>
            </section>

            <section id="admin-supply-chain" class="bp-card bp-edit-section">
                <h2>Supply chain</h2>
                <div class="bp-form-grid">
                    <label class="bp-field-shell"><span>Supply chain index <em class="bp-field-marker">@RequirementLabel("supplyChain.supplyChainIndex")</em></span><input type="number" step="any" name="supplyChainIndex" value="@passport.SupplyChainIndex" /><small class="bp-field-help">@DirtySignedDataHelp("supplyChain.supplyChainIndex", "Supply chain due-diligence index.")</small></label>
                    @foreach (var document in supplyChainDocuments)
                    {
                        <div class="bp-document-row bp-span-all" data-document-upload-card data-document-key="@document.DocumentKey" data-upload-state="idle">
                            <div class="bp-field-shell bp-document-field-shell">
                                <span>@document.Document.Label <em class="bp-field-marker">@RequirementLabel(document.Key)</em></span>
                                <div class="bp-document-main-line">
                                    <input type="text" name="@document.FieldName" value="@document.Document.Url" data-document-url="@document.DocumentKey" aria-label="@document.Document.Label URL or reference" />
                                    <button type="button" class="bp-secondary-button bp-button-compact bp-document-smart-upload" data-document-upload data-document-upload-label data-default-label="Choose file">Choose file</button>
                                    <input type="file" class="bp-document-hidden-file" accept="application/pdf,image/*" data-document-file aria-label="Upload @document.Document.Label file" />
                                </div>
                                <small class="bp-field-help">@DirtySignedDataHelp(document.Key, document.Help)</small>
                                <label class="bp-document-sha-field">
                                    <span>SHA-256</span>
                                    <input type="text" readonly data-document-sha value="@document.Document.Sha256" placeholder="No uploaded file hash yet" />
                                </label>
                                <p class="bp-document-upload-status" data-document-upload-status aria-live="polite" hidden></p>
                            </div>
                            <label class="bp-field-shell bp-document-visibility-field"><span>@document.Document.Label visibility <em class="bp-field-marker">@RequirementLabel(document.Key)</em></span><select name="@document.VisibilityName" data-document-visibility="@document.DocumentKey"><option value="private" selected="@(!IsPublicDocument(document.Document))">Private / privileged</option><option value="public" selected="@(IsPublicDocument(document.Document))">Public document</option></select><small class="bp-field-help">@DirtySignedDataHelp(document.Key, "Controls who can download this document.")</small></label>
                        </div>
                    }
                </div>
            </section>

            <section id="admin-circularity" class="bp-card bp-edit-section">
                <h2>Circularity</h2>
                <div class="bp-form-grid">
                    <label class="bp-field-shell bp-span-2"><span>Separate collection <em class="bp-field-marker">@RequirementLabel("circularity.separateCollection")</em></span><textarea name="separateCollection">@passport.Circularity.SeparateCollection</textarea><small class="bp-field-help">@DirtySignedDataHelp("circularity.separateCollection", "Collection instructions or URL.")</small></label>
                    <label class="bp-field-shell bp-span-2"><span>Waste prevention <em class="bp-field-marker">@RequirementLabel("circularity.wastePrevention")</em></span><textarea name="wastePrevention">@passport.Circularity.WastePrevention</textarea><small class="bp-field-help">@DirtySignedDataHelp("circularity.wastePrevention", "Waste prevention instructions or URL.")</small></label>
                    <label class="bp-field-shell"><span>Recycled content share verification <em class="bp-field-marker">@RequirementLabel("circularity.recycledContentShareVerification")</em></span>
                        <select name="recycledContentShareVerification">
                            @if (passport.Circularity.RecycledContentShareVerification == "verified") { <option value="verified" selected>Verified</option> } else { <option value="verified">Verified</option> }
                            @if (passport.Circularity.RecycledContentShareVerification == "partial") { <option value="partial" selected>Partial</option> } else { <option value="partial">Partial</option> }
                            @if (passport.Circularity.RecycledContentShareVerification == "unverified") { <option value="unverified" selected>Unverified</option> } else { <option value="unverified">Unverified</option> }
                            @if (passport.Circularity.RecycledContentShareVerification == "invalid") { <option value="invalid" selected>Invalid</option> } else { <option value="invalid">Invalid</option> }
                        </select>
                        <small class="bp-field-help">@RequirementHelp("circularity.recycledContentShareVerification", "Verification state shown by the admin form.")</small>
                    </label>
                    @foreach (var field in recycledFields)
                    {
                        <label class="bp-field-shell"><span>@field.Label <em class="bp-field-marker">@RequirementLabel(field.Key)</em></span><input type="number" step="any" name="@field.Name" value="@field.Value" /><small class="bp-field-help">@(field.IsDirty ? DirtySignedDataHelp(field.Key, field.Help) : RequirementHelp(field.Key, field.Help))</small></label>
                    }
                </div>
            </section>

            <section id="admin-carbon-footprint" class="bp-card bp-edit-section">
                <h2>Carbon Footprint</h2>
                <div class="bp-form-grid">
                    @foreach (var field in carbonFields)
                    {
                        <label class="bp-field-shell"><span>@field.Label <em class="bp-field-marker">@RequirementLabel(field.Key)</em></span><input type="number" step="any" name="@field.Name" value="@field.Value" /><small class="bp-field-help">@DirtySignedDataHelp(field.Key, field.Help)</small></label>
                    }
                    <label class="bp-field-shell"><span>Performance class <em class="bp-field-marker">@RequirementLabel("carbon.performanceClass")</em></span><input type="text" name="performanceClass" value="@passport.PerformanceClass" /><small class="bp-field-help">@DirtySignedDataHelp("carbon.performanceClass", "Carbon footprint performance class.")</small></label>
                    <div class="bp-document-row bp-span-all" data-document-upload-card data-document-key="co2StudyReference" data-upload-state="idle">
                        <div class="bp-field-shell bp-document-field-shell">
                            <span>@passport.Documents.Co2StudyReference.Label <em class="bp-field-marker">@RequirementLabel("carbon.co2StudyReference")</em></span>
                            <div class="bp-document-main-line">
                                <input type="text" name="document_co2StudyReference" value="@passport.Documents.Co2StudyReference.Url" data-document-url="co2StudyReference" aria-label="@passport.Documents.Co2StudyReference.Label URL or reference" />
                                <button type="button" class="bp-secondary-button bp-button-compact bp-document-smart-upload" data-document-upload data-document-upload-label data-default-label="Choose file">Choose file</button>
                                <input type="file" class="bp-document-hidden-file" accept="application/pdf,image/*" data-document-file aria-label="Upload @passport.Documents.Co2StudyReference.Label file" />
                            </div>
                            <small class="bp-field-help">@DirtySignedDataHelp("carbon.co2StudyReference", "Reference URL for the carbon footprint study.")</small>
                            <label class="bp-document-sha-field">
                                <span>SHA-256</span>
                                <input type="text" readonly data-document-sha value="@passport.Documents.Co2StudyReference.Sha256" placeholder="No uploaded file hash yet" />
                            </label>
                            <p class="bp-document-upload-status" data-document-upload-status aria-live="polite" hidden></p>
                        </div>
                        <label class="bp-field-shell bp-document-visibility-field"><span>@passport.Documents.Co2StudyReference.Label visibility <em class="bp-field-marker">@RequirementLabel("carbon.co2StudyReference")</em></span><select name="document_co2StudyReference_visibility" data-document-visibility="co2StudyReference"><option value="private" selected="@(!IsPublicDocument(passport.Documents.Co2StudyReference))">Private / privileged</option><option value="public" selected="@(IsPublicDocument(passport.Documents.Co2StudyReference))">Public document</option></select><small class="bp-field-help">@DirtySignedDataHelp("carbon.co2StudyReference", "Controls who can download this study.")</small></label>
                    </div>
                </div>
            </section>

            <div class="d-flex justify-content-end flex-wrap gap-2">
                <button type="button" class="bp-secondary-button" data-cancel-edits data-cancel-href="@cancelHref">Cancel edits</button>
                <button type="submit" class="bp-primary-button">@submitLabel</button>
            </div>
        </div>
    </form>

    <div class="bp-modal" data-cancel-modal hidden>
        <div class="bp-modal-backdrop" data-cancel-dismiss></div>
        <div class="bp-modal-panel" role="dialog" aria-modal="true" aria-labelledby="cancel-edits-title" aria-describedby="cancel-edits-description">
            <h2 id="cancel-edits-title" class="h5 mb-2">Discard unsaved edits?</h2>
            <p id="cancel-edits-description" class="mb-3">You have unsaved changes. Leaving this page will discard them.</p>
            <div class="d-flex justify-content-end flex-wrap gap-2">
                <button type="button" class="bp-secondary-button" data-cancel-stay>Keep editing</button>
                <button type="button" class="bp-danger-button" data-cancel-discard>Discard changes</button>
            </div>
        </div>
    </div>
</main>
@section Scripts {
    <script>
        (function () {
            const form = document.querySelector('[data-edit-passport-form]');
            if (!form) {
                return;
            }

            const navButtons = Array.from(form.querySelectorAll('.bp-edit-nav-button[data-section-target]'));
            const sections = Array.from(form.querySelectorAll('.bp-edit-section[id]'));
            if (navButtons.length === 0 || sections.length === 0) {
                return;
            }
            const cancelButton = form.querySelector('[data-cancel-edits]');
            const cancelModal = document.querySelector('[data-cancel-modal]');
            const stayEditingButton = cancelModal?.querySelector('[data-cancel-stay]');
            const discardChangesButton = cancelModal?.querySelector('[data-cancel-discard]');
            const dismissTarget = cancelModal?.querySelector('[data-cancel-dismiss]');
            const cancelHref = cancelButton?.dataset.cancelHref ?? '';
            const batteryImageSelect = form.querySelector('[data-battery-image-select]');
            const categoryInput = form.querySelector('[data-image-category]');
            const productTemplateSelect = form.querySelector('[data-product-template-select]');
            const productVersionSelect = form.querySelector('[data-product-version-select]');
            const productSoftwareVersionInput = form.querySelector('[data-product-software-version]');
            const productSoftwareReleaseInput = form.querySelector('[data-product-software-release]');
            const productSoftwareUpdateInput = form.querySelector('[data-product-software-update]');
            const productTemplateCatalogElement = document.querySelector('[data-product-template-catalog]');
            const productTemplateCatalog = parseProductTemplateCatalog(productTemplateCatalogElement?.textContent || '[]');
            const passportId = form.dataset.passportId ?? '';
            const uploadCards = Array.from(form.querySelectorAll('[data-document-upload-card]'));
            const serialNumberInput = form.elements.serialNumber;
            const batteryIdPreview = form.querySelector('[data-battery-id-preview]');
            const batteryIdPreviewEndpoint = '/admin/batteries/id-preview';
            let batteryIdPreviewAbortController = null;

            const sectionById = new Map(sections.map((section) => [section.id, section]));
            const defaultSectionId = navButtons
                .map((button) => button.dataset.sectionTarget)
                .find((sectionId) => sectionId && sectionById.has(sectionId)) || sections[0].id;
            let pristineFormState = serializeFormState(form);

            function serializeFormState(targetForm) {
                const formData = new FormData(targetForm);
                const entries = [];
                for (const [key, value] of formData.entries()) {
                    if (key === '__RequestVerificationToken') {
                        continue;
                    }
                    entries.push([key, String(value)]);
                }

                entries.sort((left, right) => {
                    if (left[0] === right[0]) {
                        return left[1].localeCompare(right[1]);
                    }
                    return left[0].localeCompare(right[0]);
                });

                return JSON.stringify(entries);
            }

            function hasUnsavedChanges() {
                return serializeFormState(form) !== pristineFormState;
            }

            function parseProductTemplateCatalog(rawJson) {
                try {
                    const parsed = JSON.parse(rawJson);
                    return Array.isArray(parsed) ? parsed : [];
                } catch {
                    return [];
                }
            }

            async function updateBatteryIdPreview() {
                if (!batteryIdPreview || !productTemplateSelect || !serialNumberInput) {
                    return;
                }

                const serialNumber = String(serialNumberInput.value || '').trim();
                if (!serialNumber) {
                    batteryIdPreview.textContent = '-';
                    return;
                }

                batteryIdPreview.textContent = 'Generating...';
                batteryIdPreviewAbortController?.abort();
                batteryIdPreviewAbortController = new AbortController();

                const query = new URLSearchParams({
                    productId: productTemplateSelect.value || '',
                    serialNumber
                });

                try {
                    const response = await fetch(`${batteryIdPreviewEndpoint}?${query}`, {
                        headers: { Accept: 'application/json' },
                        signal: batteryIdPreviewAbortController.signal
                    });
                    if (!response.ok) {
                        batteryIdPreview.textContent = '-';
                        return;
                    }

                    const payload = await response.json();
                    batteryIdPreview.textContent = payload.batteryId || '-';
                } catch (error) {
                    if (error.name !== 'AbortError') {
                        batteryIdPreview.textContent = '-';
                    }
                }
            }

            function setFieldValue(name, value) {
                const input = form.elements[name];
                if (!input) {
                    return;
                }

                input.value = value ?? '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }

            function findCatalogProduct(productId) {
                return productTemplateCatalog.find((product) =>
                    String(product.ProductId || '').toLowerCase() === String(productId || '').toLowerCase());
            }

            function findCatalogProductVersion(product, productVersion) {
                const versions = Array.isArray(product?.ProductVersions) ? product.ProductVersions : [];
                return versions.find((version) =>
                    String(version.Version || '').toLowerCase() === String(productVersion || '').toLowerCase())
                    || versions[0]
                    || product;
            }

            function selectLatestProductVersion(product) {
                const versions = Array.isArray(product?.ProductVersions) ? product.ProductVersions : [];
                const selectedOption = productTemplateSelect?.selectedOptions?.[0];
                return product?.LatestProductVersion
                    || selectedOption?.dataset.latestProductVersion
                    || versions[versions.length - 1]?.Version
                    || versions[0]?.Version
                    || '';
            }

            function updateProductVersionOptions(product, preferredVersion, preferLatest) {
                if (!productVersionSelect || !product) {
                    return;
                }

                const versions = Array.isArray(product.ProductVersions) ? product.ProductVersions : [];
                productVersionSelect.innerHTML = '';
                versions.forEach((productVersion) => {
                    const option = document.createElement('option');
                    option.value = productVersion.Version || '';
                    option.textContent = productVersion.Version || '';
                    productVersionSelect.appendChild(option);
                });

                const hasPreferred = versions.some((productVersion) =>
                    String(productVersion.Version || '').toLowerCase() === String(preferredVersion || '').toLowerCase());
                productVersionSelect.value = preferLatest
                    ? selectLatestProductVersion(product)
                    : hasPreferred
                        ? preferredVersion
                        : versions[0]?.Version || '';
            }

            function updateSoftwareParameters(productVersion) {
                if (!productVersion) {
                    return;
                }

                if (productSoftwareVersionInput) {
                    productSoftwareVersionInput.value = productVersion.SoftwareVersion || '';
                }
                if (productSoftwareReleaseInput) {
                    productSoftwareReleaseInput.value = productVersion.SoftwareReleaseDate || '';
                }
                if (productSoftwareUpdateInput) {
                    productSoftwareUpdateInput.value = productVersion.SoftwareLatestUpdate || '';
                }
            }

            function applyProductTemplateSelection(updateVersionList, updateSoftwareList, preferLatestVersion = false) {
                const product = findCatalogProduct(productTemplateSelect?.value || '');
                if (!product) {
                    return;
                }

                const previousProductVersion = productVersionSelect?.value || '';
                if (updateVersionList) {
                    updateProductVersionOptions(product, previousProductVersion, preferLatestVersion);
                }

                const productVersion = findCatalogProductVersion(product, productVersionSelect?.value || '');
                if (updateSoftwareList) {
                    updateSoftwareParameters(productVersion);
                }

                const materialFieldMap = {
                    Nickel: 'materialNickel',
                    Copper: 'materialCopper',
                    Aluminium: 'materialAluminium',
                    Graphite: 'materialGraphite',
                    Manganese: 'materialManganese',
                    Cobalt: 'materialCobalt',
                    Lithium: 'materialLithium',
                    'Electrolyte and separators': 'materialElectrolyte'
                };
                const carbonFieldMap = {
                    'raw material extraction': 'carbonRawMaterial',
                    'main production': 'carbonMainProduction',
                    distribution: 'carbonDistribution',
                    recycling: 'carbonRecycling'
                };
                const recycledFieldMap = {
                    Nickel: 'recycledNickel',
                    Cobalt: 'recycledCobalt',
                    Lithium: 'recycledLithium',
                    Lead: 'recycledLead'
                };

                const templateValues = productVersion || product;
                setFieldValue('batteryImageUrl', product.ImageUrl || '');
                setFieldValue('batteryMass', templateValues.BatteryMassKg);
                setFieldValue('ratedEnergy', templateValues.RatedEnergyKwh);
                setFieldValue('ratedCapacity', templateValues.RatedCapacityAh);
                setFieldValue('ratedMaximumPower', templateValues.RatedMaximumPowerKw);
                setFieldValue('nominalVoltage', templateValues.NominalVoltageV);
                setFieldValue('expectedLifetime', templateValues.ExpectedLifetimeYears);
                setFieldValue('expectedNumberOfCycles', templateValues.ExpectedCycles);
                setFieldValue('remainingEnergy', Math.round((Number(templateValues.RatedEnergyKwh || 0) * 0.95) * 100) / 100);
                setFieldValue('supplyChainIndex', templateValues.SupplyChainIndex);
                setFieldValue('carbonFootprint', templateValues.CarbonFootprint);
                setFieldValue('performanceClass', templateValues.PerformanceClass || '');

                Object.entries(templateValues.MaterialMassesKg || {}).forEach(([label, value]) => {
                    if (materialFieldMap[label]) {
                        setFieldValue(materialFieldMap[label], value);
                    }
                });
                Object.entries(templateValues.CarbonStages || {}).forEach(([label, value]) => {
                    if (carbonFieldMap[label]) {
                        setFieldValue(carbonFieldMap[label], value);
                    }
                });
                Object.entries(templateValues.RecycledContent || {}).forEach(([label, value]) => {
                    const prefix = recycledFieldMap[label];
                    if (!prefix) {
                        return;
                    }

                    setFieldValue(`${prefix}Pre`, value.PreConsumerShare);
                    setFieldValue(`${prefix}Post`, value.PostConsumerShare);
                    const primaryShare = Math.max(0, 100 - Number(value.PreConsumerShare || 0) - Number(value.PostConsumerShare || 0));
                    setFieldValue(`${prefix}Primary`, primaryShare);
                });

                syncCategoryFromImage();
            }

            function openCancelModal() {
                if (!cancelModal) {
                    return;
                }

                cancelModal.hidden = false;
                document.body.classList.add('bp-modal-open');
                stayEditingButton?.focus();
            }

            function closeCancelModal() {
                if (!cancelModal) {
                    return;
                }

                cancelModal.hidden = true;
                document.body.classList.remove('bp-modal-open');
                cancelButton?.focus();
            }

            function syncCategoryFromImage() {
                if (!batteryImageSelect || !categoryInput) {
                    return;
                }

                const selectedOption = batteryImageSelect.options[batteryImageSelect.selectedIndex];
                const category = selectedOption?.dataset.imageCategory ?? '';
                categoryInput.value = category;
            }

            function setUploadStatus(card, state, message) {
                const status = card.querySelector('[data-document-upload-status]');
                card.dataset.uploadState = state;
                if (status) {
                    status.textContent = message;
                    status.hidden = !message;
                }
            }

            function setUploadButtonState(card, state, fileName) {
                const button = card.querySelector('[data-document-upload]');
                const label = card.querySelector('[data-document-upload-label]');
                if (!button || !label) {
                    return;
                }

                const defaultLabel = button.dataset.defaultLabel || 'Choose file';
                if (state === 'ready') {
                    label.textContent = 'Upload selected file';
                    button.title = fileName ? `Upload ${fileName}` : 'Upload selected file';
                    return;
                }

                if (state === 'busy') {
                    label.textContent = 'Uploading...';
                    button.title = 'Uploading evidence file';
                    return;
                }

                if (state === 'success') {
                    label.textContent = 'Uploaded';
                    button.title = 'Click to choose a replacement file';
                    return;
                }

                label.textContent = defaultLabel;
                button.title = defaultLabel;
            }

            function syncUploadedDocumentReference(documentKey, result) {
                const urlInput = form.querySelector(`[data-document-url="${documentKey}"]`);
                const shaInput = form.querySelector(`[data-document-key="${documentKey}"] [data-document-sha]`);
                if (urlInput && typeof result.url === 'string') {
                    urlInput.value = result.url;
                }
                if (shaInput && typeof result.sha256 === 'string') {
                    shaInput.value = result.sha256;
                }
            }

            async function uploadDocumentEvidence(card) {
                const documentKey = card.dataset.documentKey ?? '';
                const fileInput = card.querySelector('[data-document-file]');
                const button = card.querySelector('[data-document-upload]');
                const visibilitySelect = form.querySelector(`[data-document-visibility="${documentKey}"]`);
                const selectedFile = fileInput?.files?.[0];
                if (!passportId || !documentKey) {
                    setUploadStatus(card, 'error', 'Save or create the passport before uploading evidence.');
                    return;
                }

                if (!selectedFile) {
                    if (fileInput) {
                        fileInput.click();
                    }
                    return;
                }

                const hadUnsavedChanges = hasUnsavedChanges();
                const formData = new FormData();
                formData.append('passportId', passportId);
                formData.append('documentKey', documentKey);
                formData.append('file', selectedFile);
                formData.append('publicAccess', visibilitySelect?.value ?? 'private');

                button?.setAttribute('disabled', 'disabled');
                setUploadButtonState(card, 'busy');
                setUploadStatus(card, 'busy', 'Uploading evidence and calculating SHA-256 hash...');

                try {
                    const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const response = await fetch('/api/files', {
                        method: 'POST',
                        headers: token ? { 'RequestVerificationToken': token } : {},
                        body: formData
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok) {
                        throw new Error(result.error || 'Upload failed.');
                    }

                    syncUploadedDocumentReference(documentKey, result);
                    if (fileInput) {
                        fileInput.value = '';
                    }
                    setUploadButtonState(card, 'success');
                    if (!hadUnsavedChanges) {
                        pristineFormState = serializeFormState(form);
                    }

                    const sha256 = typeof result.sha256 === 'string' ? result.sha256 : '';
                    const url = typeof result.url === 'string' ? result.url : '';
                    setUploadStatus(card, 'success', `Uploaded to ${url}. SHA-256: ${sha256}`);
                } catch (error) {
                    const message = error instanceof Error ? error.message : 'Upload failed.';
                    setUploadButtonState(card, selectedFile ? 'ready' : 'idle', selectedFile?.name);
                    setUploadStatus(card, 'error', message);
                } finally {
                    button?.removeAttribute('disabled');
                }
            }

            function setActiveSection(sectionId, updateHash) {
                if (!sectionById.has(sectionId)) {
                    return;
                }

                sections.forEach((section) => {
                    const isActive = section.id === sectionId;
                    section.hidden = !isActive;
                });

                navButtons.forEach((button) => {
                    const isActive = button.dataset.sectionTarget === sectionId;
                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                    if (isActive) {
                        button.setAttribute('aria-current', 'true');
                    } else {
                        button.removeAttribute('aria-current');
                    }
                });

                if (updateHash) {
                    history.replaceState(null, '', '#' + sectionId);
                }
            }

            function fieldShellControl(shell) {
                return shell.querySelector('input:not([type="hidden"]), select, textarea');
            }

            function isRequiredFieldShell(shell) {
                return (shell.querySelector('.bp-field-marker')?.textContent || '').trim().toLowerCase() === 'required';
            }

            function controlIsMissingOrInvalid(control) {
                if (!control || control.disabled || control.readOnly) {
                    return false;
                }

                const value = String(control.value || '').trim();
                return value.length === 0 || (control.validity && !control.validity.valid);
            }

            function clearMissingRequiredFields() {
                form.querySelectorAll('.bp-field-shell.is-invalid').forEach((shell) => shell.classList.remove('is-invalid'));
                navButtons.forEach((button) => button.classList.remove('has-missing-fields'));
            }

            function markMissingRequiredFields() {
                clearMissingRequiredFields();
                const missingShells = Array.from(form.querySelectorAll('.bp-field-shell'))
                    .filter(isRequiredFieldShell)
                    .filter((shell) => controlIsMissingOrInvalid(fieldShellControl(shell)));
                missingShells.forEach((shell) => {
                    shell.classList.add('is-invalid');
                    const section = shell.closest('.bp-edit-section[id]');
                    if (!section) {
                        return;
                    }

                    const button = navButtons.find((candidate) => candidate.dataset.sectionTarget === section.id);
                    button?.classList.add('has-missing-fields');
                });

                return missingShells;
            }

            navButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    const targetSection = button.dataset.sectionTarget;
                    if (!targetSection) {
                        return;
                    }

                    setActiveSection(targetSection, true);
                });
            });

            window.addEventListener('hashchange', () => {
                const hashSectionId = window.location.hash.replace('#', '');
                if (sectionById.has(hashSectionId)) {
                    setActiveSection(hashSectionId, false);
                }
            });

            const hashSectionId = window.location.hash.replace('#', '');
            setActiveSection(sectionById.has(hashSectionId) ? hashSectionId : defaultSectionId, true);
            syncCategoryFromImage();
            batteryImageSelect?.addEventListener('change', syncCategoryFromImage);
            pristineFormState = serializeFormState(form);
            productTemplateSelect?.addEventListener('change', () => {
                applyProductTemplateSelection(true, true, true);
                updateBatteryIdPreview();
            });
            productVersionSelect?.addEventListener('change', () => {
                applyProductTemplateSelection(false, true);
            });
            serialNumberInput?.addEventListener('input', updateBatteryIdPreview);
            updateBatteryIdPreview();
            form.addEventListener('submit', (event) => {
                if (form.dataset.requiredPassportValidation !== 'true') {
                    return;
                }

                const missingShells = markMissingRequiredFields();
                if (missingShells.length === 0) {
                    return;
                }

                event.preventDefault();
                const firstSection = missingShells[0].closest('.bp-edit-section[id]');
                if (firstSection) {
                    setActiveSection(firstSection.id, true);
                }
                fieldShellControl(missingShells[0])?.focus();
            });
            uploadCards.forEach((card) => {
                const button = card.querySelector('[data-document-upload]');
                const fileInput = card.querySelector('[data-document-file]');
                button?.addEventListener('click', () => uploadDocumentEvidence(card));
                fileInput?.addEventListener('change', () => {
                    const selectedFile = fileInput.files?.[0];
                    if (!selectedFile) {
                        setUploadButtonState(card, 'idle');
                        return;
                    }

                    setUploadButtonState(card, 'ready', selectedFile.name);
                    setUploadStatus(card, 'ready', selectedFile.name);
                });
            });

            cancelButton?.addEventListener('click', () => {
                if (!cancelHref) {
                    return;
                }

                if (!hasUnsavedChanges()) {
                    window.location.assign(cancelHref);
                    return;
                }

                openCancelModal();
            });

            stayEditingButton?.addEventListener('click', closeCancelModal);
            dismissTarget?.addEventListener('click', closeCancelModal);
            discardChangesButton?.addEventListener('click', () => {
                if (!cancelHref) {
                    return;
                }

                window.location.assign(cancelHref);
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && cancelModal && !cancelModal.hidden) {
                    event.preventDefault();
                    closeCancelModal();
                }
            });
        })();
    </script>
}
