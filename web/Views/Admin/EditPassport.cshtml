@model BatteryPassWeb.Models.ViewModels.EditPassportViewModel
@{
    var isNew = Model.Mode.Equals("new", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isNew ? "Create passport" : "Edit passport";
    var passport = Model.Passport;
    var formAction = isNew ? "/admin/passports/create" : "/admin/passports/save";
    var submitLabel = isNew ? "Create passport" : "Save passport";
    var cancelHref = "/admin/passports";
    var batteryImageOptions = BatteryPassWeb.Services.BatteryImageCatalog.Options;
    var selectedBatteryImageUrl = BatteryPassWeb.Services.BatteryImageCatalog.NormalizeKnownImageUrl(passport.BatteryImageUrl, passport.PassportId);
    var selectedBatteryCategory = BatteryPassWeb.Services.BatteryImageCatalog.CategoryForImageUrl(selectedBatteryImageUrl);

    double SegmentValue(string label, IReadOnlyList<BatteryPassWeb.Models.ViewModels.ChartSegmentViewModel> segments)
        => segments.FirstOrDefault(segment => segment.Label.Equals(label, StringComparison.OrdinalIgnoreCase))?.Value ?? 0;

    BatteryPassWeb.Models.ViewModels.RecycledContentChartViewModel Recycled(string material)
        => passport.RecycledContentCharts.FirstOrDefault(chart => chart.Material.Equals(material, StringComparison.OrdinalIgnoreCase))
            ?? new BatteryPassWeb.Models.ViewModels.RecycledContentChartViewModel { Material = material };
}
<main class="bp-page bp-admin-page">
    <h1 class="mb-1">@(isNew ? "Create passport" : "Edit passport")</h1>
    <p class="bp-passport-id">@passport.PassportId</p>

    <div class="bp-card mt-3">
        <div class="d-flex justify-content-between flex-wrap gap-3 align-items-center">
            <div>
                <span class="bp-summary-title">Trust state</span>
                <p class="mb-0">
                    <strong>@passport.TrustState</strong>
                    @if (passport.TrustIsDirty)
                    {
                        <span class="bp-pill bp-pill-warn ms-2">Dirty</span>
                    }
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="/admin/help" class="bp-secondary-button">Admin help</a>
                <a href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/conformance" class="bp-secondary-button">Open conformance</a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success mt-3 mb-0">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">@Model.ErrorMessage</div>
    }

    <form method="post" action="@formAction" class="bp-edit-grid mt-4" data-edit-passport-form>
        @Html.AntiForgeryToken()
        <nav class="bp-edit-nav" aria-label="Passport categories">
            @foreach (var section in passport.Sections)
            {
                var sectionId = "admin-" + section.ToLowerInvariant().Replace(" ", "-");
                <button type="button" class="bp-edit-nav-button" data-section-target="@sectionId" aria-pressed="false">@(section)</button>
            }
        </nav>

        <div class="bp-edit-form">
            <section id="admin-general" class="bp-card bp-edit-section">
                <h2>General</h2>
                <div class="bp-form-grid">
                    @if (isNew)
                    {
                        <label>Passport ID<input type="text" name="passportId" value="@passport.PassportId" required /></label>
                    }
                    else
                    {
                        <label>Passport ID<input type="text" name="passportId" value="@passport.PassportId" readonly /></label>
                    }
                    <label>Name<input type="text" name="name" value="@passport.DisplayName" /></label>
                    <label>Model Number<input type="text" name="modelNumber" value="@passport.ModelNumber" /></label>
                    <label>Serial Number<input type="text" name="serialNumber" value="@passport.SerialNumber" /></label>
                    <label>Category<input type="text" name="category" value="@selectedBatteryCategory" readonly data-image-category /></label>
                    <label>Status<input type="text" name="batteryStatus" value="@passport.BatteryStatus" /></label>
                    <label>Weight kg<input type="number" step="any" name="batteryMass" value="@passport.Weight" /></label>
                    <label>Manufactured date<input type="date" name="manufacturingDate" value="@passport.ManufacturedDate" /></label>
                    <label>Facility ID<input type="text" name="facilityId" value="@passport.FacilityId" /></label>
                    <label>Manufactured by<input type="text" name="manufacturerName" value="@passport.ManufacturerName" /></label>
                    <label>Registry status
                        <select name="status">
                            @if (passport.RegistryStatus != "archived")
                            {
                                <option value="draft" selected>Draft</option>
                            }
                            else
                            {
                                <option value="draft">Draft</option>
                            }
                            @if (passport.RegistryStatus == "archived")
                            {
                                <option value="archived" selected>Archived</option>
                            }
                            else
                            {
                                <option value="archived">Archived</option>
                            }
                        </select>
                        <small class="text-secondary d-block mt-1">Publishing is handled from the trust workflow after validation and signing.</small>
                    </label>
                    <label>Battery image
                        <select name="batteryImageUrl" data-battery-image-select>
                            @foreach (var imageOption in batteryImageOptions)
                            {
                                if (imageOption.Url.Equals(selectedBatteryImageUrl, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@imageOption.Url" data-image-category="@imageOption.Category" selected>@imageOption.Label (@imageOption.Category)</option>
                                }
                                else
                                {
                                    <option value="@imageOption.Url" data-image-category="@imageOption.Category">@imageOption.Label (@imageOption.Category)</option>
                                }
                            }
                        </select>
                    </label>
                </div>
            </section>

            <section id="admin-material-composition" class="bp-card bp-edit-section">
                <h2>Material composition</h2>
                <div class="bp-form-grid">
                    <label>Nickel kg<input type="number" step="any" name="materialNickel" value="@SegmentValue("Nickel", passport.MaterialCompositionSegments)" /></label>
                    <label>Copper kg<input type="number" step="any" name="materialCopper" value="@SegmentValue("Copper", passport.MaterialCompositionSegments)" /></label>
                    <label>Aluminium kg<input type="number" step="any" name="materialAluminium" value="@SegmentValue("Aluminium", passport.MaterialCompositionSegments)" /></label>
                    <label>Graphite kg<input type="number" step="any" name="materialGraphite" value="@SegmentValue("Graphite", passport.MaterialCompositionSegments)" /></label>
                    <label>Manganese kg<input type="number" step="any" name="materialManganese" value="@SegmentValue("Manganese", passport.MaterialCompositionSegments)" /></label>
                    <label>Cobalt kg<input type="number" step="any" name="materialCobalt" value="@SegmentValue("Cobalt", passport.MaterialCompositionSegments)" /></label>
                    <label>Lithium kg<input type="number" step="any" name="materialLithium" value="@SegmentValue("Lithium", passport.MaterialCompositionSegments)" /></label>
                    <label>Electrolyte and separators kg<input type="number" step="any" name="materialElectrolyte" value="@SegmentValue("Electrolyte and separators", passport.MaterialCompositionSegments)" /></label>
                </div>
            </section>

            <section id="admin-performance" class="bp-card bp-edit-section">
                <h2>Performance</h2>
                <div class="bp-form-grid">
                    <label>Rated energy kWh<input type="number" step="any" name="ratedEnergy" value="@passport.Performance.RatedEnergy" /></label>
                    <label>Rated capacity Ah<input type="number" step="any" name="ratedCapacity" value="@passport.Performance.RatedCapacity" /></label>
                    <label>Maximum power kW<input type="number" step="any" name="ratedMaximumPower" value="@passport.Performance.RatedMaximumPower" /></label>
                    <label>Nominal voltage V<input type="number" step="any" name="nominalVoltage" value="@passport.Performance.NominalVoltage" /></label>
                    <label>Expected lifetime years<input type="number" step="any" name="expectedLifetime" value="@passport.Performance.ExpectedLifetime" /></label>
                    <label>Expected cycles<input type="number" step="any" name="expectedNumberOfCycles" value="@passport.Performance.ExpectedNumberOfCycles" /></label>
                    <label>State of charge %<input type="number" step="any" name="stateOfCharge" value="@passport.Performance.StateOfCharge" /></label>
                    <label>Remaining capacity %<input type="number" step="any" name="remainingCapacity" value="@passport.Performance.RemainingCapacity" /></label>
                    <label>Remaining energy kWh<input type="number" step="any" name="remainingEnergy" value="@passport.Performance.RemainingEnergy" /></label>
                    <label>Full cycles<input type="number" step="any" name="fullCycles" value="@passport.Performance.Cycles" /></label>
                </div>
            </section>

            <section id="admin-compliance" class="bp-card bp-edit-section">
                <h2>Compliance</h2>
                <div class="bp-form-grid">
                    <label>@passport.Documents.ConformityAssessment.Label<input type="text" name="document_conformityAssessment" value="@passport.Documents.ConformityAssessment.Url" /></label>
                    <label>@passport.Documents.EuDeclarationOfConformity.Label<input type="text" name="document_euDeclarationOfConformity" value="@passport.Documents.EuDeclarationOfConformity.Url" /></label>
                </div>
            </section>

            <section id="admin-supply-chain" class="bp-card bp-edit-section">
                <h2>Supply chain</h2>
                <div class="bp-form-grid">
                    <label>Supply chain index<input type="number" step="any" name="supplyChainIndex" value="@passport.SupplyChainIndex" /></label>
                    <label>@passport.Documents.SustainabilityReport.Label<input type="text" name="document_sustainabilityReport" value="@passport.Documents.SustainabilityReport.Url" /></label>
                    <label>@passport.Documents.DueDiligenceReport.Label<input type="text" name="document_dueDiligenceReport" value="@passport.Documents.DueDiligenceReport.Url" /></label>
                    <label>@passport.Documents.ThirdPartyAudit.Label<input type="text" name="document_thirdPartyAudit" value="@passport.Documents.ThirdPartyAudit.Url" /></label>
                    <label>@passport.Documents.TaxonomyReport.Label<input type="text" name="document_taxonomyReport" value="@passport.Documents.TaxonomyReport.Url" /></label>
                </div>
            </section>

            <section id="admin-circularity" class="bp-card bp-edit-section">
                <h2>Circularity</h2>
                <div class="bp-form-grid">
                    <label class="bp-span-2">Separate collection<textarea name="separateCollection">@passport.Circularity.SeparateCollection</textarea></label>
                    <label class="bp-span-2">Waste prevention<textarea name="wastePrevention">@passport.Circularity.WastePrevention</textarea></label>
                    <label>Recycled content share verification
                        <select name="recycledContentShareVerification">
                            @if (passport.Circularity.RecycledContentShareVerification == "verified")
                            {
                                <option value="verified" selected>Verified</option>
                            }
                            else
                            {
                                <option value="verified">Verified</option>
                            }
                            @if (passport.Circularity.RecycledContentShareVerification == "partial")
                            {
                                <option value="partial" selected>Partial</option>
                            }
                            else
                            {
                                <option value="partial">Partial</option>
                            }
                            @if (passport.Circularity.RecycledContentShareVerification == "unverified")
                            {
                                <option value="unverified" selected>Unverified</option>
                            }
                            else
                            {
                                <option value="unverified">Unverified</option>
                            }
                            @if (passport.Circularity.RecycledContentShareVerification == "invalid")
                            {
                                <option value="invalid" selected>Invalid</option>
                            }
                            else
                            {
                                <option value="invalid">Invalid</option>
                            }
                        </select>
                    </label>
                    <label>Nickel pre consumer %<input type="number" step="any" name="recycledNickelPre" value="@Recycled("Nickel").PreConsumerShare" /></label>
                    <label>Nickel post consumer %<input type="number" step="any" name="recycledNickelPost" value="@Recycled("Nickel").PostConsumerShare" /></label>
                    <label>Nickel primary material %<input type="number" step="any" name="recycledNickelPrimary" value="@Recycled("Nickel").PrimaryMaterialShare" /></label>
                    <label>Cobalt pre consumer %<input type="number" step="any" name="recycledCobaltPre" value="@Recycled("Cobalt").PreConsumerShare" /></label>
                    <label>Cobalt post consumer %<input type="number" step="any" name="recycledCobaltPost" value="@Recycled("Cobalt").PostConsumerShare" /></label>
                    <label>Cobalt primary material %<input type="number" step="any" name="recycledCobaltPrimary" value="@Recycled("Cobalt").PrimaryMaterialShare" /></label>
                    <label>Lithium pre consumer %<input type="number" step="any" name="recycledLithiumPre" value="@Recycled("Lithium").PreConsumerShare" /></label>
                    <label>Lithium post consumer %<input type="number" step="any" name="recycledLithiumPost" value="@Recycled("Lithium").PostConsumerShare" /></label>
                    <label>Lithium primary material %<input type="number" step="any" name="recycledLithiumPrimary" value="@Recycled("Lithium").PrimaryMaterialShare" /></label>
                    <label>Lead pre consumer %<input type="number" step="any" name="recycledLeadPre" value="@Recycled("Lead").PreConsumerShare" /></label>
                    <label>Lead post consumer %<input type="number" step="any" name="recycledLeadPost" value="@Recycled("Lead").PostConsumerShare" /></label>
                    <label>Lead primary material %<input type="number" step="any" name="recycledLeadPrimary" value="@Recycled("Lead").PrimaryMaterialShare" /></label>
                </div>
            </section>

            <section id="admin-carbon-footprint" class="bp-card bp-edit-section">
                <h2>Carbon Footprint</h2>
                <div class="bp-form-grid">
                    <label>Amount gCO2e/kWh<input type="number" step="any" name="carbonFootprint" value="@passport.CarbonFootprint" /></label>
                    <label>Performance class<input type="text" name="performanceClass" value="@passport.PerformanceClass" /></label>
                    <label>Raw material extraction gCO2e/kWh<input type="number" step="any" name="carbonRawMaterial" value="@SegmentValue("raw material extraction", passport.CarbonFootprintSegments)" /></label>
                    <label>Main production gCO2e/kWh<input type="number" step="any" name="carbonMainProduction" value="@SegmentValue("main production", passport.CarbonFootprintSegments)" /></label>
                    <label>Distribution gCO2e/kWh<input type="number" step="any" name="carbonDistribution" value="@SegmentValue("distribution", passport.CarbonFootprintSegments)" /></label>
                    <label>Recycling gCO2e/kWh<input type="number" step="any" name="carbonRecycling" value="@SegmentValue("recycling", passport.CarbonFootprintSegments)" /></label>
                    <label class="bp-span-2">@passport.Documents.Co2StudyReference.Label<input type="text" name="document_co2StudyReference" value="@passport.Documents.Co2StudyReference.Url" /></label>
                </div>
            </section>

            <div class="d-flex justify-content-end flex-wrap gap-2">
                <button type="button" class="bp-secondary-button" data-cancel-edits data-cancel-href="@cancelHref">Cancel edits</button>
                <button type="submit" class="bp-primary-button">@submitLabel</button>
            </div>
        </div>
    </form>

    <div class="bp-modal" data-cancel-modal hidden>
        <div class="bp-modal-backdrop" data-cancel-dismiss></div>
        <div class="bp-modal-panel" role="dialog" aria-modal="true" aria-labelledby="cancel-edits-title" aria-describedby="cancel-edits-description">
            <h2 id="cancel-edits-title" class="h5 mb-2">Discard unsaved edits?</h2>
            <p id="cancel-edits-description" class="mb-3">You have unsaved changes. Leaving this page will discard them.</p>
            <div class="d-flex justify-content-end flex-wrap gap-2">
                <button type="button" class="bp-secondary-button" data-cancel-stay>Keep editing</button>
                <button type="button" class="bp-danger-button" data-cancel-discard>Discard changes</button>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        (function () {
            const form = document.querySelector('[data-edit-passport-form]');
            if (!form) {
                return;
            }

            const navButtons = Array.from(form.querySelectorAll('.bp-edit-nav-button[data-section-target]'));
            const sections = Array.from(form.querySelectorAll('.bp-edit-section[id]'));
            if (navButtons.length === 0 || sections.length === 0) {
                return;
            }
            const cancelButton = form.querySelector('[data-cancel-edits]');
            const cancelModal = document.querySelector('[data-cancel-modal]');
            const stayEditingButton = cancelModal?.querySelector('[data-cancel-stay]');
            const discardChangesButton = cancelModal?.querySelector('[data-cancel-discard]');
            const dismissTarget = cancelModal?.querySelector('[data-cancel-dismiss]');
            const cancelHref = cancelButton?.dataset.cancelHref ?? '';
            const batteryImageSelect = form.querySelector('[data-battery-image-select]');
            const categoryInput = form.querySelector('[data-image-category]');

            const sectionById = new Map(sections.map((section) => [section.id, section]));
            const defaultSectionId = navButtons
                .map((button) => button.dataset.sectionTarget)
                .find((sectionId) => sectionId && sectionById.has(sectionId)) || sections[0].id;
            const pristineFormState = serializeFormState(form);

            function serializeFormState(targetForm) {
                const formData = new FormData(targetForm);
                const entries = [];
                for (const [key, value] of formData.entries()) {
                    if (key === '__RequestVerificationToken') {
                        continue;
                    }
                    entries.push([key, String(value)]);
                }

                entries.sort((left, right) => {
                    if (left[0] === right[0]) {
                        return left[1].localeCompare(right[1]);
                    }
                    return left[0].localeCompare(right[0]);
                });

                return JSON.stringify(entries);
            }

            function hasUnsavedChanges() {
                return serializeFormState(form) !== pristineFormState;
            }

            function openCancelModal() {
                if (!cancelModal) {
                    return;
                }

                cancelModal.hidden = false;
                document.body.classList.add('bp-modal-open');
                stayEditingButton?.focus();
            }

            function closeCancelModal() {
                if (!cancelModal) {
                    return;
                }

                cancelModal.hidden = true;
                document.body.classList.remove('bp-modal-open');
                cancelButton?.focus();
            }

            function syncCategoryFromImage() {
                if (!batteryImageSelect || !categoryInput) {
                    return;
                }

                const selectedOption = batteryImageSelect.options[batteryImageSelect.selectedIndex];
                const category = selectedOption?.dataset.imageCategory ?? '';
                categoryInput.value = category;
            }

            function setActiveSection(sectionId, updateHash) {
                if (!sectionById.has(sectionId)) {
                    return;
                }

                sections.forEach((section) => {
                    const isActive = section.id === sectionId;
                    section.hidden = !isActive;
                });

                navButtons.forEach((button) => {
                    const isActive = button.dataset.sectionTarget === sectionId;
                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                    if (isActive) {
                        button.setAttribute('aria-current', 'true');
                    } else {
                        button.removeAttribute('aria-current');
                    }
                });

                if (updateHash) {
                    history.replaceState(null, '', '#' + sectionId);
                }
            }

            navButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    const targetSection = button.dataset.sectionTarget;
                    if (!targetSection) {
                        return;
                    }

                    setActiveSection(targetSection, true);
                });
            });

            window.addEventListener('hashchange', () => {
                const hashSectionId = window.location.hash.replace('#', '');
                if (sectionById.has(hashSectionId)) {
                    setActiveSection(hashSectionId, false);
                }
            });

            const hashSectionId = window.location.hash.replace('#', '');
            setActiveSection(sectionById.has(hashSectionId) ? hashSectionId : defaultSectionId, true);
            syncCategoryFromImage();
            batteryImageSelect?.addEventListener('change', syncCategoryFromImage);

            cancelButton?.addEventListener('click', () => {
                if (!cancelHref) {
                    return;
                }

                if (!hasUnsavedChanges()) {
                    window.location.assign(cancelHref);
                    return;
                }

                openCancelModal();
            });

            stayEditingButton?.addEventListener('click', closeCancelModal);
            dismissTarget?.addEventListener('click', closeCancelModal);
            discardChangesButton?.addEventListener('click', () => {
                if (!cancelHref) {
                    return;
                }

                window.location.assign(cancelHref);
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && cancelModal && !cancelModal.hidden) {
                    event.preventDefault();
                    closeCancelModal();
                }
            });
        })();
    </script>
}
