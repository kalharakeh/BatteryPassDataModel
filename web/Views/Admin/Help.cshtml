@{
    ViewData["Title"] = "Admin workflow help";
    var statusMessage = ViewData["StatusMessage"] as string ?? string.Empty;
    var errorMessage = ViewData["ErrorMessage"] as string ?? string.Empty;
}

<main class="bp-page bp-admin-page bp-admin-help-page">

    @await Html.PartialAsync("_AdminTabs", "help")
    @await Html.PartialAsync("_HelpTabs", "team")

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="bp-alert bp-alert-success">@statusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="bp-alert bp-alert-danger">@errorMessage</div>
    }

    <section class="bp-card bp-admin-help-reference-console" aria-label="Admin workflow help">
        <div class="bp-admin-help-reference-toolbar">
            <div class="bp-admin-help-reference-copy">
                <span class="bp-summary-title">Admin workflow help</span>
                <h2>From product data to a published passport.</h2>
                <p>Each row is one step; open its details for what to do.</p>
            </div>
            <nav class="bp-admin-help-anchor-tabs" aria-label="Admin help sections">
                <a href="#target-state">Target state</a>
                <a href="#workflow-steps">Workflow steps</a>
                <a href="#status-dictionary">Status dictionary</a>
                <a href="#ready-checklist">Ready checklist</a>
            </nav>
            <nav class="bp-admin-help-primary-actions" aria-label="Primary admin actions">
                <a href="/admin/batteries/new" class="bp-primary-button">Create battery</a>
                <a href="/admin/families" class="bp-secondary-button">Open battery families</a>
                <a href="/admin/batteries" class="bp-secondary-button">Open batteries</a>
            </nav>
        </div>

        <div class="bp-table-scroll">
                <table id="workflow-steps" class="table bp-console-table bp-admin-help-workflow-table bp-mobile-card-table">
                <thead>
                    <tr>
                        <th>Workflow</th>
                        <th>When to use</th>
                        <th>Admin surface</th>
                        <th>Success signal</th>
                        <th class="bp-action-cell">Details</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Set up product data</strong><small>Families, models, batches, sites and operators.</small></span></td>
                        <td>Before the first battery of a model.</td>
                        <td><a href="/admin/families">Battery families</a> and <a href="/admin/sites-and-operators">Sites and operators</a></td>
                        <td>The model and its batch say every value needed by Feb 2027 is filled in.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-product" aria-expanded="false" aria-controls="admin-detail-product" aria-label="Show product data details" title="Show product data details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Create battery ID</strong><small>Start a draft passport.</small></span></td>
                        <td>A new battery is made.</td>
                        <td><a href="/admin/batteries/new">Create battery</a></td>
                        <td>Draft saved with its batch, economic operator and cluster.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-create" aria-expanded="false" aria-controls="admin-detail-create" aria-label="Show create battery ID details" title="Show create battery ID details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Fill battery information</strong><small>This battery's own values.</small></span></td>
                        <td>The draft needs its own values or its first live values.</td>
                        <td><a href="/admin/batteries">Batteries</a></td>
                        <td>The battery page says every value needed by Feb 2027 is filled in.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-fill" aria-expanded="false" aria-controls="admin-detail-fill" aria-label="Show fill battery information details" title="Show fill battery information details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Publish passport</strong><small>Check, sign and publish in one step.</small></span></td>
                        <td>Nothing blocks publication any more.</td>
                        <td>The battery page, Publication</td>
                        <td>The battery shows "Published · version 1".</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-publish" aria-expanded="false" aria-controls="admin-detail-publish" aria-label="Show publish passport details" title="Show publish passport details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Edit after publishing</strong><small>Change what a published passport shows.</small></span></td>
                        <td>A value on the battery, its model, batch, site or operator changes.</td>
                        <td>The editor that holds the value</td>
                        <td>You are asked first, then a new version is published.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-edit" aria-expanded="false" aria-controls="admin-detail-edit" aria-label="Show edit after publishing details" title="Show edit after publishing details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>API Token Management</strong><small>Credentials for other systems.</small></span></td>
                        <td>A battery system sends live values, or another system reads passports.</td>
                        <td><a href="/admin/clusters?tab=api-token-management">API Token Management</a></td>
                        <td>The system has its token, with the right cluster and permission.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-tokens" aria-expanded="false" aria-controls="admin-detail-tokens" aria-label="Show API token management details" title="Show API token management details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr class="bp-admin-help-detail-row" data-admin-help-detail-row hidden>
                        <td colspan="5">
                            <div class="bp-admin-help-selected-panel" aria-live="polite" tabindex="-1" hidden>
            <article id="admin-detail-product" class="bp-admin-help-detail-panel" data-admin-help-detail-panel>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Product data</span><h3>Most values are entered once and shared.</h3><p>A model's values, a batch's values (one per calendar year and manufacturing site) and the site's and economic operator's values are shared by every battery made from them. The V3 attribute list decides which values are required, and by when.</p></div>
            </article>
            <article id="admin-detail-create" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">First-time passport checklist</span><h3>Create a passport from scratch</h3><p>Choose the battery's batch, economic operator and cluster, and type its serial number, manufacturing date and warranty. The app issues the battery ID.</p></div>
                <ol class="bp-admin-help-detail-list">
                    <li>Make sure the model, the batch, the site and the operator are complete in <a href="/admin/families">battery families</a> and sites and operators.</li>
                    <li>Create the battery, then fill its own values on its page.</li>
                    <li>Publish it from its page when nothing blocks publication.</li>
                </ol>
            </article>
            <article id="admin-detail-fill" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Required data</span><h3>Fill what the passport needs.</h3><p>Every field shows whether it is required by Feb 2027, required later or conditional.</p></div>
                <div class="bp-admin-help-detail-grid">
                    <section class="bp-admin-help-detail-card"><h4>Required data</h4><p>Values required by Feb 2027 block publication while empty, including the first state of charge and temperature.</p></section>
                    <section class="bp-admin-help-detail-card"><h4>Optional data</h4><p>Conditional values apply only to some batteries and never block; values required later only give a warning.</p></section>
                </div>
            </article>
            <article id="admin-detail-publish" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Publishing</span><h3>One step makes the passport public.</h3><p>Publishing checks the passport against the official schema and the publication rules, signs it and makes it public. Each version keeps its signature, and the Versions table on the battery page says whether it still matches.</p></div>
            </article>
            <article id="admin-detail-edit" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">After publishing</span><h3>Changes publish a new version.</h3><p>Saving a change that reaches published passports asks first, then publishes a new version of each. Live values and accident reports change the passport in place, without a new version.</p></div>
            </article>
            <article id="admin-detail-tokens" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">External systems</span><h3>Use scoped credentials.</h3><p>A token's value is shown only when it is created or regenerated. A cluster token reads that cluster's batteries and, with "Read + write", sends their live values. Only a token with Global access acts as the team: it creates and publishes batteries.</p></div>
            </article>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section id="target-state" class="bp-card bp-admin-help-status-console">
        <div class="bp-admin-help-section-heading">
            <span class="bp-summary-title">The target state</span>
            <h2>How the battery needs to be</h2>
            <p>A battery passport is ready when its values needed by Feb 2027 are filled in and its current version is published.</p>
        </div>
        <div class="bp-admin-help-policy-note">
            <strong>Completion policy</strong>
            <span>The <strong>Battery families tab</strong> holds each battery model's passport values and its batches; the V3 attribute list decides which values are required, and by when.</span>
            <a href="/admin/families" class="bp-secondary-button bp-button-compact">Open battery families</a>
        </div>
        <section id="status-dictionary" aria-label="Status dictionary">
            <div class="bp-table-scroll">
                <table class="table bp-console-table bp-admin-help-status-table bp-mobile-card-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Meaning</th>
                            <th>Admin action</th>
                        </tr>
                    </thead>
                    <tbody>
                    <tr><td data-label="Status"><strong>Draft</strong></td><td data-label="Meaning">Not published yet; seen only by the team.</td><td data-label="Admin action">Fill its values, then publish.</td></tr>
                    <tr><td data-label="Status"><strong>Published</strong></td><td data-label="Meaning">Its current version is active and public, signed when it was published.</td><td data-label="Admin action">Keep its values current.</td></tr>
                    <tr><td data-label="Status"><strong>Archived version</strong></td><td data-label="Meaning">An earlier version, kept with its signature when a newer one was published.</td><td data-label="Admin action">Nothing to do.</td></tr>
                    <tr><td data-label="Status"><strong>Public discovery</strong></td><td data-label="Meaning">Public search and the QR code open only published passports.</td><td data-label="Admin action">Publish to make it findable.</td></tr>
                    <tr><td data-label="Status"><strong>Admin discovery</strong></td><td data-label="Meaning">Drafts stay visible to the team only, on the Batteries page.</td><td data-label="Admin action">Finish and publish them.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </section>

    <section id="ready-checklist" class="bp-card bp-admin-help-ready-console">
        <div class="bp-admin-help-section-heading"><span class="bp-summary-title">Quick checklist</span><h2>Before you say this battery is ready</h2></div>
        <div class="bp-admin-help-detail-grid">
            <section class="bp-admin-help-detail-card">
                <span class="bp-summary-title">What public users can see</span>
                <p>The QR code and public search open the public summary: the public values, the document links and the family picture.</p>
            </section>
            <section class="bp-admin-help-detail-card">
                <span class="bp-summary-title">What admins can see</span>
                <p>The team sees every battery, its drafts, versions and signatures. Signed-in readers see what their role allows on the detail page.</p>
            </section>
        </div>
        <ul class="bp-admin-help-ready-list">
            <li>The model, batch, site and operator are complete.</li>
            <li>The battery's own values and first live values are filled in.</li>
            <li>The publication checks show nothing blocking.</li>
            <li>The battery page says "Published" with the latest version.</li>
            <li>The QR code opens the public summary.</li>
        </ul>
    </section>
</main>

@section Scripts {
    <script>
        (() => {
            const buttons = Array.from(document.querySelectorAll('[data-admin-help-detail-target]'));
            const panels = Array.from(document.querySelectorAll('[data-admin-help-detail-panel]'));
            const detailRegion = document.querySelector('.bp-admin-help-selected-panel');
            const detailRow = document.querySelector('[data-admin-help-detail-row]');
            const activatePanel = (targetId, shouldOpen) => {
                panels.forEach(panel => {
                    panel.hidden = panel.id !== targetId || !shouldOpen;
                });
                buttons.forEach(button => {
                    const isActive = shouldOpen && button.getAttribute('data-admin-help-detail-target') === targetId;
                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('aria-expanded', isActive ? 'true' : 'false');
                });
                if (detailRegion) {
                    detailRegion.hidden = !shouldOpen;
                }
                if (detailRow) {
                    detailRow.hidden = !shouldOpen;
                }
            };

            buttons.forEach(button => {
                button.addEventListener('click', () => {
                    const targetId = button.getAttribute('data-admin-help-detail-target');
                    const targetPanel = targetId ? document.getElementById(targetId) : null;
                    const hostRow = button.closest('tr');
                    const isSameVisible = Boolean(targetPanel && detailRow && !targetPanel.hidden && !detailRow.hidden);
                    if (targetId) {
                        if (hostRow && detailRow && hostRow.parentNode) {
                            hostRow.parentNode.insertBefore(detailRow, hostRow.nextSibling);
                        }
                        activatePanel(targetId, !isSameVisible);
                        if (!isSameVisible && detailRegion) {
                            detailRegion.focus({ preventScroll: true });
                        }
                    }
                });
            });
        })();
    </script>
}
