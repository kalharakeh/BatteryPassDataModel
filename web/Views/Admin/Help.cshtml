@{
    ViewData["Title"] = "Admin workflow help";
    var statusMessage = ViewData["StatusMessage"] as string ?? string.Empty;
    var errorMessage = ViewData["ErrorMessage"] as string ?? string.Empty;
}

<main class="bp-page bp-admin-page bp-admin-help-page">
    <div class="bp-page-return-row">
        <a href="/admin" class="bp-page-return-link">Back to main admin page</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="bp-alert bp-alert-success">@statusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="bp-alert bp-alert-danger">@errorMessage</div>
    }

    <section class="bp-admin-help-demo-reset" aria-label="Battery family reset">
        <div>
            <span class="bp-summary-title">Battery family reset</span>
            <strong>Restore one unassigned demonstrator plus six clustered customer batteries from MongoDB battery families.</strong>
            <p>This guarded reset recreates Compact 7M, Compact 13M, and Core battery families with battery versions, software parameters, evidence files, clusters, users, and exactly seven passport records.</p>
        </div>
        <form method="post" action="/admin/product-templates/reset">
            @Html.AntiForgeryToken()
            <button type="submit" class="bp-secondary-button bp-button-accent">Reset battery family passports</button>
        </form>
    </section>

    <section class="bp-card bp-admin-help-hero">
        <div class="bp-admin-help-hero-copy">
            <span class="bp-summary-title">Admin workflow help</span>
            <h1>Create, validate, sign, publish, and recover clean trust state</h1>
            <p class="mb-0">
                Use this page when you need the practical workflow: create the battery ID from a battery family, fill the battery-specific facts,
                validate the passport, sign the canonical core, publish it, and recover after edits.
            </p>
            <div class="bp-admin-help-actions">
                <a href="/admin/passports/new" class="bp-primary-button">Create battery ID</a>
                <a href="/admin/clusters?tab=products" class="bp-secondary-button">Open battery families</a>
                <a href="/admin/clusters?tab=passports" class="bp-secondary-button">Open passports</a>
            </div>
        </div>
        <aside class="bp-admin-help-hero-panel" aria-label="Trust gate">
            <span class="bp-summary-title">Trust gate</span>
            <h2>Ready means all three pass</h2>
            <div class="bp-admin-help-trust-chip"><strong>Validated</strong><small>Zero blocking errors</small></div>
            <div class="bp-admin-help-trust-chip"><strong>Signed</strong><small>Current core has proof</small></div>
            <div class="bp-admin-help-trust-chip"><strong>Published</strong><small>Clean proof is public</small></div>
        </aside>
    </section>

    <section class="bp-admin-help-task-strip" aria-label="Need to act now?">
        <div class="bp-admin-help-task-intro">
            <span class="bp-summary-title">Need to act now?</span>
            <h2>Jump straight to the admin surface you need</h2>
        </div>
        <a class="bp-admin-help-task-card" href="/admin/passports/new"><span>Create</span><strong>New battery ID</strong><small>Start a draft passport.</small></a>
        <a class="bp-admin-help-task-card" href="/admin/clusters?tab=products"><span>Define</span><strong>Battery families</strong><small>Edit battery versions, software parameters, and required fields.</small></a>
        <a class="bp-admin-help-task-card" href="/admin/clusters?tab=local-editable-fields"><span>Delegate</span><strong>Local editable fields</strong><small>Choose what local admins can edit globally.</small></a>
        <a class="bp-admin-help-task-card" href="/admin/clusters?tab=api-token-management"><span>Integrate</span><strong>API Token Management</strong><small>Manage API tokens and battery secrets.</small></a>
        <a class="bp-admin-help-task-card" href="/admin/clusters?tab=passports"><span>Manage</span><strong>Passport workspace</strong><small>Open drafts, signed, dirty, and published records.</small></a>
        <a class="bp-admin-help-task-card" href="#workflow-steps"><span>Learn</span><strong>Step-by-step flow</strong><small>Validate, sign, publish, and recover clean state.</small></a>
    </section>

    <section class="bp-admin-help-overview" aria-label="Admin workflow map">
        <nav class="bp-card bp-admin-help-quicknav" aria-label="Admin help sections">
            <span class="bp-summary-title">Page map</span>
            <strong>Find the exact admin task</strong>
            <a href="#target-state">Target state</a>
            <a href="#workflow-steps">Workflow steps</a>
            <a href="#status-dictionary">Status dictionary</a>
            <a href="#ready-checklist">Ready checklist</a>
        </nav>
        <div class="bp-admin-help-lifecycle" aria-label="Battery passport lifecycle">
            <article><span>01</span><strong>Draft</strong><small>Create the DID and save incomplete admin data safely.</small></article>
            <article><span>02</span><strong>Validate</strong><small>Run schema, business-rule, and completion-policy checks.</small></article>
            <article><span>03</span><strong>Sign</strong><small>Hash and sign the canonical passport core.</small></article>
            <article><span>04</span><strong>Publish</strong><small>Expose only a clean passport with a current proof.</small></article>
            <article><span>05</span><strong>Recover</strong><small>After edits, validate and sign again to leave dirty state.</small></article>
        </div>
    </section>

    <section id="target-state" class="bp-admin-help-grid">
        <article class="bp-card bp-admin-help-callout">
            <span class="bp-summary-title">The target state</span>
            <h2>How the battery needs to be</h2>
            <p>A battery passport is ready when it is validated, signed, clean, and published with the current passport core still matching its proof.</p>
            <ul>
                <li><strong>Validated:</strong> the latest validation has zero blocking validation errors.</li>
                <li><strong>Signed:</strong> the current canonical passport core has a signature proof.</li>
                <li><strong>Clean:</strong> the current data still matches the latest signed hash.</li>
                <li><strong>Published:</strong> the registry status is public and publish uses a current valid signature proof.</li>
            </ul>
        </article>
        <article class="bp-card bp-admin-help-callout is-warning">
            <span class="bp-summary-title">Dirty state rule</span>
            <h2>What makes trust dirty?</h2>
            <p>Editing saved passport core data after signing makes the passport dirty because the signed hash no longer represents the current content.</p>
            <p class="mb-0">HTTP telemetry does not make the passport dirty. API software updates also do not dirty the passport because live operational requests are outside the signed canonical passport core.</p>
        </article>
        <article class="bp-card bp-admin-help-callout">
            <span class="bp-summary-title">Public discovery</span>
            <h2>What users can find</h2>
            <p>Public search, registry discovery, and direct public passport URLs expose only passports that are published, signed, clean, and verifiable.</p>
            <p class="mb-0">Draft, dirty, unsigned, or unpublished passports stay visible to admins so they can finish the workflow.</p>
        </article>
        <article class="bp-card bp-admin-help-callout bp-admin-help-policy-link">
            <span class="bp-summary-title">Completion policy</span>
            <h2>Who decides required data?</h2>
            <p>The <strong>Battery families tab</strong> controls required/optional switches per battery version. The settings are saved in MongoDB and used by batteries linked to that battery version.</p>
            <p class="mb-0">Validation, signing, publishing, edit guidance, and conformance checklists read the saved product policy and product-version policy.</p>
            <a href="/admin/clusters?tab=products" class="bp-secondary-button bp-button-compact mt-3">Open battery families</a>
        </article>
    </section>

    <section id="workflow-steps" class="bp-card">
        <div class="bp-admin-help-section-heading">
            <span class="bp-summary-title">Main workflow</span>
            <h2>Step by step</h2>
            <p>Follow the first checklist for a new passport. Use dirty recovery after any signed core data changes.</p>
        </div>
        <div class="bp-admin-help-split-checklists">
            <article class="bp-admin-help-check-card">
                <span class="bp-summary-title">First-time passport checklist</span>
                <h4>Create a trusted passport from scratch</h4>
                <ol>
                    <li>Create battery ID, choose Battery Family and Battery version, and save the draft.</li>
                    <li>Review the copied battery family data and fill battery-specific information in every admin section.</li>
                    <li>Open <a href="/admin/clusters?tab=products">battery families</a> to confirm required and optional fields for that battery family.</li>
                    <li>Validate passport and resolve every blocking field.</li>
                    <li>Sign passport when blockers are zero.</li>
                    <li>Publish passport when the page says publishing is ready.</li>
                </ol>
            </article>
            <article class="bp-admin-help-check-card">
                <span class="bp-summary-title">Dirty recovery checklist</span>
                <h4>Return edited data to clean trust</h4>
                <ol>
                    <li>Save the admin edit. Draft save is always allowed.</li>
                    <li>Open conformance and confirm the passport is dirty or not publishable.</li>
                    <li>Validate passport again.</li>
                    <li>Fix every blocking issue.</li>
                    <li>Sign passport again so the latest core has a new proof.</li>
                    <li>Publish passport again when the latest proof is current.</li>
                </ol>
            </article>
            <article class="bp-admin-help-check-card">
                <span class="bp-summary-title">Document evidence</span>
                <h4>How supporting files become trusted</h4>
                <ol>
                    <li>Open the passport edit page and upload or replace the required supporting document.</li>
                    <li>The app stores the document hash and marks the passport dirty because the signed evidence changed.</li>
                    <li>Open Trust &amp; conformance and review Evidence readiness.</li>
                    <li>Validate the passport. Missing required evidence must be fixed before signing.</li>
                    <li>Sign again so the current document hash is captured in a new immutable revision.</li>
                    <li>Publish after the signature is clean and current.</li>
                </ol>
                <p>External links can describe evidence, but uploaded files with document hash values are what the app can verify against a signed revision.</p>
            </article>
            <article class="bp-admin-help-check-card">
                <span class="bp-summary-title">Battery version push</span>
                <h4>Update matching batteries safely</h4>
                <ol>
                    <li>Open battery families and edit shared battery version data or software release date and latest update values.</li>
                    <li>Save the battery family to MongoDB.</li>
                    <li>Use the battery version push when saved shared version data changes.</li>
                    <li>The app updates fields that still match the previous template baseline.</li>
                    <li>Manual battery overrides are preserved and reported as skipped paths.</li>
                    <li>Updated batteries become dirty until validation, signing, and publishing are repeated.</li>
                </ol>
            </article>
            <article class="bp-admin-help-check-card">
                <span class="bp-summary-title">Software display and API updates</span>
                <h4>Know where software data appears</h4>
                <ol>
                    <li>New passports copy battery version plus software version, release date, and latest update values from the selected battery family.</li>
                    <li>The public summary shows the current software version as a normal battery fact.</li>
                    <li>The Detailed report Software tab shows product, product ID, software version, release date, and latest update.</li>
                    <li>API software updates do not dirty the passport because they update current operational software in <code>app.operations</code>.</li>
                    <li>If a current API software value exists, the summary and detail pages show it before the signed product baseline.</li>
                </ol>
            </article>
            <article class="bp-admin-help-check-card">
                <span class="bp-summary-title">API Token Management</span>
                <h4>Credentials for external systems</h4>
                <ol>
                    <li>Open API Token Management to create or regenerate external API tokens.</li>
                    <li>The generated Token Value is the secret credential used in the Authorization header and is shown only at create/regenerate time.</li>
                    <li>Cluster scope on each token controls which batteries the external system can read, write, validate, or sign.</li>
                </ol>
            </article>
            <article class="bp-admin-help-check-card">
                <span class="bp-summary-title">Local editable fields</span>
                <h4>Global local-admin edit policy</h4>
                <ol>
                    <li>Open Local editable fields from the admin tabs.</li>
                    <li>Select the passport fields local admins may edit across all batteries.</li>
                    <li>The saved MongoDB policy controls both what the cluster-admin edit form renders and what its save action accepts.</li>
                </ol>
            </article>
        </div>
        <div class="bp-admin-help-split-checklists">
            <article class="bp-admin-help-check-card">
                <span class="bp-summary-title">What public users can see</span>
                <p>Public search and QR lookup show published passports. The summary page stays focused on battery facts and does not expose internal validation or conformance diagnostics.</p>
            </article>
            <article class="bp-admin-help-check-card">
                <span class="bp-summary-title">What admins can see</span>
                <p>General admins and local cluster admins for the battery's cluster can open privileged Trust &amp; conformance evidence, audit history, revision history, proof hashes, and blocker diagnostics.</p>
            </article>
        </div>
        <div class="bp-admin-help-required-grid">
            <div>
                <h4>Required data</h4>
                <ul>
                    <li>Identity, manufacturer, Battery Family, Battery version, software version, mass, Battery status, Passport status, manufacturing date, and facility details.</li>
                    <li>Material composition, recycled-content, performance, durability, carbon footprint, labels, certificates, circularity, and due-diligence references marked required in policy.</li>
                </ul>
            </div>
            <div>
                <h4>Optional data</h4>
                <ul>
                    <li>Any parameter switched off in the battery family required/optional policy.</li>
                    <li>Display image, optional documents, and live operational HTTP request data unless policy says otherwise.</li>
                </ul>
            </div>
        </div>
        <ol class="bp-admin-help-steps">
            <li class="bp-admin-help-step-card"><div class="bp-admin-help-step-number">1</div><div class="bp-admin-help-step-copy"><h3>Create battery ID</h3><p>Create the DID, choose Battery Family and Battery version, and save the draft copied from the template.</p></div></li>
            <li class="bp-admin-help-step-card"><div class="bp-admin-help-step-number">2</div><div class="bp-admin-help-step-copy"><h3>Fill battery information</h3><p>The edit form marks fields as Required or Optional from the product's saved MongoDB policy.</p></div></li>
            <li class="bp-admin-help-step-card"><div class="bp-admin-help-step-number">3</div><div class="bp-admin-help-step-copy"><h3>Validate passport</h3><p>Validation checks official schemas, business rules, and completion policy. Signing appears only when blockers are zero.</p></div></li>
            <li class="bp-admin-help-step-card"><div class="bp-admin-help-step-number">4</div><div class="bp-admin-help-step-copy"><h3>Sign passport</h3><p>Signing canonicalizes the passport core, creates a hash, stores proof metadata, and records an immutable signed revision.</p></div></li>
            <li class="bp-admin-help-step-card"><div class="bp-admin-help-step-number">5</div><div class="bp-admin-help-step-copy"><h3>Publish passport</h3><p>Publishing requires a current valid signature proof and makes the passport publicly searchable.</p><p>The <strong>Trust &amp; conformance tab is visible only</strong> to general admins or local cluster admins for the battery's cluster.</p></div></li>
            <li class="bp-admin-help-step-card"><div class="bp-admin-help-step-number">6</div><div class="bp-admin-help-step-copy"><h3>Edit after publishing</h3><p>Editing signed core data makes the passport Dirty until it is validated and signed again.</p></div></li>
            <li class="bp-admin-help-step-card"><div class="bp-admin-help-step-number">7</div><div class="bp-admin-help-step-copy"><h3>Move from dirty back to clean</h3><p>Validate, fix blockers, sign again, and publish the newest signed revision.</p></div></li>
        </ol>
    </section>

    <section id="status-dictionary" class="bp-card">
        <div class="bp-admin-help-section-heading"><span class="bp-summary-title">Status dictionary</span><h2>What each state means</h2><p>Use these terms when deciding whether a battery is ready for a customer or regulator to inspect.</p></div>
        <div class="bp-admin-help-state-grid">
            <article><h3>Draft</h3><p>Editable admin data. Draft can be incomplete and unsigned.</p></article>
            <article><h3>Validated</h3><p>The latest validation completed with zero blockers. Validation alone is not a signature.</p></article>
            <article><h3>Signed</h3><p>The canonical passport core has a hash and proof metadata.</p></article>
            <article><h3>Clean</h3><p>The current passport core still matches the latest signed hash.</p></article>
            <article><h3>Dirty</h3><p>The passport core changed after signing. Validate and sign again.</p></article>
            <article><h3>Published</h3><p>The passport is public and should have a current valid signature proof.</p></article>
        </div>
    </section>

    <section id="ready-checklist" class="bp-card bp-admin-help-checklist">
        <div><span class="bp-summary-title">Quick checklist</span><h2>Before you say this battery is ready</h2></div>
        <ul>
            <li>The admin form required fields are complete.</li>
            <li>The conformance page shows zero blocking validation errors.</li>
            <li>The passport has been signed after the latest data change.</li>
            <li>The trust state is Clean, not Dirty.</li>
            <li>The publish gate says publishing is allowed.</li>
            <li>The detailed report shows proof information to authorized admins only.</li>
        </ul>
    </section>
</main>
