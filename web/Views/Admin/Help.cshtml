@{
    ViewData["Title"] = "Admin workflow help";
    var statusMessage = ViewData["StatusMessage"] as string ?? string.Empty;
    var errorMessage = ViewData["ErrorMessage"] as string ?? string.Empty;
}

<main class="bp-page bp-admin-page bp-admin-help-page">
    <header class="bp-console-header">
        <div>
            <h1>Administration</h1>
            <p class="text-secondary mb-0">Create, validate, sign, publish, and recover clean trust state.</p>
        </div>
    </header>

    @await Html.PartialAsync("_AdminTabs", "help")

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="bp-alert bp-alert-success">@statusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="bp-alert bp-alert-danger">@errorMessage</div>
    }

    <section class="bp-card bp-admin-help-reference-console" aria-label="Admin workflow help">
        <div class="bp-admin-help-reference-toolbar">
            <div class="bp-admin-help-reference-copy">
                <span class="bp-summary-title">Admin workflow help</span>
                <h2>Guide each battery from draft to public proof.</h2>
                <p>Use the table as the operating map. Each row has one detail action so the page stays compact while still covering multi-step trust work.</p>
            </div>
            <nav class="bp-admin-help-anchor-tabs" aria-label="Admin help sections">
                <a href="#target-state">Target state</a>
                <a href="#workflow-steps">Workflow steps</a>
                <a href="#status-dictionary">Status dictionary</a>
                <a href="#ready-checklist">Ready checklist</a>
            </nav>
            <nav class="bp-admin-help-primary-actions" aria-label="Primary admin actions">
                <a href="/admin/passports/new" class="bp-primary-button">Create battery ID</a>
                <a href="/admin/clusters?tab=products" class="bp-secondary-button">Open battery families</a>
                <a href="/admin/clusters?tab=batteries" class="bp-secondary-button">Open batteries</a>
            </nav>
        </div>

        <div class="bp-table-scroll">
                <table id="workflow-steps" class="table bp-console-table bp-admin-help-workflow-table bp-mobile-card-table">
                <thead>
                    <tr>
                        <th>Workflow</th>
                        <th>When to use</th>
                        <th>Admin surface</th>
                        <th>Success signal</th>
                        <th class="bp-action-cell">Details</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Create battery ID</strong><small>Start a draft passport.</small></span></td>
                        <td>New battery or new demonstrator record.</td>
                        <td><a href="/admin/passports/new">New battery ID</a></td>
                        <td>Draft saved with Battery Family and Battery Model.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-create" aria-expanded="false" aria-controls="admin-detail-create" aria-label="Show create battery ID details" title="Show create battery ID details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Fill battery information</strong><small>Complete required passport data.</small></span></td>
                        <td>Draft exists and needs battery-specific values.</td>
                        <td><a href="/admin/clusters?tab=batteries">Batteries</a></td>
                        <td>Required fields are complete for the saved product policy.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-fill" aria-expanded="false" aria-controls="admin-detail-fill" aria-label="Show fill battery information details" title="Show fill battery information details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Validate passport</strong><small>Run schema and policy checks.</small></span></td>
                        <td>Before signing, after edits, or after evidence changes.</td>
                        <td>Trust &amp; conformance</td>
                        <td>Zero blocking validation errors.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-validate" aria-expanded="false" aria-controls="admin-detail-validate" aria-label="Show validate passport details" title="Show validate passport details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Sign passport</strong><small>Create the current proof.</small></span></td>
                        <td>Validation has no blockers.</td>
                        <td>Trust &amp; conformance</td>
                        <td>Canonical passport core has a signature proof.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-sign" aria-expanded="false" aria-controls="admin-detail-sign" aria-label="Show sign passport details" title="Show sign passport details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Publish passport</strong><small>Expose the trusted passport.</small></span></td>
                        <td>Proof is current and clean.</td>
                        <td>Trust &amp; conformance</td>
                        <td>Public registry shows a published, signed, clean, and verifiable passport.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-publish" aria-expanded="false" aria-controls="admin-detail-publish" aria-label="Show publish passport details" title="Show publish passport details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Edit after publishing</strong><small>Signed core data changed.</small></span></td>
                        <td>A signed passport was edited or evidence changed.</td>
                        <td>Edit passport and Trust &amp; conformance</td>
                        <td>Dirty state is understood and recovery starts.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-dirty" aria-expanded="false" aria-controls="admin-detail-dirty" aria-label="Show edit after publishing details" title="Show edit after publishing details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Move from dirty back to clean</strong><small>Recover trust after edits.</small></span></td>
                        <td>Passport is Dirty, unsigned for current data, or not publishable.</td>
                        <td>Trust &amp; conformance</td>
                        <td>Validate, fix blockers, sign again, and publish the newest signed revision.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-recover" aria-expanded="false" aria-controls="admin-detail-recover" aria-label="Show dirty recovery details" title="Show dirty recovery details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Battery Model push</strong><small>Apply shared model updates.</small></span></td>
                        <td>Battery Family model data or software parameters changed.</td>
                        <td><a href="/admin/clusters?tab=products">Battery families</a></td>
                        <td>Matching batteries update, overrides are preserved, changed passports become dirty.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-model-push" aria-expanded="false" aria-controls="admin-detail-model-push" aria-label="Show Battery Model push details" title="Show Battery Model push details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>API Token Management</strong><small>External credentials and signing.</small></span></td>
                        <td>An integration needs read, write, validate, sign, or publish access.</td>
                        <td><a href="/admin/clusters?tab=api-token-management">API Token Management</a></td>
                        <td>Token Value is captured by the external system and scope is correct.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-tokens" aria-expanded="false" aria-controls="admin-detail-tokens" aria-label="Show API token management details" title="Show API token management details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr>
                        <td><span class="bp-admin-help-workflow-name"><strong>Local editable fields</strong><small>Global local-admin policy.</small></span></td>
                        <td>Cluster admins need a controlled edit surface.</td>
                        <td><a href="/admin/clusters?tab=local-editable-fields">Local editable fields</a></td>
                        <td>MongoDB policy controls what local admins can render and save.</td>
                        <td class="bp-action-cell"><button type="button" class="bp-action-button bp-admin-help-detail-toggle" data-admin-help-detail-target="admin-detail-local-fields" aria-expanded="false" aria-controls="admin-detail-local-fields" aria-label="Show local editable fields details" title="Show local editable fields details" data-tooltip="Details"><svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></td>
                    </tr>
                    <tr class="bp-admin-help-detail-row" data-admin-help-detail-row hidden>
                        <td colspan="5">
                            <div class="bp-admin-help-selected-panel" aria-live="polite" tabindex="-1" hidden>
            <article id="admin-detail-create" class="bp-admin-help-detail-panel" data-admin-help-detail-panel>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">First-time passport checklist</span><h3>Create a trusted passport from scratch</h3><p>Create battery ID, choose Battery Family and Battery Model, and save the draft copied from the template.</p></div>
                <ol class="bp-admin-help-detail-list">
                    <li>Review copied battery family data and fill battery-specific information in every admin section.</li>
                    <li>Open <a href="/admin/clusters?tab=products">battery families</a> to confirm required and optional fields for that battery family.</li>
                    <li>Validate passport, resolve every blocker, sign when blockers are zero, then publish when the gate says publishing is ready.</li>
                </ol>
            </article>
            <article id="admin-detail-fill" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Required data</span><h3>Fill the fields policy expects.</h3><p>The edit form marks fields as Required or Optional from the product's saved MongoDB policy.</p></div>
                <div class="bp-admin-help-detail-grid">
                    <section class="bp-admin-help-detail-card"><h4>Required data</h4><p>Identity, manufacturer, Battery Family, Battery Model, software version, mass, Battery status, Passport status, manufacturing date, facility details, material composition, performance, labels, certificates, circularity, and due-diligence references marked required in policy.</p></section>
                    <section class="bp-admin-help-detail-card"><h4>Optional data</h4><p>Any parameter switched off in the battery family required/optional policy, optional documents, display image, and live operational HTTP request data unless policy says otherwise.</p></section>
                </div>
            </article>
            <article id="admin-detail-validate" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Validation</span><h3>Run the gate before signing.</h3><p>Validation checks official schemas, business rules, completion policy, and evidence readiness. Signing appears only when blockers are zero.</p></div>
                <div class="bp-admin-help-detail-grid">
                    <section class="bp-admin-help-detail-card">
                        <h4>Validation steps</h4>
                        <ol class="bp-admin-help-detail-list"><li>Open Trust &amp; conformance.</li><li>Run validation.</li><li>Fix every blocking issue before signing.</li></ol>
                    </section>
                    <section class="bp-admin-help-detail-card">
                        <h4>Document evidence</h4>
                        <p>Upload or replace supporting files from the passport edit page. The app stores the document hash and marks signed evidence as changed, so the Evidence readiness check must pass before you sign again.</p>
                    </section>
                </div>
            </article>
            <article id="admin-detail-sign" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Signing</span><h3>Create the current proof.</h3><p>Signing canonicalizes the passport core, creates a hash, stores proof metadata, and records an immutable signed revision.</p></div>
            </article>
            <article id="admin-detail-publish" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Publishing</span><h3>Make the clean proof public.</h3><p>Publishing requires a current valid signature proof and makes the passport publicly searchable. The <strong>Trust &amp; conformance tab is visible only</strong> to general admins or local cluster admins for the battery's cluster.</p></div>
            </article>
            <article id="admin-detail-dirty" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Dirty state rule</span><h3>Know what changed trust.</h3><p>Editing saved passport core data after signing makes the passport Dirty because the signed hash no longer represents the current content. HTTP telemetry does not make the passport dirty.</p></div>
            </article>
            <article id="admin-detail-recover" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Dirty recovery checklist</span><h3>Return edited data to clean trust</h3><p>Use this after any signed core data changes.</p></div>
                <ol class="bp-admin-help-detail-list"><li>Save the admin edit. Draft save is always allowed.</li><li>Open conformance and confirm the passport is dirty or not publishable.</li><li>Validate passport again, fix blockers, sign again, then publish again when the latest proof is current.</li></ol>
            </article>
            <article id="admin-detail-model-push" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Battery Model push</span><h3>Update matching batteries safely</h3><p>Open battery families and edit shared Battery Model data or software release date and latest update values. The app updates fields that still match the previous template baseline while preserving manual battery overrides.</p></div>
                <div class="bp-admin-help-detail-grid">
                    <section class="bp-admin-help-detail-card"><h4>Software parameters</h4><p>New passports copy Battery Model plus software version, release date, and latest update values from the selected battery family. The public summary and Detailed report General tab show these software parameters.</p></section>
                    <section class="bp-admin-help-detail-card"><h4>Battery Model API changes</h4><p>Battery Model and software API changes require a new passport snapshot when the values differ from the latest passport. The software-version endpoint copies release date and latest update values from the selected Battery Model. Telemetry remains operational and does not require signing.</p></section>
                </div>
            </article>
            <article id="admin-detail-tokens" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">External systems</span><h3>Use scoped credentials.</h3><p>Open API Token Management to create or regenerate external API tokens. The generated Token Value is the secret credential used in the Authorization header and is shown only at create/regenerate time.</p></div>
                <p>Cluster scope on each token controls which batteries the external system can read, write, validate, sign, or publish.</p>
            </article>
            <article id="admin-detail-local-fields" class="bp-admin-help-detail-panel" data-admin-help-detail-panel hidden>
                <div class="bp-admin-help-detail-copy"><span class="bp-summary-title">Local editable fields</span><h3>Keep local edit access narrow.</h3><p>Select the passport fields local admins may edit across all batteries. The saved MongoDB policy controls both what the cluster-admin edit form renders and what its save action accepts.</p></div>
            </article>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section id="target-state" class="bp-card bp-admin-help-status-console">
        <div class="bp-admin-help-section-heading">
            <span class="bp-summary-title">The target state</span>
            <h2>How the battery needs to be</h2>
            <p>A battery passport is ready when it is validated, signed, clean, and published with the current passport core still matching its proof.</p>
        </div>
        <div class="bp-admin-help-policy-note">
            <strong>Completion policy</strong>
            <span>The <strong>Battery families tab</strong> controls required/optional switches per Battery Model. Validation, signing, publishing, edit guidance, and conformance checklists read the saved product policy and product-version policy.</span>
            <a href="/admin/clusters?tab=products" class="bp-secondary-button bp-button-compact">Open battery families</a>
        </div>
        <section id="status-dictionary" aria-label="Status dictionary">
            <div class="bp-table-scroll">
                <table class="table bp-console-table bp-admin-help-status-table bp-mobile-card-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Meaning</th>
                            <th>Admin action</th>
                        </tr>
                    </thead>
                    <tbody>
                    <tr><td data-label="Status"><strong>Draft</strong></td><td data-label="Meaning">Editable admin data. Draft can be incomplete and unsigned.</td><td data-label="Admin action">Fill required data.</td></tr>
                    <tr><td data-label="Status"><strong>Validated</strong></td><td data-label="Meaning">The latest validation completed with zero blocking validation errors. Validation alone is not a signature.</td><td data-label="Admin action">Sign next.</td></tr>
                    <tr><td data-label="Status"><strong>Signed</strong></td><td data-label="Meaning">The canonical passport core has a hash and proof metadata.</td><td data-label="Admin action">Publish if proof is current.</td></tr>
                    <tr><td data-label="Status"><strong>Clean</strong></td><td data-label="Meaning">The current passport core still matches the latest signed hash.</td><td data-label="Admin action">Keep or publish.</td></tr>
                    <tr><td data-label="Status"><strong>Dirty</strong></td><td data-label="Meaning">The passport core changed after signing. Validate and sign again.</td><td data-label="Admin action">Use dirty recovery.</td></tr>
                    <tr><td data-label="Status"><strong>Published</strong></td><td data-label="Meaning">The passport is public and should have a current valid signature proof.</td><td data-label="Admin action">Monitor edits.</td></tr>
                    <tr><td data-label="Status"><strong>Public discovery</strong></td><td data-label="Meaning">Public search, registry discovery, and direct public passport URLs expose only passports that are published, signed, clean, and verifiable.</td><td data-label="Admin action">Keep proof current.</td></tr>
                    <tr><td data-label="Status"><strong>Admin discovery</strong></td><td data-label="Meaning">Draft, dirty, unsigned, or unpublished passports stay visible to admins so they can finish the workflow.</td><td data-label="Admin action">Finish trust workflow.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </section>

    <section id="ready-checklist" class="bp-card bp-admin-help-ready-console">
        <div class="bp-admin-help-section-heading"><span class="bp-summary-title">Quick checklist</span><h2>Before you say this battery is ready</h2></div>
        <div class="bp-admin-help-detail-grid">
            <section class="bp-admin-help-detail-card">
                <span class="bp-summary-title">What public users can see</span>
                <p>Public search and QR lookup show published passports. The summary page stays focused on battery facts and does not expose internal validation or conformance diagnostics.</p>
            </section>
            <section class="bp-admin-help-detail-card">
                <span class="bp-summary-title">What admins can see</span>
                <p>General admins and local cluster admins for the battery's cluster can open privileged Trust &amp; conformance evidence, audit history, revision history, proof hashes, and blocker diagnostics.</p>
            </section>
        </div>
        <ul class="bp-admin-help-ready-list">
            <li>The admin form required fields are complete.</li>
            <li>The conformance page shows zero blocking validation errors.</li>
            <li>The passport has been signed after the latest data change.</li>
            <li>The trust state is Clean, not Dirty.</li>
            <li>The publish gate says publishing is allowed.</li>
            <li>The detailed report shows proof information to authorized admins only.</li>
        </ul>
    </section>

    <details class="bp-card bp-admin-help-demo-reset bp-admin-help-maintenance-reset" id="maintenance-reset">
        <summary>
            <span class="bp-summary-title">Maintenance</span>
            <strong>Battery family reset</strong>
            <small>Restore one unassigned demonstrator plus six clustered customer batteries.</small>
        </summary>
        <div class="bp-admin-help-maintenance-body">
            <p>This guarded reset recreates Compact 7M, Compact 13M, and Core battery families with Battery Models, software parameters, evidence files, clusters, users, and passport records.</p>
            <form method="post" action="/admin/product-templates/reset">
                @Html.AntiForgeryToken()
                <button type="submit" class="bp-secondary-button bp-button-accent">Reset battery-family passports</button>
            </form>
        </div>
    </details>
</main>

@section Scripts {
    <script>
        (() => {
            const buttons = Array.from(document.querySelectorAll('[data-admin-help-detail-target]'));
            const panels = Array.from(document.querySelectorAll('[data-admin-help-detail-panel]'));
            const detailRegion = document.querySelector('.bp-admin-help-selected-panel');
            const detailRow = document.querySelector('[data-admin-help-detail-row]');
            const activatePanel = (targetId, shouldOpen) => {
                panels.forEach(panel => {
                    panel.hidden = panel.id !== targetId || !shouldOpen;
                });
                buttons.forEach(button => {
                    const isActive = shouldOpen && button.getAttribute('data-admin-help-detail-target') === targetId;
                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('aria-expanded', isActive ? 'true' : 'false');
                });
                if (detailRegion) {
                    detailRegion.hidden = !shouldOpen;
                }
                if (detailRow) {
                    detailRow.hidden = !shouldOpen;
                }
            };

            buttons.forEach(button => {
                button.addEventListener('click', () => {
                    const targetId = button.getAttribute('data-admin-help-detail-target');
                    const targetPanel = targetId ? document.getElementById(targetId) : null;
                    const hostRow = button.closest('tr');
                    const isSameVisible = Boolean(targetPanel && detailRow && !targetPanel.hidden && !detailRow.hidden);
                    if (targetId) {
                        if (hostRow && detailRow && hostRow.parentNode) {
                            hostRow.parentNode.insertBefore(detailRow, hostRow.nextSibling);
                        }
                        activatePanel(targetId, !isSameVisible);
                        if (!isSameVisible && detailRegion) {
                            detailRegion.focus({ preventScroll: true });
                        }
                    }
                });
            });
        })();
    </script>
}
