@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@model BatteryPassWeb.Models.ViewModels.ApplicationAuditLogViewModel
@{
    ViewData["Title"] = "Application audit log";
    var filter = Model.Filter;
    var moreFilters = !string.IsNullOrWhiteSpace(filter.Category) || !string.IsNullOrWhiteSpace(filter.Source);
    var lineCount = Model.Days.Sum(day => day.Lines.Count);

    // "Show 50 more" keeps the filters and asks for 50 more events.
    var query = Context.Request.Query
        .Where(entry => entry.Key != "show")
        .Select(entry => $"{Uri.EscapeDataString(entry.Key)}={Uri.EscapeDataString(entry.Value.ToString())}")
        .Append($"show={Model.Show + 50}");
    var moreHref = $"/admin/audit?{string.Join("&", query)}";
}

<main class="bp-page bp-admin-page bp-audit-log">
    <link rel="stylesheet" href="~/css/bp-product-data.css" asp-append-version="true" />
    <div>
        <h1 class="mb-1">Administration</h1>
        <p class="text-secondary mb-0">Manage battery families, sites and operators, batteries, cluster assignments, registered clusters, user memberships, credentials, and audit history.</p>
    </div>

    @await Html.PartialAsync("_AdminTabs", "audit")

    <svg width="0" height="0" class="position-absolute" aria-hidden="true" focusable="false">
        <symbol id="audit-i-edit" viewBox="0 0 16 16"><path d="M10.5 2.5l3 3L6 13H3v-3z" /></symbol>
        <symbol id="audit-i-add" viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" /></symbol>
        <symbol id="audit-i-remove" viewBox="0 0 16 16"><path d="M3 8h10" /></symbol>
        <symbol id="audit-i-upload" viewBox="0 0 16 16"><path d="M8 11V3M4.5 6.5L8 3l3.5 3.5M3 13h10" /></symbol>
        <symbol id="audit-i-publish" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" /></symbol>
        <symbol id="audit-i-lock" viewBox="0 0 16 16"><path d="M4 7h8v6H4zM6 7V5a2 2 0 014 0v2" /></symbol>
        <symbol id="audit-i-key" viewBox="0 0 16 16"><circle cx="5.5" cy="10.5" r="2.5" /><path d="M7.5 8.5L13 3M11 5l1.5 1.5" /></symbol>
        <symbol id="audit-i-image" viewBox="0 0 16 16"><path d="M2.5 3.5h11v9h-11zM2.5 10.5l3-3 3 3 2-2 3 3" /></symbol>
        <symbol id="audit-i-alert" viewBox="0 0 16 16"><path d="M8 4v5M8 11.5v.5" /></symbol>
        <symbol id="audit-i-other" viewBox="0 0 16 16"><circle cx="8" cy="8" r="1.6" /></symbol>
        <symbol id="audit-i-chevron" viewBox="0 0 12 12"><path d="M4.5 2.5L8 6l-3.5 3.5" /></symbol>
    </svg>

    <section class="bp-card bp-console-form-card bp-product-editor-section mt-4">
        <form method="get" class="bp-auditlog-filters">
            <label class="bp-auditlog-search">
                <span>Search</span>
                <input type="search" name="q" value="@filter.Search" placeholder="A name, value, person or ID" />
            </label>
            <label>
                <span>Record</span>
                <select name="entityType">
                    @Option("", "Everything", filter.EntityType)
                    @Option("dpp-family", "Battery families", filter.EntityType)
                    @Option("dpp-model", "Battery models", filter.EntityType)
                    @Option("dpp-batch", "Batches", filter.EntityType)
                    @Option("dpp-site", "Manufacturing sites", filter.EntityType)
                    @Option("dpp-operator", "Economic operators", filter.EntityType)
                    @Option("dpp-pack", "Batteries", filter.EntityType)
                    @Option("dpp-document", "Documents", filter.EntityType)
                    @Option("cluster", "Clusters", filter.EntityType)
                    @Option("apiToken", "API tokens", filter.EntityType)
                    @Option("account", "Accounts", filter.EntityType)
                    @Option("passport", "Old passports", filter.EntityType)
                    @Option("battery", "Old batteries", filter.EntityType)
                </select>
            </label>
            <label>
                <span>Who</span>
                <input type="text" name="actor" value="@filter.Actor" placeholder="Email or token name" />
            </label>
            <label>
                <span>From</span>
                <input type="date" name="from" value="@filter.From" />
            </label>
            <label>
                <span>To</span>
                <input type="date" name="to" value="@filter.To" />
            </label>
            <div class="bp-auditlog-filter-actions">
                <button type="submit" class="bp-primary-button">Show</button>
                <a href="/admin/audit" class="bp-secondary-button">Reset</a>
            </div>
            <details class="bp-auditlog-more" open="@moreFilters">
                <summary>More filters</summary>
                <div>
                    <label>
                        <span>Kind of event</span>
                        <select name="category">
                            @Option("", "All", filter.Category)
                            @Option("dpp", "Product data and passports", filter.Category)
                            @Option("security", "Sign-ins, accounts and tokens", filter.Category)
                            @Option("admin", "Clusters and other admin", filter.Category)
                            @Option("passport", "Old passports", filter.Category)
                            @Option("battery", "Old batteries", filter.Category)
                            @Option("file", "Old passport files", filter.Category)
                        </select>
                    </label>
                    <label>
                        <span>Came from</span>
                        <select name="source">
                            @Option("", "Anywhere", filter.Source)
                            @Option("form", "The team's pages", filter.Source)
                            @Option("documents", "Document uploads and downloads", filter.Source)
                            @Option("publication", "Publishing", filter.Source)
                            @Option("external-api", "The API", filter.Source)
                            @Option("admin-ui", "The admin pages", filter.Source)
                        </select>
                    </label>
                </div>
            </details>
        </form>
    </section>

    <section class="bp-card bp-console-form-card bp-product-editor-section mt-4">
        <div class="bp-auditlog-head">
            <h2>What happened</h2>
            <p>@(lineCount == 0 ? "No events match these filters." : Model.HasMore ? $"The latest {lineCount} events" : $"{lineCount} event{(lineCount == 1 ? string.Empty : "s")}")</p>
        </div>

        @foreach (var day in Model.Days)
        {
            <h3 class="bp-auditlog-day">@day.Title</h3>
            <div class="bp-auditlog-list">
                @foreach (var line in day.Lines)
                {
                    @await Html.PartialAsync("_AuditLine", line, new ViewDataDictionary(ViewData) { ["Zone"] = Model.Zone })
                }
            </div>
        }

        @if (Model.HasMore)
        {
            <div class="bp-auditlog-more-events">
                <a class="bp-secondary-button" href="@moreHref">Show 50 more</a>
            </div>
        }
    </section>
</main>

@functions {
    private IHtmlContent Option(string value, string label, string selectedValue)
    {
        var selected = value.Equals(selectedValue, StringComparison.OrdinalIgnoreCase) ? " selected" : string.Empty;
        return new HtmlString($"<option value=\"{HtmlEncoder.Default.Encode(value)}\"{selected}>{HtmlEncoder.Default.Encode(label)}</option>");
    }
}
