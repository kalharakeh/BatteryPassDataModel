@using MongoDB.Bson
@model BatteryPassWeb.Models.ViewModels.PassportAuditTrailViewModel
@{
    ViewData["Title"] = "Passport audit trail";
    var passport = Model.Passport;
}

<main class="bp-page bp-admin-page">
    <div class="d-flex justify-content-between flex-wrap gap-3 align-items-end">
        <div>
            <h1 class="mb-1">Audit trail</h1>
            <p class="bp-passport-id mb-0">@passport.PassportId</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/conformance" class="bp-secondary-button">Conformance</a>
            <a href="/admin/passports/@Uri.EscapeDataString(passport.PassportId)/revisions" class="bp-secondary-button">Revision history</a>
        </div>
    </div>

    <section class="bp-card">
        <span class="bp-summary-title">Append-only events</span>
        <p class="text-secondary mt-2">Each trust workflow action writes an audit event with actor, source, message, and supporting metadata.</p>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Created</th>
                        <th>Event</th>
                        <th>Actor</th>
                        <th>Source</th>
                        <th>Message</th>
                        <th>Metadata</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var auditEvent in Model.AuditEvents)
                    {
                        var metadata = auditEvent.GetValue("metadata", new BsonDocument()) as BsonDocument ?? new BsonDocument();
                        <tr>
                            <td>@BatteryPassWeb.Services.BsonHelpers.GetString(auditEvent, "createdAt")</td>
                            <td>@BatteryPassWeb.Services.BsonHelpers.GetString(auditEvent, "eventType")</td>
                            <td>@BatteryPassWeb.Services.BsonHelpers.GetString(auditEvent, "actor")</td>
                            <td>@BatteryPassWeb.Services.BsonHelpers.GetString(auditEvent, "source")</td>
                            <td>@BatteryPassWeb.Services.BsonHelpers.GetString(auditEvent, "message")</td>
                            <td><code>@metadata.ToJson()</code></td>
                        </tr>
                    }
                    @if (Model.AuditEvents.Count == 0)
                    {
                        <tr><td colspan="6" class="bp-table-empty">No audit events recorded yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
