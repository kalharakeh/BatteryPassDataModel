@model BatteryPassWeb.Models.ViewModels.PassportAuditTrailViewModel
@{
    ViewData["Title"] = "Passport audit trail";
    var passport = Model.Passport;
    var isClusterAdminMode = Model.Mode.Equals("cluster-admin", StringComparison.OrdinalIgnoreCase);
    var workflowBasePath = isClusterAdminMode ? "/cluster-admin" : "/admin";
    var backToBatteriesHref = isClusterAdminMode ? "/cluster-admin/passports" : "/admin/clusters?tab=batteries";
    var editHref = $"{workflowBasePath}/passports/{Uri.EscapeDataString(passport.PassportId)}/edit";
    var conformanceHref = $"{workflowBasePath}/passports/{Uri.EscapeDataString(passport.PassportId)}/conformance";
    var revisionsHref = $"{workflowBasePath}/passports/{Uri.EscapeDataString(passport.PassportId)}/revisions";
}

<main class="bp-page bp-admin-page bp-ledger">
    <div class="bp-ledger-header">
        <div>
            <a href="@backToBatteriesHref" class="bp-secondary-button bp-button-compact mb-3">Back to batteries</a>
            <span class="bp-summary-title">Audit trail</span>
            <h1 class="mb-1">Who changed what, when, and where</h1>
            <p class="bp-passport-id mb-0"><span class="bp-id-copy-row"><span class="bp-id-value">@passport.PassportId</span>@await Html.PartialAsync("_CopyIdButton", passport.PassportId)</span></p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="@editHref" class="bp-secondary-button">Edit passport</a>
            <a href="@conformanceHref" class="bp-secondary-button">Conformance</a>
            <a href="@revisionsHref" class="bp-secondary-button">Revision history</a>
        </div>
    </div>

    <section class="bp-ledger-state-grid">
        <article class="bp-card">
            <span>Current trust state</span>
            <strong>@passport.TrustState</strong>
            <small>@(passport.TrustIsDirty ? "Dirty state is active. Check the latest update event for dirtyReason." : "No dirty state is currently active.")</small>
        </article>
        <article class="bp-card">
            <span>Latest revision</span>
            <strong>@(string.IsNullOrWhiteSpace(passport.TrustLatestRevisionId) ? "No signed revision" : passport.TrustLatestRevisionId)</strong>
            <small>@(string.IsNullOrWhiteSpace(passport.TrustLastSignedAt) ? "Not signed yet" : passport.TrustLastSignedAt)</small>
        </article>
        <article class="bp-card">
            <span>Latest hash</span>
            <strong>@(string.IsNullOrWhiteSpace(passport.TrustLatestHash) ? "No hash" : passport.TrustLatestHash)</strong>
            <small>@passport.TrustProofStatus</small>
        </article>
    </section>

    <section class="bp-card bp-ledger-panel">
        <div class="bp-ledger-panel-heading">
            <div>
                <span class="bp-summary-title">Append-only events</span>
                <h2>Timeline</h2>
            </div>
            <p>Each event shows <strong>What changed</strong>, <strong>When</strong>, <strong>Who</strong>, and <strong>Where</strong>. Metadata is kept visible for proof, document hash, and dirty state diagnostics.</p>
        </div>

        <div class="bp-ledger-timeline">
            @foreach (var auditEvent in Model.AuditEvents)
            {
                @await Html.PartialAsync("_AuditEventRow", auditEvent)
            }

            @if (Model.AuditEvents.Count == 0)
            {
                <div class="bp-table-empty">No audit events recorded yet.</div>
            }
        </div>
    </section>
</main>
