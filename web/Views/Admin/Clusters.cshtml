@model BatteryPassWeb.Models.ViewModels.AdminClusterViewModel
@{
    ViewData["Title"] = "Administration";
    var selectedTab = Model.SelectedTab;
    var credentialTab = Model.SelectedCredentialTab;
    var clustersById = Model.Clusters.ToDictionary(cluster => cluster.ClusterId, cluster => cluster, StringComparer.OrdinalIgnoreCase);
    string TabClass(string tab) => selectedTab == tab ? "bp-tab bp-tab-active" : "bp-tab";
    var query = Model.PassportsQuery ?? string.Empty;
    var querySuffix = string.IsNullOrWhiteSpace(query) ? string.Empty : $"&q={Uri.EscapeDataString(query)}";
    var localEditableKeys = Model.LocalEditableFieldPolicy.EditableFieldKeys.ToHashSet(StringComparer.OrdinalIgnoreCase);
}
<main class="bp-page bp-admin-page">
    <div>
        <h1 class="mb-1">Administration</h1>
        <p class="text-secondary mb-0">Manage passports, battery families, battery cluster assignments, registered clusters, and user memberships from one page.</p>
    </div>

    <nav class="bp-tab-row mt-4" aria-label="Administration tabs">
        <a class="@TabClass("passports")" href="/admin/clusters?tab=passports@querySuffix">Passports</a>
        <a class="@TabClass("battery")" href="/admin/clusters?tab=battery">Battery cluster assignments</a>
        <a class="@TabClass("clusters")" href="/admin/clusters?tab=clusters">Registered clusters</a>
        <a class="@TabClass("users")" href="/admin/clusters?tab=users">Users</a>
        <a class="@TabClass("local-editable-fields")" href="/admin/clusters?tab=local-editable-fields">Local editable fields</a>
        <a class="@TabClass("api-token-management")" href="/admin/clusters?tab=api-token-management">API Token Management</a>
        <a class="@TabClass("products")" href="/admin/clusters?tab=products">Battery families</a>
        <a class="bp-tab" href="/admin/help">Help</a>
    </nav>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success mt-3 mb-0">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.GeneratedCredential))
    {
        <div class="alert alert-warning mt-3 mb-0">
            <strong>Generated credential (store now):</strong>
            <code>@Model.GeneratedCredential</code>
        </div>
    }

    @if (selectedTab == "passports")
    {
        <section class="bp-card mt-4">
            <div class="d-flex justify-content-between flex-wrap gap-3 align-items-end">
                <form action="/admin/clusters" class="bp-search-form mb-0">
                    <input type="hidden" name="tab" value="passports" />
                    <input
                        name="q"
                        value="@Model.PassportsQuery"
                        placeholder="Search by passport ID, model, serial, or manufacturer" />
                    <button type="submit">Search</button>
                </form>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/admin/help" class="bp-secondary-button">Help</a>
                    <a href="/admin/passports/new" class="bp-primary-button">New passport</a>
                </div>
            </div>
        </section>

        <section class="bp-card p-0 overflow-auto">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-4 py-3">Battery ID</th>
                        <th class="px-4 py-3">Battery Family</th>
                        <th class="px-4 py-3">Battery version</th>
                        <th class="px-4 py-3">Battery serial number</th>
                        <th class="px-4 py-3">Passport status</th>
                        <th class="px-4 py-3">Updated</th>
                        <th class="px-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Passports)
                    {
                        var updated = string.IsNullOrWhiteSpace(row.UpdatedDate)
                            ? string.Empty
                            : row.UpdatedDate.Length >= 10
                                ? row.UpdatedDate.Substring(0, 10)
                                : row.UpdatedDate;
                        <tr>
                            <td class="px-4 py-3 text-break">@row.PassportId</td>
                            <td class="px-4 py-3">@row.BatteryFamily</td>
                            <td class="px-4 py-3">@row.BatteryVersion</td>
                            <td class="px-4 py-3">@row.BatterySerialNumber</td>
                            <td class="px-4 py-3">@row.PassportStatus</td>
                            <td class="px-4 py-3">@updated</td>
                            <td class="px-4 py-3">
                                <div class="d-flex gap-3">
                                    <a href="/admin/passports/@Uri.EscapeDataString(row.PassportId)/edit">Edit</a>
                                    <a href="/admin/passports/@Uri.EscapeDataString(row.PassportId)/conformance">Conformance</a>
                                    <form method="post" action="/admin/passports/archive">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="passportId" value="@row.PassportId" />
                                        <button type="submit" class="btn btn-link p-0 text-danger">Archive</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (selectedTab == "battery")
    {
        <section class="bp-card mt-4 p-0 overflow-auto">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-3 py-3">Battery</th>
                        <th class="px-3 py-3">Current cluster</th>
                        <th class="px-3 py-3">Assign</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var passport in Model.Passports)
                    {
                        <tr>
                            <td class="px-3 py-3">
                                <p class="mb-1 fw-semibold">@passport.BatteryFamily</p>
                                <p class="mb-0 small text-break text-secondary">@passport.PassportId</p>
                            </td>
                            <td class="px-3 py-3">
                                <p class="mb-0">@passport.ClusterLabel</p>
                                @if (!string.IsNullOrWhiteSpace(passport.ClusterId))
                                {
                                    <p class="mb-0 small text-secondary">@passport.ClusterId</p>
                                }
                            </td>
                            <td class="px-3 py-3">
                                <form method="post" action="/admin/clusters/assign-passport" class="d-flex flex-wrap gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="passportId" value="@passport.PassportId" />
                                    <select name="clusterId" class="form-select form-select-sm" style="min-width: 260px;">
                                        @foreach (var cluster in Model.Clusters)
                                        {
                                            if (passport.ClusterId == cluster.ClusterId)
                                            {
                                                <option value="@cluster.ClusterId" selected>@cluster.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@cluster.ClusterId">@cluster.Name</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" class="bp-secondary-button">Save</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (selectedTab == "clusters")
    {
        <div class="bp-two-column mt-4">
            <section class="bp-card">
                <h2 class="h5 mb-3">Add cluster</h2>
                <form method="post" action="/admin/clusters/create" class="bp-stack-form">
                    @Html.AntiForgeryToken()
                    <label>
                        Cluster name
                        <input type="text" name="name" placeholder="North Operations Cluster" required />
                    </label>
                    <label>
                        Cluster ID
                        <input type="text" name="clusterId" placeholder="cluster-north-operations (optional)" />
                    </label>
                    <button type="submit" class="bp-primary-button">Save cluster</button>
                </form>
            </section>
            <section class="bp-card p-0 overflow-auto">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="px-3 py-3">Cluster ID</th>
                            <th class="px-3 py-3">Name</th>
                            <th class="px-3 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cluster in Model.Clusters)
                        {
                            <tr>
                                <td class="px-3 py-3"><code>@cluster.ClusterId</code></td>
                                <td class="px-3 py-3">
                                    <form method="post" action="/admin/clusters/update" class="d-flex flex-wrap gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="clusterId" value="@cluster.ClusterId" />
                                        <input class="form-control form-control-sm" name="name" value="@cluster.Name" required />
                                        <button type="submit" class="bp-secondary-button">Save</button>
                                    </form>
                                </td>
                                <td class="px-3 py-3">
                                    <form method="post" action="/admin/clusters/delete">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="clusterId" value="@cluster.ClusterId" />
                                        <button type="submit" class="bp-danger-button">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </div>
    }

    @if (selectedTab == "users")
    {
        <div class="bp-two-column mt-4">
            <section class="bp-card">
                <h2 class="h5 mb-3">Add or update user</h2>
                <form method="post" action="/admin/clusters/save-user" class="bp-stack-form">
                    @Html.AntiForgeryToken()
                    <label>
                        Email
                        <input type="email" name="email" placeholder="user@example.test" required />
                    </label>
                    <label>
                        Name
                        <input type="text" name="name" placeholder="Display name" />
                    </label>
                    <label>
                        Password
                        <span class="bp-password-field">
                            <input type="password" name="password" placeholder="Required for new users; optional to reset existing users" />
                            <button type="button" class="bp-password-reveal" data-password-reveal aria-label="Show password">Show</button>
                        </span>
                    </label>
                    <label>
                        System role
                        <select name="systemRole">
                            <option value="member">Standard user</option>
                            <option value="admin">Global admin</option>
                        </select>
                    </label>
                    <label>
                        Cluster membership (optional)
                        <select name="clusterId">
                            <option value="">No cluster membership</option>
                            @foreach (var cluster in Model.Clusters)
                            {
                                <option value="@cluster.ClusterId">@cluster.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        Membership role
                        <select name="role">
                            <option value="member">Normal user</option>
                            <option value="clusterAdmin">Local admin</option>
                        </select>
                    </label>
                    <button type="submit" class="bp-primary-button">Save user</button>
                </form>
            </section>

            <section class="bp-card p-0 overflow-auto">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="px-3 py-3">User</th>
                            <th class="px-3 py-3">Clusters and roles</th>
                            <th class="px-3 py-3">Add or modify membership</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users.OrderBy(user => user.Email, StringComparer.OrdinalIgnoreCase))
                        {
                            var memberships = Model.Memberships
                                .Where(membership => membership.Email.Equals(user.Email, StringComparison.OrdinalIgnoreCase))
                                .OrderBy(membership => membership.ClusterId, StringComparer.OrdinalIgnoreCase)
                                .ToList();

                            <tr>
                                <td class="px-3 py-3 align-top">
                                    <p class="mb-1 fw-semibold">@user.Email</p>
                                    @if (!string.IsNullOrWhiteSpace(user.Name))
                                    {
                                        <p class="mb-0 small text-secondary">@user.Name</p>
                                    }
                                    @if (user.Roles.Count > 0)
                                    {
                                        <p class="mb-0 small text-secondary">@string.Join(", ", user.Roles)</p>
                                    }
                                </td>
                                <td class="px-3 py-3 align-top">
                                    @if (memberships.Count == 0)
                                    {
                                        <span class="text-secondary">No cluster membership</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var membership in memberships)
                                            {
                                                var clusterName = clustersById.TryGetValue(membership.ClusterId, out var cluster) ? cluster.Name : membership.ClusterId;
                                                <form method="post" action="/admin/clusters/delete-user" class="bp-tag">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="email" value="@membership.Email" />
                                                    <input type="hidden" name="clusterId" value="@membership.ClusterId" />
                                                    <span>@clusterName (@membership.ClusterId)</span>
                                                    <span class="bp-role-tag">@(membership.Role == "clusterAdmin" ? "Local admin" : "Normal user")</span>
                                                    <button type="submit" class="bp-tag-delete" aria-label="Delete membership">x</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="px-3 py-3 align-top">
                                    <form method="post" action="/admin/clusters/assign-user" class="d-flex flex-wrap gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="email" value="@user.Email" />
                                        <select name="clusterId" class="form-select form-select-sm" style="min-width: 240px;">
                                            @foreach (var cluster in Model.Clusters)
                                            {
                                                <option value="@cluster.ClusterId">@cluster.Name</option>
                                            }
                                        </select>
                                        <select name="role" class="form-select form-select-sm" style="min-width: 170px;">
                                            <option value="member">Normal user</option>
                                            <option value="clusterAdmin">Local admin</option>
                                        </select>
                                        <button type="submit" class="bp-secondary-button">Save</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </div>
    }

    @if (selectedTab == "local-editable-fields")
    {
        <section class="bp-card mt-4">
            <div class="d-flex justify-content-between flex-wrap gap-3 align-items-start">
                <div>
                    <h2 class="h5 mb-1">Local editable fields</h2>
                    <p class="text-secondary mb-0">Choose which passport fields local admins can update globally across all batteries.</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.LocalEditableFieldPolicy.UpdatedAt))
                {
                    <p class="small text-secondary mb-0">Updated @Model.LocalEditableFieldPolicy.UpdatedAt by @Model.LocalEditableFieldPolicy.UpdatedBy</p>
                }
            </div>
            <form method="post" action="/admin/local-editable-fields/save" class="bp-stack-form mt-3">
                @Html.AntiForgeryToken()
                @foreach (var policySection in Model.LocalEditableFieldPolicy.Sections.OrderBy(policySection => policySection.SortOrder))
                {
                    <fieldset class="bp-policy-section">
                        <legend>@policySection.Label</legend>
                        <div class="bp-requirement-grid">
                            @foreach (var field in policySection.Fields.OrderBy(field => field.SortOrder))
                            {
                                <label class="bp-checkbox-option">
                                    <input type="checkbox" name="editableFieldKeys" value="@field.FieldKey" checked="@localEditableKeys.Contains(field.FieldKey)" />
                                    <span>@field.Label</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }
                <button type="submit" class="bp-primary-button">Save local editable fields</button>
            </form>
        </section>
    }

    @if (selectedTab == "api-token-management")
    {
        <section class="bp-card mt-4 bp-credential-management" data-credential-management>
            <div class="d-flex justify-content-between flex-wrap gap-3 align-items-start">
                <div>
                    <h2 class="h5 mb-1">API Token Management</h2>
                    <p class="text-secondary mb-0">Manage external API tokens and per-battery write secrets from one place.</p>
                </div>
                <div class="bp-credential-tab-row" role="tablist" aria-label="API Token Management sections">
                    <button type="button" class="bp-tab @(credentialTab == "api-tokens" ? "bp-tab-active" : string.Empty)" data-credential-tab="api-tokens" aria-selected="@(credentialTab == "api-tokens" ? "true" : "false")">API tokens</button>
                    <button type="button" class="bp-tab @(credentialTab == "battery-secrets" ? "bp-tab-active" : string.Empty)" data-credential-tab="battery-secrets" aria-selected="@(credentialTab == "battery-secrets" ? "true" : "false")">Battery secrets</button>
                </div>
            </div>
        </section>
        <div class="bp-credential-stack mt-4" data-credential-panel="api-tokens" hidden="@(credentialTab != "api-tokens")">
            <section class="bp-card bp-credential-panel">
                <div class="bp-credential-panel-header">
                    <h2 class="h5 mb-0">Create API token</h2>
                    <form method="post" action="/admin/api/tokens/generate-per-cluster">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="bp-secondary-button">Generate tokens for every cluster</button>
                    </form>
                </div>
                <form method="post" action="/admin/api/tokens/create" class="bp-credential-form-grid bp-token-form-grid">
                    @Html.AntiForgeryToken()
                    <label>
                        Token name
                        <input type="text" name="name" placeholder="Cluster North RW token" required />
                    </label>
                    <label>
                        Access mode
                        <select name="accessMode">
                            <option value="read">Read</option>
                            <option value="readWrite">Read + write</option>
                        </select>
                    </label>
                    <label class="bp-token-clusters-field">
                        Linked clusters (optional)
                        <select name="clusterIds" multiple size="7" class="bp-token-clusters">
                            @foreach (var cluster in Model.Clusters)
                            {
                                <option value="@cluster.ClusterId">@cluster.Name (@cluster.ClusterId)</option>
                            }
                        </select>
                    </label>
                    <div class="bp-checkbox-row">
                        <label class="bp-checkbox-option">
                            <input type="checkbox" name="allowUnassigned" />
                            <span>Allow access to unassigned batteries</span>
                        </label>
                        <label class="bp-checkbox-option">
                            <input type="checkbox" name="globalAccess" />
                            <span>Global access to all clusters and unassigned batteries</span>
                        </label>
                    </div>
                    <div class="bp-credential-actions">
                        <button type="submit" class="bp-primary-button">Create token</button>
                    </div>
                </form>
            </section>
            <section class="bp-card bp-table-card">
                <div class="bp-table-scroll">
                    <table class="table table-hover align-middle bp-credential-table">
                        <thead>
                            <tr>
                                <th>Token</th>
                                <th>Access</th>
                                <th>Scope</th>
                                <th>Status</th>
                                <th>Last used</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ApiTokens.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="bp-table-empty">No API tokens have been created.</td>
                                </tr>
                            }
                            @foreach (var token in Model.ApiTokens)
                            {
                                var accessLabel = token.AccessMode.Equals("readWrite", StringComparison.OrdinalIgnoreCase) ? "Read + write" : "Read";
                                var statusClass = token.IsActive ? "bp-status-pill is-active" : "bp-status-pill is-inactive";
                                <tr>
                                    <td>
                                        <p class="bp-credential-name">@token.Name</p>
                                        <p class="mb-0 small text-secondary"><code class="bp-code-wrap">@token.TokenId</code>@(token.IsSample ? " (sample)" : string.Empty)</p>
                                    </td>
                                    <td><span class="bp-access-pill">@accessLabel</span></td>
                                    <td>
                                        @if (token.GlobalAccess)
                                        {
                                            <p class="mb-0">Global scope</p>
                                        }
                                        else
                                        {
                                            <p class="mb-0">@token.ClusterIdsLabel</p>
                                        }
                                        @if (token.AllowUnassigned && !token.GlobalAccess)
                                        {
                                            <p class="mb-0 small text-secondary">Also includes unassigned batteries</p>
                                        }
                                    </td>
                                    <td><span class="@statusClass">@(token.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(token.LastUsedAt) ? "-" : token.LastUsedAt)</td>
                                    <td>
                                        <div class="bp-action-row">
                                            <form method="post" action="/admin/api/tokens/regenerate">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="tokenId" value="@token.TokenId" />
                                                <button type="submit" class="bp-secondary-button">Regenerate</button>
                                            </form>
                                            <form method="post" action="/admin/api/tokens/set-active">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="tokenId" value="@token.TokenId" />
                                                <input type="hidden" name="isActive" value="@(token.IsActive ? "false" : "true")" />
                                                <button type="submit" class="bp-danger-button">@(token.IsActive ? "Deactivate" : "Activate")</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="bp-credential-stack mt-4" data-credential-panel="battery-secrets" hidden="@(credentialTab != "battery-secrets")">
            <section class="bp-card bp-credential-panel">
                <div class="bp-credential-panel-header">
                    <h2 class="h5 mb-0">Create or replace battery secret</h2>
                </div>
                <form method="post" action="/admin/api/secrets/upsert" class="bp-credential-form-grid bp-secret-form-grid">
                    @Html.AntiForgeryToken()
                    <label class="bp-secret-passport-field">
                        Battery passport
                        <select name="passportId" required>
                            @foreach (var passport in Model.Passports.OrderBy(passport => passport.DisplayName, StringComparer.OrdinalIgnoreCase))
                            {
                                <option value="@passport.PassportId">@passport.DisplayName (@passport.PassportId)</option>
                            }
                        </select>
                    </label>
                    <label class="bp-checkbox-option">
                        <input type="checkbox" name="isActive" checked />
                        <span>Secret active</span>
                    </label>
                    <div class="bp-credential-actions">
                        <button type="submit" class="bp-primary-button">Create or update secret</button>
                    </div>
                </form>
            </section>
            <section class="bp-card bp-table-card">
                <div class="bp-table-scroll">
                    <table class="table table-hover align-middle bp-credential-table">
                        <thead>
                            <tr>
                                <th>Passport</th>
                                <th>Cluster</th>
                                <th>Active</th>
                                <th>Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.BatterySecrets.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="bp-table-empty">No battery secrets have been created.</td>
                                </tr>
                            }
                            @foreach (var secret in Model.BatterySecrets)
                            {
                                var statusClass = secret.IsActive ? "bp-status-pill is-active" : "bp-status-pill is-inactive";
                                <tr>
                                    <td><code class="bp-code-wrap">@secret.PassportId</code></td>
                                    <td>@secret.ClusterLabel</td>
                                    <td><span class="@statusClass">@(secret.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@secret.UpdatedAt</td>
                                    <td>
                                        <div class="bp-action-row">
                                            <form method="post" action="/admin/api/secrets/regenerate">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="passportId" value="@secret.PassportId" />
                                                <button type="submit" class="bp-secondary-button">Regenerate</button>
                                            </form>
                                            <form method="post" action="/admin/api/secrets/set-active">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="passportId" value="@secret.PassportId" />
                                                <input type="hidden" name="isActive" value="@(secret.IsActive ? "false" : "true")" />
                                                <button type="submit" class="bp-danger-button">@(secret.IsActive ? "Deactivate" : "Activate")</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }

    @if (selectedTab == "products")
    {
        <section class="bp-card bp-product-template-hero mt-4">
            <div>
                <span class="bp-summary-title">Battery families</span>
                <h2>Battery families and version parameters</h2>
                <p class="mb-0">
                    Battery families hold the shared battery data, required/optional policy, battery image,
                    software release dates, and signed evidence references used when creating passports.
                    Editing a family does not silently change batteries. Use a battery-version push when you are ready.
                </p>
            </div>
            <div class="bp-product-template-actions">
                <a href="/admin/products/new" class="bp-secondary-button">Add battery family</a>
                <form method="post" action="/admin/product-templates/reset">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="bp-secondary-button">Reset template passports</button>
                </form>
            </div>
        </section>

        <section class="bp-product-template-grid mt-4">
            @foreach (var product in Model.ProductTemplates)
            {
                <article class="bp-card bp-product-template-card">
                    <div class="bp-product-template-card-media">
                        <img src="@product.ImageUrl" alt="@product.ProductName battery family image" />
                    </div>
                    <div class="bp-product-template-card-body">
                        <span class="bp-summary-title">@product.ProductId</span>
                        <h3>@product.ProductName</h3>
                        <p>@product.Description</p>
                        <dl class="bp-product-template-meta">
                            <div><dt>Modules</dt><dd>@product.ModuleCount</dd></div>
                            <div><dt>Battery versions</dt><dd>@product.BatteryVersionCount</dd></div>
                            <div><dt>Required fields</dt><dd>@product.RequiredFieldCount</dd></div>
                            <div><dt>Template documents</dt><dd>@product.DocumentCount</dd></div>
                        </dl>
                        <a href="/admin/products/@Uri.EscapeDataString(product.ProductId)" class="bp-primary-button">Edit family</a>
                    </div>
                </article>
            }
        </section>
    }

</main>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-password-reveal]').forEach((button) => {
                button.addEventListener('click', () => {
                    const input = button.closest('.bp-password-field')?.querySelector('input');
                    if (!input) {
                        return;
                    }

                    const reveal = input.type === 'password';
                    input.type = reveal ? 'text' : 'password';
                    button.textContent = reveal ? 'Hide' : 'Show';
                    button.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password');
                });
            });

            const credentialTabs = Array.from(document.querySelectorAll('[data-credential-tab]'));
            const credentialPanels = Array.from(document.querySelectorAll('[data-credential-panel]'));
            credentialTabs.forEach((tab) => {
                tab.addEventListener('click', () => {
                    const selected = tab.dataset.credentialTab || 'api-tokens';
                    credentialTabs.forEach((candidate) => {
                        const active = candidate.dataset.credentialTab === selected;
                        candidate.classList.toggle('bp-tab-active', active);
                        candidate.setAttribute('aria-selected', active ? 'true' : 'false');
                    });
                    credentialPanels.forEach((panel) => {
                        panel.hidden = panel.dataset.credentialPanel !== selected;
                    });
                    history.replaceState(null, '', `/admin/clusters?tab=${selected}`);
                });
            });
        })();
    </script>
}
