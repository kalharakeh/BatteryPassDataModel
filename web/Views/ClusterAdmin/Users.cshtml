@model BatteryPassWeb.Models.ViewModels.AdminClusterViewModel
@{
    ViewData["Title"] = "Cluster users";
    var errorMessage = ViewData["ErrorMessage"] as string ?? string.Empty;
    var clustersById = Model.Clusters.ToDictionary(cluster => cluster.ClusterId, cluster => cluster, StringComparer.OrdinalIgnoreCase);
}
<main class="bp-page bp-admin-page">
    <div class="d-flex justify-content-between flex-wrap gap-3 align-items-end">
        <div>
            <h1 class="mb-1">Cluster users</h1>
            <p class="text-secondary mb-0">Add, edit, or remove users in clusters where you are a local admin.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/cluster-admin/passports" class="bp-secondary-button">Managed passports</a>
            <a href="/cluster-admin/api-tokens" class="bp-secondary-button">API tokens</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-2 mb-0">@errorMessage</div>
    }

    <div class="bp-management-shell mt-4">
        <section class="bp-card bp-management-create-card">
            <div>
                <span class="bp-summary-title">Cluster user setup</span>
                <h2 class="h5 mb-2">Add or update user</h2>
                <p class="text-secondary mb-0">Manage memberships only for clusters where you are a local admin.</p>
            </div>
            <form method="post" action="/cluster-admin/users/save" class="bp-user-form-grid">
                @Html.AntiForgeryToken()
                <label>
                    Email
                    <input type="email" name="email" placeholder="user@example.test" required />
                </label>
                <label>
                    Name
                    <input type="text" name="name" placeholder="Display name" />
                </label>
                <label>
                    Password
                    <span class="bp-password-field">
                        <input type="password" name="password" placeholder="Required for new users; optional to reset existing users" />
                        <button type="button" class="bp-password-reveal" data-password-reveal aria-label="Show password">Show</button>
                    </span>
                </label>
                <label>
                    Cluster
                    <select name="clusterId" required>
                        @foreach (var cluster in Model.Clusters)
                        {
                            <option value="@cluster.ClusterId">@cluster.Name</option>
                        }
                    </select>
                </label>
                <label>
                    Membership role
                    <select name="role">
                        <option value="member">Normal User</option>
                        <option value="clusterAdmin">Local Admin</option>
                    </select>
                </label>
                <button type="submit" class="bp-primary-button">Save user</button>
            </form>
        </section>

        <section class="bp-user-management-list">
            @if (Model.Users.Count == 0)
            {
                <article class="bp-management-card">
                    <p class="text-secondary mb-0">No users are connected to your managed clusters yet.</p>
                </article>
            }
            else
            {
                @foreach (var user in Model.Users.OrderBy(user => user.Email, StringComparer.OrdinalIgnoreCase))
                {
                    var memberships = Model.Memberships
                        .Where(membership => membership.Email.Equals(user.Email, StringComparison.OrdinalIgnoreCase))
                        .OrderBy(membership => membership.ClusterId, StringComparer.OrdinalIgnoreCase)
                        .ToList();

                    <article class="bp-management-card bp-user-card">
                        <div class="bp-user-card-identity">
                            <h3>@(string.IsNullOrWhiteSpace(user.Name) ? user.Email : user.Name)</h3>
                            <p>@user.Email</p>
                            @if (user.Roles.Count > 0)
                            {
                                <dl class="bp-user-role-summary">
                                    <div><dt>System role</dt><dd>@string.Join(", ", user.Roles)</dd></div>
                                </dl>
                            }
                        </div>
                        <div class="bp-membership-panel">
                            <h4>Managed cluster memberships</h4>
                            @if (memberships.Count == 0)
                            {
                                <p class="text-secondary mb-0">No cluster membership</p>
                            }
                            else
                            {
                                <div class="bp-membership-list">
                                    @foreach (var membership in memberships)
                                    {
                                        var clusterName = clustersById.TryGetValue(membership.ClusterId, out var cluster) ? cluster.Name : membership.ClusterId;
                                        <form method="post" action="/cluster-admin/users/delete-membership" class="bp-membership-row">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="email" value="@membership.Email" />
                                            <input type="hidden" name="clusterId" value="@membership.ClusterId" />
                                            <div>
                                                <strong>@clusterName</strong>
                                                <span>@membership.ClusterId</span>
                                            </div>
                                            <span>@(membership.Role == "clusterAdmin" ? "Local Admin" : "Normal User")</span>
                                            <button type="submit" class="bp-icon-button" aria-label="Remove membership">x</button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                        <form method="post" action="/cluster-admin/users/save" class="bp-membership-edit-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@user.Email" />
                            <label>
                                Display name
                                <input class="form-control form-control-sm" name="name" value="@user.Name" placeholder="Display name" />
                            </label>
                            <label>
                                New password
                                <span class="bp-password-field bp-password-field-inline">
                                    <input class="form-control form-control-sm" type="password" name="password" placeholder="Leave blank to keep current password" />
                                    <button type="button" class="bp-password-reveal" data-password-reveal aria-label="Show password">Show</button>
                                </span>
                            </label>
                            <label>
                                Cluster
                                <select name="clusterId" class="form-select form-select-sm">
                                    @foreach (var cluster in Model.Clusters)
                                    {
                                        <option value="@cluster.ClusterId">@cluster.Name</option>
                                    }
                                </select>
                            </label>
                            <label>
                                Membership role
                                <select name="role" class="form-select form-select-sm">
                                    <option value="member">Normal User</option>
                                    <option value="clusterAdmin">Local Admin</option>
                                </select>
                            </label>
                            <button type="submit" class="bp-secondary-button">Save membership</button>
                        </form>
                    </article>
                }
            }
        </section>
    </div>
</main>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-password-reveal]').forEach((button) => {
                button.addEventListener('click', () => {
                    const input = button.closest('.bp-password-field')?.querySelector('input');
                    if (!input) {
                        return;
                    }

                    const reveal = input.type === 'password';
                    input.type = reveal ? 'text' : 'password';
                    button.textContent = reveal ? 'Hide' : 'Show';
                    button.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password');
                });
            });
        })();
    </script>
}
