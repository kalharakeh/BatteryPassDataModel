@model BatteryPassWeb.Models.ViewModels.AdminClusterViewModel
@{
    ViewData["Title"] = "Cluster API tokens";
}

<main class="bp-page bp-admin-page">
    <header class="bp-console-header">
        <div>
            <h1>Cluster API tokens</h1>
            <p class="text-secondary mb-0">Create and remove API tokens for clusters where you are a local admin.</p>
        </div>
    </header>

    <nav class="bp-local-admin-nav" aria-label="Local admin tabs">
        <div class="bp-tab-row">
            <a class="bp-tab" href="/cluster-admin/passports">Managed passports</a>
            <a class="bp-tab" href="/cluster-admin/users">Users</a>
            <a class="bp-tab bp-tab-active" href="/cluster-admin/api-tokens">API token management</a>
        </div>
    </nav>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success mt-3 mb-0">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-3 mb-0">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.GeneratedCredential))
    {
        <div class="alert alert-warning mt-3 mb-0">
            <strong>Generated token (store now):</strong>
            <code>@Model.GeneratedCredential</code>
        </div>
    }

    <div class="bp-management-shell bp-console-split">
        <section class="bp-card bp-console-form-card">
            <h2 class="h5 mb-3">Create API token</h2>
            <form method="post" action="/cluster-admin/api-tokens/create" class="bp-stack-form">
                @Html.AntiForgeryToken()
                <label>
                    Name
                    <input type="text" name="name" placeholder="North cluster sign token" />
                </label>
                <label>
                    Access mode
                    <span class="bp-select-shell">
                        <select name="accessMode">
                            <option value="read">Read</option>
                            <option value="readWrite">Read + write</option>
                            <option value="sign">Create, validate, sign and publish passport</option>
                        </select>
                    </span>
                </label>
                <fieldset class="bp-cluster-picker">
                    <legend>Clusters</legend>
                    <p>Select one or several administered clusters for this token.</p>
                    <div class="bp-cluster-picker-grid">
                    @foreach (var cluster in Model.Clusters)
                    {
                        <label>
                            <input type="checkbox" name="clusterIds" value="@cluster.ClusterId" />
                            <span>
                                <strong>@cluster.Name</strong>
                                <small>@cluster.ClusterId</small>
                            </span>
                        </label>
                    }
                    </div>
                </fieldset>
                <button type="submit" class="bp-primary-button">Create token</button>
            </form>
        </section>

        <section class="bp-card bp-table-card">
            <div class="bp-table-scroll">
            <table class="table table-hover align-middle bp-console-table">
                <thead>
                    <tr>
                        <th>Token</th>
                        <th>Access</th>
                        <th>Clusters</th>
                        <th>Updated</th>
                        <th class="bp-action-cell">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ApiTokens.Count == 0)
                    {
                        <tr>
                            <td class="text-secondary" colspan="5">No API tokens are scoped to your administered clusters.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var token in Model.ApiTokens)
                        {
                            var accessLabel = token.AccessMode.Equals("sign", StringComparison.OrdinalIgnoreCase)
                                ? "Create, validate, sign and publish passport"
                                : token.AccessMode.Equals("readWrite", StringComparison.OrdinalIgnoreCase)
                                    ? "Read + write"
                                    : "Read";
                            <tr>
                                <td>
                                    <p class="mb-1 fw-semibold">@token.Name</p>
                                    <p class="mb-0 small text-secondary">@token.TokenId</p>
                                    @if (!token.IsActive)
                                    {
                                        <span class="bp-role-tag">Deleted</span>
                                    }
                                </td>
                                <td><span class="bp-access-pill">@accessLabel</span></td>
                                <td>@token.ClusterIdsLabel</td>
                                <td>@(string.IsNullOrWhiteSpace(token.UpdatedAt) ? "-" : token.UpdatedAt[..Math.Min(10, token.UpdatedAt.Length)])</td>
                                <td class="bp-action-cell">
                                    <div class="bp-action-row">
                                        <form method="post" action="/cluster-admin/api-tokens/regenerate">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tokenId" value="@token.TokenId" />
                                            <button type="submit" class="bp-secondary-button">Regenerate</button>
                                        </form>
                                        <form method="post" action="/cluster-admin/api-tokens/delete">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tokenId" value="@token.TokenId" />
                                            <button type="submit" class="bp-danger-button" data-confirm-action data-confirm-title="Delete API token" data-confirm-message="Delete @token.Name? Existing integrations using this token will stop working." data-confirm-submit="Delete">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>
        </section>
    </div>
    <div class="bp-confirm-modal" data-confirm-modal hidden>
        <div class="bp-confirm-modal-backdrop" data-confirm-cancel></div>
        <section class="bp-confirm-modal-panel" role="dialog" aria-modal="true" aria-labelledby="bp-confirm-title">
            <p class="bp-summary-title">Please confirm</p>
            <h2 id="bp-confirm-title">Confirm action</h2>
            <p class="bp-confirm-message" data-confirm-message>Are you sure?</p>
            <div class="bp-confirm-actions">
                <button type="button" class="bp-secondary-button" data-confirm-cancel>Cancel</button>
                <button type="button" class="bp-danger-button" data-confirm-submit>Confirm</button>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        (function () {
            const confirmModal = document.querySelector('[data-confirm-modal]');
            const confirmTitle = document.getElementById('bp-confirm-title');
            const confirmMessage = confirmModal?.querySelector('[data-confirm-message]');
            const confirmSubmit = confirmModal?.querySelector('[data-confirm-submit]');
            let pendingForm = null;

            document.querySelectorAll('[data-confirm-action]').forEach((button) => {
                button.addEventListener('click', (event) => {
                    const form = button.closest('form');
                    if (!form || !confirmModal || !confirmTitle || !confirmMessage || !confirmSubmit) {
                        return;
                    }

                    event.preventDefault();
                    pendingForm = form;
                    confirmTitle.textContent = button.dataset.confirmTitle || 'Confirm action';
                    confirmMessage.textContent = button.dataset.confirmMessage || 'Continue with this action?';
                    confirmSubmit.textContent = button.dataset.confirmSubmit || 'Confirm';
                    confirmModal.hidden = false;
                    confirmSubmit.focus();
                });
            });

            confirmModal?.querySelectorAll('[data-confirm-cancel]').forEach((button) => {
                button.addEventListener('click', () => {
                    confirmModal.hidden = true;
                    pendingForm = null;
                });
            });

            confirmSubmit?.addEventListener('click', () => {
                if (pendingForm) {
                    pendingForm.submit();
                }
            });
        })();
    </script>
}
