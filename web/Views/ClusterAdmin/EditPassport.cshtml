@model BatteryPassWeb.Models.ViewModels.EditPassportViewModel
@{
    ViewData["Title"] = "Edit local passport fields";
    var passport = Model.Passport;
    var batteryImageOptions = BatteryPassWeb.Services.BatteryImageCatalog.Options;
    var selectedBatteryImageUrl = BatteryPassWeb.Services.BatteryImageCatalog.NormalizeKnownImageUrl(passport.BatteryImageUrl, passport.PassportId);
    var selectedBatteryCategory = BatteryPassWeb.Services.BatteryImageCatalog.CategoryForImageUrl(selectedBatteryImageUrl);
    bool CanEditField(string fieldKey) => Model.FieldEditableByKey.TryGetValue(fieldKey, out var editable) && editable;
}
<main class="bp-page bp-admin-page">
    <header class="bp-console-header">
        <div>
            <h1>Edit local passport fields</h1>
            <p class="bp-passport-id mb-1">Battery ID: <span class="bp-id-copy-row"><span class="bp-id-value">@passport.BatteryId</span>@await Html.PartialAsync("_CopyIdButton", passport.BatteryId)</span></p>
            <p class="bp-passport-id mb-0">Passport ID: <span class="bp-id-copy-row"><span class="bp-id-value">@passport.PassportId</span>@await Html.PartialAsync("_CopyIdButton", passport.PassportId)</span></p>
        </div>
        <a href="/cluster-admin/passports" class="bp-secondary-button">Back to managed passports</a>
    </header>

    <nav class="bp-local-admin-nav" aria-label="Local admin tabs">
        <div class="bp-tab-row">
            <a class="bp-tab bp-tab-active" href="/cluster-admin/passports">Managed passports</a>
            <a class="bp-tab" href="/cluster-admin/users">Users</a>
            <a class="bp-tab" href="/cluster-admin/api-tokens">API token management</a>
        </div>
    </nav>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success mt-2 mb-0">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-2 mb-0">@Model.ErrorMessage</div>
    }

    <section class="bp-card">
        <form method="post" action="/cluster-admin/passports/save" class="bp-local-edit-grid" data-local-passport-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="passportId" value="@passport.PassportId" />

            <label class="bp-field-shell">
                <span>Cluster</span>
                <input type="text" value="@passport.ClusterLabel" readonly />
            </label>
            <label class="bp-field-shell">
                <span>Facility ID</span>
                @if (CanEditField("general.facilityId"))
                {
                    <input type="text" name="facilityId" value="@passport.FacilityId" />
                }
                else
                {
                    <input type="text" value="@passport.FacilityId" readonly />
                }
            </label>
            <label class="bp-field-shell">
                <span>Battery image</span>
                @if (CanEditField("general.batteryImageUrl"))
                {
                    <select name="batteryImageUrl" data-battery-image-select>
                        @foreach (var imageOption in batteryImageOptions)
                        {
                            if (imageOption.Url.Equals(selectedBatteryImageUrl, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@imageOption.Url" data-image-category="@imageOption.Category" selected>@imageOption.Label (@imageOption.Category)</option>
                            }
                            else
                            {
                                <option value="@imageOption.Url" data-image-category="@imageOption.Category">@imageOption.Label (@imageOption.Category)</option>
                            }
                        }
                    </select>
                }
                else
                {
                    <input type="text" value="@selectedBatteryImageUrl" readonly />
                }
            </label>
            <label class="bp-field-shell">
                <span>Category</span>
                <input type="text" name="category" value="@selectedBatteryCategory" readonly data-image-category />
            </label>
            <label class="bp-field-shell">
                <span>State of charge %</span>
                @if (CanEditField("performance.stateOfCharge"))
                {
                    <input type="number" step="any" min="0" max="100" name="stateOfCharge" value="@passport.Performance.StateOfCharge" />
                }
                else
                {
                    <input type="number" step="any" value="@passport.Performance.StateOfCharge" readonly />
                }
            </label>
            <label class="bp-field-shell">
                <span>Remaining capacity %</span>
                @if (CanEditField("performance.remainingCapacity"))
                {
                    <input type="number" step="any" min="0" max="100" name="remainingCapacity" value="@passport.Performance.RemainingCapacity" />
                }
                else
                {
                    <input type="number" step="any" value="@passport.Performance.RemainingCapacity" readonly />
                }
            </label>
            <label class="bp-field-shell">
                <span>Remaining energy kWh</span>
                @if (CanEditField("performance.remainingEnergy"))
                {
                    <input type="number" step="any" min="0" name="remainingEnergy" value="@passport.Performance.RemainingEnergy" />
                }
                else
                {
                    <input type="number" step="any" value="@passport.Performance.RemainingEnergy" readonly />
                }
            </label>
            <label class="bp-field-shell">
                <span>Full cycles</span>
                @if (CanEditField("performance.fullCycles"))
                {
                    <input type="number" step="1" min="0" name="fullCycles" value="@passport.Performance.Cycles" />
                }
                else
                {
                    <input type="number" step="1" value="@passport.Performance.Cycles" readonly />
                }
            </label>

            <div class="bp-local-edit-actions d-flex justify-content-between flex-wrap gap-2 pt-2">
                <a href="/@Uri.EscapeDataString(passport.PassportId)/summary" class="bp-secondary-button">Open summary report</a>
                <button type="submit" class="bp-primary-button">Save local updates</button>
            </div>
        </form>
    </section>

    <section class="bp-card bp-local-trust-workflow mt-3">
        <div>
            <span class="bp-summary-title">Trust workflow</span>
            <h2 class="h5 mb-1">Validate, sign, and publish</h2>
            <p class="text-secondary mb-0">Workflow actions are recorded against your account in the audit trail.</p>
        </div>
        <div class="bp-local-trust-actions">
            <form method="post" action="/cluster-admin/passports/@Uri.EscapeDataString(passport.PassportId)/validate">
                @Html.AntiForgeryToken()
                <button type="submit" class="bp-secondary-button">Validate</button>
            </form>
            <form method="post" action="/cluster-admin/passports/@Uri.EscapeDataString(passport.PassportId)/sign">
                @Html.AntiForgeryToken()
                <button type="submit" class="bp-secondary-button">Sign</button>
            </form>
            <form method="post" action="/cluster-admin/passports/@Uri.EscapeDataString(passport.PassportId)/publish">
                @Html.AntiForgeryToken()
                <button type="submit" class="bp-primary-button">Publish</button>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        (function () {
            const form = document.querySelector('[data-local-passport-form]');
            if (!form) {
                return;
            }

            const batteryImageSelect = form.querySelector('[data-battery-image-select]');
            const categoryInput = form.querySelector('[data-image-category]');
            if (!batteryImageSelect || !categoryInput) {
                return;
            }

            function syncCategoryFromImage() {
                const selectedOption = batteryImageSelect.options[batteryImageSelect.selectedIndex];
                categoryInput.value = selectedOption?.dataset.imageCategory ?? '';
            }

            syncCategoryFromImage();
            batteryImageSelect.addEventListener('change', syncCategoryFromImage);
        })();
    </script>
}
