@using System.Text.Json
@model BatteryPassWeb.Models.ViewModels.EditPassportViewModel
@{
    ViewData["Title"] = "Edit local battery fields";
    var passport = Model.Passport;
    var batteryImageOptions = BatteryPassWeb.Services.BatteryImageCatalog.Options;
    var selectedBatteryImageUrl = BatteryPassWeb.Services.BatteryImageCatalog.NormalizeKnownImageUrl(passport.BatteryImageUrl, passport.PassportId);
    var selectedBatteryCategory = BatteryPassWeb.Services.BatteryImageCatalog.CategoryForImageUrl(selectedBatteryImageUrl);
    var productTemplateCatalogJson = JsonSerializer.Serialize(Model.ProductTemplateCatalog);
    var selectedCatalogProduct = Model.ProductTemplateCatalog.FirstOrDefault(product => product.ProductId.Equals(Model.SelectedProductId, StringComparison.OrdinalIgnoreCase));
    var selectedProductVersions = selectedCatalogProduct?.ProductVersions ?? Array.Empty<BatteryPassWeb.Models.ViewModels.ProductVersionEditViewModel>();
    var selectedSoftwareVersions = selectedProductVersions.FirstOrDefault(version => version.Version.Equals(Model.SelectedProductVersion, StringComparison.OrdinalIgnoreCase))?.SoftwareVersions
        ?? Array.Empty<BatteryPassWeb.Models.ViewModels.ProductSoftwareVersionEditViewModel>();
    bool CanShowField(string fieldKey) => Model.FieldVisibleByKey.Count == 0 || Model.FieldVisibleByKey.TryGetValue(fieldKey, out var visible) && visible;
    bool CanEditField(string fieldKey) => Model.FieldEditableByKey.TryGetValue(fieldKey, out var editable) && editable;
}
<main class="bp-page bp-admin-page">
    <header class="bp-console-header">
        <div>
            <h1>Edit local battery fields</h1>
            <p class="bp-passport-id mb-1">Battery ID: <span class="bp-id-copy-row"><span class="bp-id-value">@passport.BatteryId</span>@await Html.PartialAsync("_CopyIdButton", passport.BatteryId)</span></p>
            <p class="bp-passport-id mb-0">Passport ID: <span class="bp-id-copy-row"><span class="bp-id-value">@passport.PassportId</span>@await Html.PartialAsync("_CopyIdButton", passport.PassportId)</span></p>
        </div>
        <a href="/cluster-admin/passports" class="bp-secondary-button">Back to managed passports</a>
    </header>

    <nav class="bp-local-admin-nav" aria-label="Local admin tabs">
        <div class="bp-tab-row">
            <a class="bp-tab bp-tab-active" href="/cluster-admin/passports">Managed passports</a>
            <a class="bp-tab" href="/cluster-admin/users">Users</a>
            <a class="bp-tab" href="/cluster-admin/api-tokens">API token management</a>
        </div>
    </nav>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success mt-2 mb-0">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-2 mb-0">@Model.ErrorMessage</div>
    }

    <script type="application/json" data-product-template-catalog>@Html.Raw(productTemplateCatalogJson)</script>

    <section class="bp-card">
        <form method="post" action="/cluster-admin/passports/save" class="bp-local-edit-grid" data-local-battery-form data-selected-product-id="@Model.SelectedProductId" data-selected-product-version="@Model.SelectedProductVersion">
            @Html.AntiForgeryToken()
            <input type="hidden" name="passportId" value="@passport.PassportId" />

            @if (CanShowField("general.clusterId"))
            {
                <label class="bp-field-shell">
                    <span>Cluster</span>
                    <input type="text" value="@passport.ClusterLabel" readonly />
                </label>
            }
            @if (CanShowField("general.batteryModel"))
            {
                <label class="bp-field-shell">
                    <span>Battery Model</span>
                    @if (CanEditField("general.batteryModel"))
                    {
                        <select name="batteryModel" data-product-version-select data-product-template-enum-field="general.batteryModel">
                            @foreach (var productVersion in selectedProductVersions)
                            {
                                if (productVersion.Version.Equals(Model.SelectedProductVersion, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@productVersion.Version" selected>@productVersion.Version</option>
                                }
                                else
                                {
                                    <option value="@productVersion.Version">@productVersion.Version</option>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(passport.BatteryModel)
                                && selectedProductVersions.All(productVersion => !productVersion.Version.Equals(passport.BatteryModel, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@passport.BatteryModel" selected>@passport.BatteryModel</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" value="@passport.BatteryModel" readonly />
                    }
                </label>
            }
            @if (CanShowField("general.softwareVersion"))
            {
                <label class="bp-field-shell">
                    <span>Software version</span>
                    @if (CanEditField("general.softwareVersion"))
                    {
                        <select name="softwareVersion" data-product-software-version-select data-product-template-enum-field="general.softwareVersion">
                            @foreach (var softwareVersion in selectedSoftwareVersions)
                            {
                                if (softwareVersion.SoftwareVersion.Equals(passport.SoftwareVersion, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@softwareVersion.SoftwareVersion" data-release-date="@softwareVersion.SoftwareReleaseDate" data-latest-update="@softwareVersion.SoftwareLatestUpdate" selected>@softwareVersion.SoftwareVersion</option>
                                }
                                else
                                {
                                    <option value="@softwareVersion.SoftwareVersion" data-release-date="@softwareVersion.SoftwareReleaseDate" data-latest-update="@softwareVersion.SoftwareLatestUpdate">@softwareVersion.SoftwareVersion</option>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(passport.SoftwareVersion)
                                && selectedSoftwareVersions.All(softwareVersion => !softwareVersion.SoftwareVersion.Equals(passport.SoftwareVersion, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@passport.SoftwareVersion" selected>@passport.SoftwareVersion</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" value="@passport.SoftwareVersion" readonly />
                    }
                </label>
            }
            @if (CanShowField("general.facilityId"))
            {
                <label class="bp-field-shell">
                    <span>Facility ID</span>
                    @if (CanEditField("general.facilityId"))
                    {
                        <input type="text" name="facilityId" value="@passport.FacilityId" />
                    }
                    else
                    {
                        <input type="text" value="@passport.FacilityId" readonly />
                    }
                </label>
            }
            @if (CanShowField("general.batteryImageUrl"))
            {
                <label class="bp-field-shell">
                    <span>Battery image</span>
                    @if (CanEditField("general.batteryImageUrl"))
                    {
                        <select name="batteryImageUrl" data-battery-image-select>
                            @foreach (var imageOption in batteryImageOptions)
                            {
                                if (imageOption.Url.Equals(selectedBatteryImageUrl, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@imageOption.Url" data-image-category="@imageOption.Category" selected>@imageOption.Label (@imageOption.Category)</option>
                                }
                                else
                                {
                                    <option value="@imageOption.Url" data-image-category="@imageOption.Category">@imageOption.Label (@imageOption.Category)</option>
                                }
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" value="@selectedBatteryImageUrl" readonly />
                    }
                </label>
                <label class="bp-field-shell">
                    <span>Category</span>
                    <input type="text" name="category" value="@selectedBatteryCategory" readonly data-image-category />
                </label>
            }
            @if (CanShowField("performance.stateOfCharge"))
            {
                <label class="bp-field-shell">
                    <span>State of charge %</span>
                    @if (CanEditField("performance.stateOfCharge"))
                    {
                        <input type="number" step="any" min="0" max="100" name="stateOfCharge" value="@passport.Performance.StateOfCharge" />
                    }
                    else
                    {
                        <input type="number" step="any" value="@passport.Performance.StateOfCharge" readonly />
                    }
                </label>
            }
            @if (CanShowField("performance.remainingCapacity"))
            {
                <label class="bp-field-shell">
                    <span>Remaining capacity %</span>
                    @if (CanEditField("performance.remainingCapacity"))
                    {
                        <input type="number" step="any" min="0" max="100" name="remainingCapacity" value="@passport.Performance.RemainingCapacity" />
                    }
                    else
                    {
                        <input type="number" step="any" value="@passport.Performance.RemainingCapacity" readonly />
                    }
                </label>
            }
            @if (CanShowField("performance.remainingEnergy"))
            {
                <label class="bp-field-shell">
                    <span>Remaining energy kWh</span>
                    @if (CanEditField("performance.remainingEnergy"))
                    {
                        <input type="number" step="any" min="0" name="remainingEnergy" value="@passport.Performance.RemainingEnergy" />
                    }
                    else
                    {
                        <input type="number" step="any" value="@passport.Performance.RemainingEnergy" readonly />
                    }
                </label>
            }
            @if (CanShowField("performance.fullCycles"))
            {
                <label class="bp-field-shell">
                    <span>Full cycles</span>
                    @if (CanEditField("performance.fullCycles"))
                    {
                        <input type="number" step="1" min="0" name="fullCycles" value="@passport.Performance.Cycles" />
                    }
                    else
                    {
                        <input type="number" step="1" value="@passport.Performance.Cycles" readonly />
                    }
                </label>
            }

            <div class="bp-local-edit-actions d-flex justify-content-between flex-wrap gap-2 pt-2">
                <a href="/@Uri.EscapeDataString(passport.PassportId)/summary" class="bp-secondary-button">Open summary report</a>
                <button type="submit" class="bp-primary-button">Save battery updates</button>
            </div>
        </form>
    </section>

    <section class="bp-card bp-local-trust-workflow mt-3">
        <div>
            <span class="bp-summary-title">Trust workflow</span>
            <h2 class="h5 mb-1">Validate, sign, and publish</h2>
            <p class="text-secondary mb-0">Workflow actions are recorded against your account in the audit trail.</p>
        </div>
        <div class="bp-local-trust-actions">
            <form method="post" action="/cluster-admin/passports/@Uri.EscapeDataString(passport.PassportId)/validate">
                @Html.AntiForgeryToken()
                <button type="submit" class="bp-secondary-button">Validate</button>
            </form>
            <form method="post" action="/cluster-admin/passports/@Uri.EscapeDataString(passport.PassportId)/sign">
                @Html.AntiForgeryToken()
                <button type="submit" class="bp-secondary-button">Sign</button>
            </form>
            <form method="post" action="/cluster-admin/passports/@Uri.EscapeDataString(passport.PassportId)/publish">
                @Html.AntiForgeryToken()
                <button type="submit" class="bp-primary-button">Publish</button>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        (function () {
            const form = document.querySelector('[data-local-battery-form]');
            if (!form) {
                return;
            }

            const productTemplateCatalogElement = document.querySelector('[data-product-template-catalog]');
            const productVersionSelect = form.querySelector('[data-product-version-select]');
            const softwareVersionSelect = form.querySelector('[data-product-software-version-select]');
            const selectedProductId = form.dataset.selectedProductId || '';
            const selectedProductVersion = form.dataset.selectedProductVersion || '';
            const productTemplateCatalog = parseProductTemplateCatalog(productTemplateCatalogElement?.textContent || '[]');

            function parseProductTemplateCatalog(rawJson) {
                try {
                    const parsed = JSON.parse(rawJson);
                    return Array.isArray(parsed) ? parsed : [];
                } catch {
                    return [];
                }
            }

            function selectedProduct() {
                return productTemplateCatalog.find(product => (product.ProductId || '').toLowerCase() === selectedProductId.toLowerCase())
                    || productTemplateCatalog[0]
                    || null;
            }

            function findProductVersion(product, productVersion) {
                const versions = Array.isArray(product?.ProductVersions) ? product.ProductVersions : [];
                return versions.find(version => (version.Version || '').toLowerCase() === productVersion.toLowerCase())
                    || versions[0]
                    || null;
            }

            function updateProductVersionOptions() {
                if (!productVersionSelect) {
                    return;
                }

                const product = selectedProduct();
                const versions = Array.isArray(product?.ProductVersions) ? product.ProductVersions : [];
                const previousValue = productVersionSelect.value || selectedProductVersion;
                productVersionSelect.innerHTML = '';
                versions.forEach((productVersion) => {
                    const option = document.createElement('option');
                    option.value = productVersion.Version || '';
                    option.textContent = productVersion.Version || '';
                    productVersionSelect.appendChild(option);
                });
                if (versions.some(version => version.Version === previousValue)) {
                    productVersionSelect.value = previousValue;
                } else if (versions.length > 0) {
                    productVersionSelect.value = versions[0].Version || '';
                }
            }

            function updateSoftwareVersionOptions() {
                if (!softwareVersionSelect) {
                    return;
                }

                const product = selectedProduct();
                const productVersion = findProductVersion(product, productVersionSelect?.value || selectedProductVersion);
                const softwareVersions = Array.isArray(productVersion?.SoftwareVersions) && productVersion.SoftwareVersions.length > 0
                    ? productVersion.SoftwareVersions
                    : productVersion?.SoftwareVersion
                        ? [{ SoftwareVersion: productVersion.SoftwareVersion, SoftwareReleaseDate: productVersion.SoftwareReleaseDate, SoftwareLatestUpdate: productVersion.SoftwareLatestUpdate }]
                        : [];
                const previousValue = softwareVersionSelect.value;
                softwareVersionSelect.innerHTML = '';
                softwareVersions.forEach((softwareVersion) => {
                    const option = document.createElement('option');
                    option.value = softwareVersion.SoftwareVersion || '';
                    option.textContent = softwareVersion.SoftwareVersion || '';
                    option.dataset.releaseDate = softwareVersion.SoftwareReleaseDate || '';
                    option.dataset.latestUpdate = softwareVersion.SoftwareLatestUpdate || '';
                    softwareVersionSelect.appendChild(option);
                });
                if (softwareVersions.some(version => version.SoftwareVersion === previousValue)) {
                    softwareVersionSelect.value = previousValue;
                } else if (softwareVersions.length > 0) {
                    softwareVersionSelect.value = softwareVersions[0].SoftwareVersion || '';
                }
            }

            updateProductVersionOptions();
            updateSoftwareVersionOptions();
            productVersionSelect?.addEventListener('change', updateSoftwareVersionOptions);

            const batteryImageSelect = form.querySelector('[data-battery-image-select]');
            const categoryInput = form.querySelector('[data-image-category]');
            if (!batteryImageSelect || !categoryInput) {
                return;
            }

            function syncCategoryFromImage() {
                const selectedOption = batteryImageSelect.options[batteryImageSelect.selectedIndex];
                categoryInput.value = selectedOption?.dataset.imageCategory ?? '';
            }

            syncCategoryFromImage();
            batteryImageSelect.addEventListener('change', syncCategoryFromImage);
        })();
    </script>
}
