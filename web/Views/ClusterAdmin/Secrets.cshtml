@model BatteryPassWeb.Models.ViewModels.AdminClusterViewModel
@{
    ViewData["Title"] = "Battery Secrets";
}
<main class="bp-page bp-admin-page">
    <div class="d-flex justify-content-between flex-wrap gap-2 align-items-end">
        <div>
            <h1 class="mb-1">Battery secrets</h1>
            <p class="text-secondary mb-0">Manage per-battery optional secrets for batteries in your administered clusters.</p>
        </div>
        <a href="/cluster-admin/passports" class="bp-secondary-button">Back to passports</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success mb-0">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mb-0">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.GeneratedCredential))
    {
        <div class="alert alert-warning mb-0">
            <strong>Generated secret (store now):</strong>
            <code>@Model.GeneratedCredential</code>
        </div>
    }

    <div class="bp-credential-stack">
        <section class="bp-card bp-credential-panel">
            <div class="bp-credential-panel-header">
                <h2 class="h5 mb-0">Create or replace secret</h2>
            </div>
            <form method="post" action="/cluster-admin/secrets/upsert" class="bp-credential-form-grid bp-secret-form-grid">
                @Html.AntiForgeryToken()
                <label class="bp-secret-passport-field">
                    Battery passport
                    <select name="passportId" required>
                        @foreach (var passport in Model.Passports)
                        {
                            <option value="@passport.PassportId">@passport.DisplayName (@passport.PassportId)</option>
                        }
                    </select>
                </label>
                <div class="bp-credential-actions">
                    <button type="submit" class="bp-primary-button">Create or replace secret</button>
                </div>
            </form>
        </section>

        <section class="bp-card bp-table-card">
            <div class="bp-table-scroll">
                <table class="table table-hover align-middle bp-credential-table">
                    <thead>
                        <tr>
                            <th>Passport</th>
                            <th>Cluster</th>
                            <th>Active</th>
                            <th>Updated</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.BatterySecrets.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="bp-table-empty">No battery secrets have been created.</td>
                            </tr>
                        }
                        @foreach (var secret in Model.BatterySecrets.OrderBy(secret => secret.PassportId, StringComparer.OrdinalIgnoreCase))
                        {
                            var statusClass = secret.IsActive ? "bp-status-pill is-active" : "bp-status-pill is-inactive";
                            <tr>
                                <td><code class="bp-code-wrap">@secret.PassportId</code></td>
                                <td>@secret.ClusterLabel</td>
                                <td><span class="@statusClass">@(secret.IsActive ? "Active" : "Inactive")</span></td>
                                <td>@secret.UpdatedAt</td>
                                <td>
                                    <div class="bp-action-row">
                                        <form method="post" action="/cluster-admin/secrets/regenerate">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="passportId" value="@secret.PassportId" />
                                            <button type="submit" class="bp-secondary-button">Regenerate</button>
                                        </form>
                                        <form method="post" action="/cluster-admin/secrets/set-active">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="passportId" value="@secret.PassportId" />
                                            <input type="hidden" name="isActive" value="@(secret.IsActive ? "false" : "true")" />
                                            <button type="submit" class="bp-danger-button">@(secret.IsActive ? "Deactivate" : "Activate")</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
