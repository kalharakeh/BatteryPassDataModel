@model BatteryPassWeb.Models.ViewModels.BatteryTablePageViewModel
@{
    ViewData["Title"] = "Managed passports";
}
<main class="bp-page bp-admin-page bp-registry-page">
    <header class="bp-console-header">
        <div>
            <h1>Managed passports</h1>
            <p class="text-secondary mb-0">@Model.ScopeLabel</p>
        </div>
    </header>

    <nav class="bp-local-admin-nav" aria-label="Local admin tabs">
        <div class="bp-tab-row">
            <a class="bp-tab bp-tab-active" href="/cluster-admin/passports">Managed passports</a>
            <a class="bp-tab" href="/cluster-admin/users">Users</a>
            <a class="bp-tab" href="/cluster-admin/api-tokens">API token management</a>
        </div>
    </nav>

    <section class="bp-console-toolbar">
        <form action="@Model.SearchAction" class="bp-search-form">
            <input
                name="q"
                value="@Model.Query"
                placeholder="@Model.SearchPlaceholder" />
            <button type="submit">Search</button>
        </form>
    </section>

    @await Html.PartialAsync("_BatteryTable", Model)
</main>
