@using BatteryPassWeb.Services
@{
    // The one Help place (step 3e): each reader sees only the parts for their role. The team's workflow used to be its
    // own page under the admin tabs (/help/team and /admin/help now lead here). Step 6b-1: a part for every kind of
    // reader of design 5.2, the statuses in words, and printing.
    ViewData["Title"] = "Help";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isTeam = User.IsInRole(AccessControlService.RoleAdmin);
    var runsACluster = isTeam || User.IsInRole(AccessControlService.RoleClusterAdmin);
    var inACluster = !isTeam && !runsACluster && User.IsInRole(AccessControlService.RoleNormalUser);
    var isMsa = User.IsInRole(AccessControlService.RoleMarketSurveillanceAuthority);
    var authorityOrInterest = new[]
    {
        (Role: AccessControlService.RoleNotifiedBody, Who: "Notified body", Sees: "the shared values (materials, dismantling manuals, part numbers, spare parts, safety measures) and the authorities' values: the economic operator's and manufacturer's IDs, the service provider and the test reports; not the purchaser's values"),
        (Role: AccessControlService.RoleCommission, Who: "Commission", Sees: "the shared values (materials, dismantling manuals, part numbers, spare parts, safety measures) and the authorities' values; not the purchaser's values"),
        (Role: AccessControlService.RoleLiRepair, Who: "Repair, repurposing and remanufacturing", Sees: "the materials, the dismantling manuals, the part numbers, the spare parts sources and the safety measures"),
        (Role: AccessControlService.RoleLiRecycling, Who: "Recycling and battery treatment", Sees: "the materials, the dismantling manuals and the safety measures"),
        (Role: AccessControlService.RoleLiTreatment, Who: "Authorised treatment and WEEE facilities", Sees: "the safety measures"),
    }.Where(role => User.IsInRole(role.Role)).ToArray();
}
<main class="bp-page bp-help-page">
    <link rel="stylesheet" href="~/css/bp-product-data.css" asp-append-version="true" />
    <div class="bp-admin-heading">
        <h1>Help</h1>
        <p>How the battery passport works, for you.</p>
    </div>

    <div class="bp-help-layout mt-4">
        @await Html.PartialAsync("_HelpContents", "guide")
        <div class="bp-help-parts">
            <section class="bp-card bp-help-part" id="find">
                <h2>Find a passport</h2>
                <p class="mb-0">On the <a href="/">home page</a>, type the battery's serial number, battery ID or passport ID, or scan the QR code on the battery. A label scanned before its battery's passport is published says "Not published yet". @(signedIn ? "The Registry lists the batteries you may open." : "Signed in, the Registry also lists the batteries you may open. No account yet? Ask your contact at Scania.")</p>
            </section>

            <section class="bp-card bp-help-part" id="see">
                <h2>What each reader sees</h2>
                <dl class="bp-word-list">
                    <dt>Everyone</dt>
                    <dd>The public page: the public values, the document links and the family's picture.</dd>
                    <dt>The battery's cluster, market surveillance</dt>
                    <dd>Also the purchaser values, such as state of charge, temperature, battery status and accident reports.</dd>
                    <dt>Repair, recycling, treatment, notified bodies, Commission</dt>
                    <dd>Also the shared values meant for them.</dd>
                    <dt>Notified bodies, market surveillance, Commission</dt>
                    <dd>Also the authorities' values, such as test reports.</dd>
                </dl>
                <p class="mt-3">Signed in, the passport's detail page shows one section per group you belong to. Each value says when it was measured or entered, and how.</p>
                <p><strong>Verified.</strong> Each passport is signed when it is published. "Verified" means two things: the data still matches what was signed, and the signature was made with a key this site knows. "Not verified" says why: <em>the data doesn't match its signature</em>, or <em>it was signed with a key this site doesn't know</em>. Less often the passport has no signature ("Not signed") or its signature can't be read.</p>
                <p><strong>The public part as data.</strong> Anyone can read a published passport's public part as data, without an account: ask its public address for JSON (<code>Accept: application/json</code>), or add <code>.json</code> to the address. It holds what the public page shows, with the site's signature over it, which an outsider can check against the site's key at <code>/.well-known/did.json</code>. The <a href="/help/api">API reference</a> says how to check it.</p>
                <p><strong>Restricted data.</strong> The values only some readers may see (the purchaser, shared and authorities' values, and the restricted documents) come with a short notice: they are shared with you under the Battery Regulation for your role, so don't pass them on or keep them longer than you need them. The first time a reader opens restricted data of a battery on a day, the team's audit log records it (who, which battery, which sections, never the values); opening it again that day adds nothing. The battery's own team and cluster admins see no notice and leave no line.</p>
                <p class="mb-0"><strong>A removed passport.</strong> When the team removes the passport of a recycled or exported battery, every address of it says "This battery's passport no longer exists. It was removed after the battery was recycled or exported."</p>
            </section>

            <section class="bp-card bp-help-part" id="statuses">
                <h2>Statuses</h2>
                <p>Every passport page shows two badges. <strong>Battery</strong> (square tag) says what has happened to the battery; only the battery's cluster, market surveillance and the team see it. <strong>Passport</strong> (round pill) says whether this passport is the one that counts; everyone sees it.</p>
                @await Html.PartialAsync("_StatusMeanings")
            </section>

            @* Signed out, the Help is the three parts above (the owner, Q1 of step 6b). *@
            @if (signedIn)
            {
                <section class="bp-card bp-help-part" id="print">
                    <h2>Print a passport</h2>
                    <p class="mb-0">Print the public page or the detail page from the browser (Ctrl+P), or save it as PDF. The paper copy starts with the QR code, the page's address and when it was printed, and shows every section open. Live values print as their latest readings.</p>
                </section>
            }

            @if (signedIn)
            {
                <section class="bp-card bp-help-part" id="account">
                    <h2>Your account</h2>
                    <p>Under Account at the top, you can change your name, your e-mail and your password. To change your password or your e-mail, type your current password too. A new password has at least 12 characters.</p>
                    <p>After ten wrong passwords in 15 minutes from one place, that place can't sign in to the account for 15 minutes; you still can from anywhere else. After 50 wrong passwords from all places together, the account can only be signed in to from a place it was signed in from before. Every refusal says "Invalid email or password. Try again later." The temporary password from "Forgot password" always works, and choosing a new password, or the team setting one, unlocks the account at once.</p>
                    <p class="mb-0">When the team changes your access, it applies on your next page. When someone else sets your password, or your account is deleted, you are signed out.</p>
                </section>
            }

            @if (inACluster)
            {
                <section class="bp-card bp-help-part" id="your-batteries">
                    <h2>Your cluster's batteries <span class="bp-soft-tag">Cluster users</span></h2>
                    <ol class="bp-steps">
                        <li><strong><a href="/registry">The Registry</a></strong><p>Lists your cluster's batteries, each with its two badges. Its icons open the battery's public page and detail page.</p></li>
                        <li><strong>The detail page</strong><p>The purchaser values, the repair history and the shared values. "Live values" shows the last week's readings as small charts; "Modules" lists the battery's modules.</p></li>
                        <li><strong>Changes</strong><p>Your cluster admins correct live values, add accident reports, record repairs and hand batteries over. Ask them, or the manufacturer's team.</p></li>
                    </ol>
                </section>
            }

            @if (isMsa)
            {
                <section class="bp-card bp-help-part" id="msa">
                    <h2>Market surveillance <span class="bp-soft-tag">Market surveillance</span></h2>
                    <ol class="bp-steps">
                        <li><strong><a href="/registry">Every published passport</a></strong><p>The Registry lists them all, invalid and marked ones included. The detail page shows every section: purchaser, shared and authorities' values, the live values and the modules.</p></li>
                        <li><strong>Mark as invalid…</strong><p>On an active passport's detail page, press "Mark as invalid…" in the Purchaser card: give the reason, then confirm. The public page then says the passport is invalid, with the date. The reason is seen only by you and the manufacturer's team, and only the team can undo it. An invalid passport takes no new versions, status changes or live values.</p></li>
                    </ol>
                </section>
            }

            @if (authorityOrInterest.Length > 0)
            {
                <section class="bp-card bp-help-part" id="your-access">
                    <h2>What your account adds</h2>
                    <dl class="bp-word-list">
                        @foreach (var role in authorityOrInterest)
                        {
                            <dt>@role.Who</dt>
                            <dd>Besides the public values: @role.Sees.</dd>
                        }
                    </dl>
                    <p class="mt-3 mb-0">The <a href="/registry">Registry</a> lists every published passport; open its detail page to see these values. The manufacturer's team gives this access to named accounts.</p>
                </section>
            }

            @if (signedIn && !runsACluster)
            {
                <section class="bp-card bp-help-part" id="access">
                    <h2>Need more access?</h2>
                    <p class="mb-0">If you should see more than you do, ask your cluster admin or the manufacturer's team.</p>
                </section>
            }

            @if (runsACluster)
            {
                <section class="bp-card bp-help-part" id="cluster">
                    <h2>Your cluster <span class="bp-soft-tag">Cluster admins</span></h2>
                    <ol class="bp-steps">
                        <li><strong><a href="/cluster-admin/users">Add your people</a></strong><p>Under Cluster admin, Users: "Add user" makes an account for a new address, as a user (sees your cluster's batteries) or as a cluster admin (also looks after its users and tokens). If the person already has an account, they are only added to your cluster: their name and password stay as they are. You can change the name and password only of people who are in your clusters alone and have no role across the app; for anyone else, ask the team. The x beside a cluster asks first, then removes the person from that cluster.</p></li>
                        <li><strong><a href="/cluster-admin/api-tokens">Give your systems a token</a></strong><p>Under Cluster admin, API tokens: "Read" reads your batteries' passports; "Read + write" also sends their live values, and a published battery then gets a new version by itself, as when the team saves. A cluster token is always one of these two; publishing by call is for the team's tokens. Copy the value when it is shown: it is shown once.</p></li>
                        <li><strong><a href="/registry">Check what they see</a></strong><p>Your users find your cluster's batteries in the Registry, with the purchaser values on the detail page.</p></li>
                    </ol>
                </section>

                <section class="bp-card bp-help-part" id="look-after">
                    <h2>Look after a battery <span class="bp-soft-tag">Cluster admins</span></h2>
                    <p>In the <a href="/registry">Registry</a>, a battery's icon opens its page; its side menu has one section at a time.</p>
                    <p>Your cluster changes passport data (status, live values, accident reports, hand-overs, uploads) once the Scania team has recorded its written authorisation. Until then you can read everything, and the battery page says so. Declining or cancelling a hand-over works without it; accepting needs both clusters' authorisation.</p>
                    <dl class="bp-word-list">
                        <dt>Live values</dt>
                        <dd>Correct the state of charge, cycles, temperature and the extreme-temperature times. The battery system usually sends them. When saved changes can't be published yet, the battery's overview says "Saved changes are waiting: the public passport still shows version N" and lists what is missing; once it is added, the passport gets its new version.</dd>
                        <dt>Accident reports</dt>
                        <dd>"Add a report" uploads one; the passport's accident page lists them for its readers. A report added by mistake is withdrawn by the team.</dd>
                        <dt>Change status</dt>
                        <dd>"What happened?": Repaired, Prepared for re-use and placed on the market again, Remanufactured, Repurposed or Waste. The window asks for the re-stated fades and lifetime, filled in with the current ones. A repair keeps the passport and adds to its repair history. The three that place the battery on the market again lead to a new linked passport, from Scania or another operator. Waste asks a second question ("Is it waste?" with "Yes, it is waste" or "No, go back") before it is saved, and it is final for you: only the team can undo it. A status change makes a new version, so when the passport can't get one yet (a value it needs is missing, or its model's three questions aren't answered), the Status section says "No status change can be made now", names what is missing and who adds it, and doesn't offer "Change status". Notes, live values, accident reports and hand-overs are not affected.</dd>
                        <dt>Add a note</dt>
                        <dd>A correction to the repair history; nothing in the history is changed or removed.</dd>
                        <dt>Hand over…</dt>
                        <dd>Type the receiving cluster's ID; the app shows its name to confirm. Until its admins accept on their Registry's "Waiting for you" card, the battery stays yours. Afterwards your cluster no longer sees its purchaser values.</dd>
                        <dt>Waiting for you</dt>
                        <dd>A battery another cluster hands to you: Accept or Decline.</dd>
                    </dl>
                    <p class="mt-3 mb-0">A passport that is invalid, marked for deletion or replaced by a new passport is read only.</p>
                </section>

                <section class="bp-card bp-help-part" id="upload">
                    <h2>Upload a file <span class="bp-soft-tag">Team and cluster admins</span></h2>
                    <p>On a battery's page, "Upload a file" takes one JSON file for that battery: the app's upload format, or the battery system's export as it is. You see what would change before anything is saved. A marked or earlier passport takes no file.</p>
                    <ul>
                        <li><a href="/help/samples/@BatteryPassWeb.Dpp.Uploads.UploadSamples.UploadFileName" download>An upload file</a>: live values and a repair, with one re-stated value, for the demo battery @BatteryPassWeb.Dpp.Uploads.UploadSamples.Serial. A status change goes in the same way: <code>"batteryStatus": "waste"</code> (or re-used, remanufactured, repurposed) among the values.</li>
                        <li><a href="/help/samples/@BatteryPassWeb.Dpp.Uploads.UploadSamples.ExportFileName" download>A battery system export</a> (mapping BMS2_ACO) of the same demo battery, with made-up values.</li>
                    </ul>
                    <p>A value the app keeps itself, such as the accident link (#92), is never changed by a file: it shows "Not saved". "Check the file" shows a battery's current value only for values you may see.</p>
                    <p class="bp-help-text mb-0">Status changes and repairs are made on the battery's page only; the API refuses them. Many batteries in one file go through the API's upload.</p>
                </section>
            }

            @if (isTeam)
            {
                <section class="bp-card bp-help-part" id="team-users">
                    <h2>Accounts <span class="bp-soft-tag">Team</span></h2>
                    <p>"Add user" is for new addresses; change an existing account from its row. Giving an account access across the app needs a new password in the same step. A new password has at least 12 characters. Your own access, and the last team account's access, can't be lowered. The x beside a cluster asks first, then removes the person from it.</p>
                    <p class="mb-0">Deleting an account, lowering its access, removing it from a cluster or changing its password ends its open sessions on their next page.</p>
                </section>

                <section class="bp-card bp-help-part" id="workflow">
                    <h2>From product data to a published passport <span class="bp-soft-tag">Team</span></h2>
                    <ol class="bp-steps">
                        <li><strong><a href="/admin/families">Set up product data</a></strong><p>Families, models and batches, and <a href="/admin/sites-and-operators">sites and operators</a>. Most values are entered once and shared by every battery made from them; the V3 attribute list decides which are required, and by when. Each model also answers three questions on its page: does this battery come with a commercial warranty, is it made for cycling use, and is its cadmium or lead above the limit for the symbols. A "yes" makes the matching values needed before publishing; the answers are not shown in the passport. Until all three are answered ("Not answered yet"), the model's batteries can't be published and its published batteries get no new version. Saving a "yes" that a published battery lacks the values for asks first. The quickest way to enter a whole family is <a href="/admin/product-data-load">Load product data from Excel</a> (the next part). A family, site or operator copied from the demo data with "Copy as real product data" keeps the demo's example values and files until you replace them; the pages list them, and a battery with a real ID isn't published for the first time while its passport holds one (a test ID is).</p></li>
                        <li><strong><a href="/admin/battery-ids">Release battery IDs</a></strong><p>Reserve the serial numbers before the batteries are made, so their labels can be printed. Each gets its battery ID at once, fixed for life.</p></li>
                        <li><strong><a href="/admin/batteries/new">Create the battery</a></strong><p>Choose its batch, economic operator and cluster, and pick its serial number from the released IDs; then its manufacturing date and warranty (a whole number of years, 1 to 100, or of months, 1 to 1200). It can take the battery system's export too: its state of charge and cycles become the first values, and the module list is set. The export has no temperature yet, so type it on the battery's page ("#87 Temperature information"); the export's production date counts only when it can be true. A real battery ID can't be used with demo product data (batch, model or operator): use a test ID, or make real product data with "Copy as real product data". It starts as a draft only the team sees, with its battery ID and QR code.</p></li>
                        <li><strong><a href="/admin/batteries">Fill in what is missing</a></strong><p>Every field says whether it is required by Feb 2027, required later or conditional. A conditional field says whether this model needs it, from the model's three questions. Required values block publishing, the first state of charge and temperature included, and so does a model whose questions aren't answered. The rated capacity (#57) is needed before publishing too, although the official list says "not by February 2027".</p></li>
                        <li><strong>Publish</strong><p>On the battery page, one step checks the passport against the official schema, signs it and publishes it. Later changes ask first, then publish a new version, and the message says which passports got one and which kept their version and why; live values and accident reports change it in place.</p></li>
                    </ol>
                    <p class="mt-3 mb-0">Other systems get <a href="/admin/clusters?tab=api-token-management">API tokens</a>: a cluster token reads that cluster's batteries and, with "Read + write", sends their live values; only a token for all batteries creates and publishes them. A cluster token can only be "Read" or "Read + write". Tokens made earlier with more rights stay, listed with what they can still do; the team can "Replace" one: it gets a new token and the old one is switched off.</p>
                </section>

                <section class="bp-card bp-help-part" id="load-excel">
                    <h2>Load product data from Excel <span class="bp-soft-tag">Team</span></h2>
                    <p>On <a href="/admin/families">Battery families</a> (and on Sites and operators), "Load product data from Excel" takes the filled product data workbook, with the documents and pictures it names, and enters a whole family at once: the family, its models, their batches, the sites, the operators, the hazardous substances and the documents. "Download the empty workbook" on that page gives the workbook to fill.</p>
                    <ol class="bp-steps">
                        <li><strong>Choose the files</strong><p>The filled workbook (.xlsx) and the documents and pictures it names, up to 40 files and 100 MB in one load.</p></li>
                        <li><strong>Check</strong><p>Shows what would be saved, with each value and its unit, and every problem by sheet, row and column, in words ("Models, Battery mass, Core700: 4,7 is not a number; type the number only, with a point for decimals."). Nothing is saved. Numbers are typed as numbers, and a yes or no is chosen from the cell's list. A value that is still the demo's example (an example.com link, "(demo)") is a problem. Fix the workbook and check again.</p></li>
                        <li><strong>Load</strong><p>Saves everything the check showed, or nothing. It goes through the same checks as the forms. If something stops it, the page says whether anything was saved: "Nothing was saved. Load again when the fault is gone", or a list of what it had started to change and "Load again to finish". If the workbook, the files or the app's data changed since the check, nothing is loaded and you see a fresh check.</p></li>
                    </ol>
                    <dl class="bp-word-list">
                        <dt>Empty and "none"</dt>
                        <dd>An empty cell changes nothing. For a model after the first, an empty cell means the first model's value; its name is always its own. The word <code>none</code> removes a value, unless a published passport needs it: the check says so.</dd>
                        <dt>Taken from the first model</dt>
                        <dd>A value a later model takes over from the first model's column is marked on its line in the check ("taken from Core800"). That includes the four recycled-content shares: an empty share of a later model takes the first model's, so write <code>none</code> when that model has none. An empty batch column is a full copy of the first model's batch, its year and site included, and the check says so. A workbook has one batch per model: add another on the model's page, or in a second load.</dd>
                        <dt>Documents still to come</dt>
                        <dd>A document the workbook names but you haven't got yet doesn't stop the load. It is listed under "Documents still to come", everything else is saved, and the document can follow in a later load.</dd>
                        <dt>A second load</dt>
                        <dd>Loading the same workbook again updates: it changes only what differs ("Core800s, Battery mass, 470 → 455"), matches names without regard to capitals, and says "Nothing to load" when nothing differs. A document is uploaded again only when its file, title or language changed. An uploaded document can't be removed with <code>none</code>; the forms can't either.</dd>
                        <dt>Serial number format</dt>
                        <dd>The workbook can give each model its serial number format (such as VPC8C05s-#####). The check shows the old and the new format and how many batteries of the model don't fit it, and the load applies the model page's own rule. <code>none</code> removes the format. A model never takes the first model's format: an empty cell leaves it as it is. It can also be set on the model's page.</dd>
                        <dt>New versions</dt>
                        <dd>The check says how many published passports a load gives a new version, as the forms would. Pressing Load is the yes the forms ask for.</dd>
                        <dt>Published passports change</dt>
                        <dd>Before Load, the check says how many published batteries the load reaches, how many new versions each gets and which parts of the workbook reach them (a battery gets one version per saved part: a record's values, each uploaded document). If a load stops part way, those batteries stay on a version with only some of the changes until the workbook is loaded again.</dd>
                        <dt>What stops a load</dt>
                        <dd>Any problem line in the check. Also two columns with the same heading (the check names both columns' letters) and a filled column without a heading, a file that isn't a real .xlsx or is damaged, more than 40 files or 100 MB, a date or a formula without a value where a number belongs, and a sheet that lacks a column of the empty workbook.</dd>
                        <dt>Not in the workbook</dt>
                        <dd>The values of each battery (for example #13, the third party service provider) are typed on the battery's page.</dd>
                    </dl>
                </section>

                <section class="bp-card bp-help-part" id="battery-ids">
                    <h2>Battery IDs <span class="bp-soft-tag">Team</span></h2>
                    <p>A battery's ID (#6) is the company's DUNS, a dash and its serial number as written, such as <code>UN778474481-VPC-12221</code>. The team releases serial numbers in advance on the <a href="/admin/battery-ids">Battery IDs</a> tab, and each battery is created from one. At the top, the real IDs by status (test IDs aren't counted) and "Release new IDs"; below, three tabs: Releases, All IDs and Release new IDs.</p>
                    <dl class="bp-word-list">
                        <dt>Release new IDs</dt>
                        <dd>Give a reference, such as the purchase order, and optionally the model. Add one or more ranges (start, end and quantity) or paste serial numbers, one per line. A serial number holds letters, digits and single dashes only, at most 34 characters. Capital and small letters count as the same: VPC8C05s-00001 and VPC8C05S-00001 are one serial number. It is kept and shown as you typed it, in the battery ID and the passport ID too (UN778474481-VPC8C05s-00001); an address typed in other capitals opens the same passport. One that differs from another only in its dashes or in capital and small letters is refused. A model can have a serial number format on its page, such as VPC8C05s-##### with # for one digit: IDs released for that model, a battery made of it and a draft that swaps its ID must fit it, so a serial number of one model can't end up on another. A model without a format takes any serial number, and test IDs aren't checked. It is all or nothing: if one can't be released, none is, and each reason is listed. Once released, the app opens the release's page. Tick "Test IDs" to release IDs for trying things out: they contain TEST, are never real battery IDs, are for any model (the model is ignored), can be used on real product data, aren't counted, and go with their batteries when "Clear demo data" on the Clusters tab is used (it stays on offer where the demo is switched off, and says how many go).</dd>
                        <dt>Releases</dt>
                        <dd>The first tab: one row per release, with its reference, model, date and counts. "Open" shows the release's page: its IDs, "Export to Excel" at the top and "Void unused…". The demo data's release is tagged Demo. A release whose IDs are all voided shows only with "Show voided" ticked; its page still lists every ID.</dd>
                        <dt>All IDs</dt>
                        <dd>Every released ID, searched by serial number and filtered by status, release and model. Test IDs show only with "Show test IDs" ticked, and voided IDs only with "Show voided" ticked or the status Voided chosen.</dd>
                        <dt>Export to Excel</dt>
                        <dd>One row per ID, with the QR code's full address for the label printer or a mail merge. On a release's page or row, all of that release's IDs; on All IDs, the ones shown.</dd>
                        <dt>Statuses</dt>
                        <dd>Available, Used (a draft has it), Published (fixed for life) and Voided (never used again).</dd>
                        <dt>Void…</dt>
                        <dd>Only an available ID, with a reason such as a damaged label: in its row's ⋯ menu. "Void unused…" voids a release's available IDs at once.</dd>
                        <dt>A red notice</dt>
                        <dd>"The battery ID settings aren't set": the app isn't given its DUNS and web address (<code>DPP_ID_AGENCY</code>, <code>DPP_ID_COMPANY</code>, <code>DPP_ID_BASE_URL</code>), so nothing can be released and no battery can be created from a released ID, as they would get test IDs. Whoever runs the app sets them and restarts it. The demo data works without them.</dd>
                        <dt>A released ID the app says another battery has</dt>
                        <dd>If a released ID is the same, apart from capitals and dashes, as the ID of another battery, the app refuses to use it and names that battery. Void the released ID on this page, with a reason, and use another.</dd>
                        <dt>Change its battery ID…</dt>
                        <dd>On a draft's page, under More: it takes another available ID, and its old one is available again. Removing a draft gives its ID back too.</dd>
                        <dt>A new passport</dt>
                        <dd>The battery keeps its serial number, and its new passport's battery ID adds -R1, -R2, …; it isn't released.</dd>
                    </dl>
                </section>

                <section class="bp-card bp-help-part" id="lifecycle">
                    <h2>After publishing <span class="bp-soft-tag">Team</span></h2>
                    <dl class="bp-word-list">
                        <dt>Everything a cluster admin does</dt>
                        <dd>Live values, accident reports, status changes, notes and uploads, on any battery. Only the team gets "Correct the values" in the status window: the status stays, and a new version is published. Only the team gets "Undo the waste" there: give a reason, and the battery goes back to the status it had before.</dd>
                        <dt>Saved changes are waiting</dt>
                        <dd>A published battery whose saved data differs from its public passport, because a missing value or an unanswered model question holds back the new version. The battery's overview says so and lists what is missing; the battery list names these batteries. Once nothing is in the way, "Publish the waiting changes" on the battery's page publishes it (most ways of saving do it by themselves).</dd>
                        <dt>Check all passports now</dt>
                        <dd>On the battery list (team only). The app also does this shortly after it starts and every hour: it compares every published battery's saved data with its public passport, puts the waiting marks right and archives all but the newest active version. It never publishes anything itself. The line it gives says how many batteries it checked and what it put right.</dd>
                        <dt>Withdraw…</dt>
                        <dd>On the Accident reports section, beside a report added by mistake (team only): give a reason and confirm. The report disappears from the accident page and its file is deleted. The audit log keeps who, when, why and the file's name; the cluster's history shows one line.</dd>
                        <dt>A new passport</dt>
                        <dd>After "placed on the market again", "Remanufactured" or "Repurposed", the battery page asks who places it on the market. Scania's new passport starts from the old battery as a draft; publishing it makes the old one inactive. Another operator's passport is linked by its ID or web address. Until then, the team can cancel the new passport.</dd>
                        <dt>More: Mark as invalid or for deletion…</dt>
                        <dd>Invalid, with a reason, for an active passport; for deletion, for a waste battery after recycling. The header then shows the reason and the one Undo.</dd>
                        <dt>Remove the passport…</dt>
                        <dd>On the marked-for-deletion line, next to Undo: once the battery is recycled or exported, the team can remove the passport, with its earlier passports. Everything the app holds about it is deleted, except a marker for its IDs and one audit entry, and its addresses then say "This battery's passport no longer exists. It was removed after the battery was recycled or exported." The window lists the earlier passports that go with it and asks for the battery's ID; it can't be undone, and the IDs are never used again. If a removal is interrupted, the battery's page offers "Finish removing"; the hourly check finishes it too. Undo isn't offered once a removal has started.</dd>
                        <dt>EU registry</dt>
                        <dd>A published real battery's page has an "EU registry" section. Once you have registered the battery in the EU's DPP Registry, record the day and the registration ID there; it is not part of the passport. The battery list says how many published batteries aren't recorded yet and gives them as a CSV to type into the Registry. Only your team sees this.</dd>
                        <dt><a href="/admin/clusters?tab=clusters">Written authorisation</a></dt>
                        <dd>Open a cluster on the Clusters tab to record its written authorisation to update passport data, with the date it was given, or to take it away. New clusters start without it, and so does every cluster from before this was added. Without it the cluster's admins and tokens read but change nothing (a token gets 403). A hand-over is accepted only when both clusters are authorised.</dd>
                        <dt>Cluster: Change</dt>
                        <dd>Moves a battery to another cluster at once, logged; or cancel a waiting hand-over.</dd>
                        <dt><a href="/admin/clusters?tab=clusters">Demo data</a></dt>
                        <dd>At the end of the Clusters tab: "Reset demo data" makes the demo clusters, accounts, tokens and batteries again; "Clear demo data" removes them and keeps real data. A battery is inside the demo only when the battery, its batch, model and operator are demo and its cluster is a demo cluster or none. Demo accounts and demo tokens work only inside the demo. A demo-numbered battery made on real product data is allowed, so the team can try things out, but demo accounts then see it as a visitor does; and for anything outside the demo a demo token gets the same answer as for an ID that does not exist. "Reset demo data" stops and changes nothing when a real account, battery or API token uses one of the demo's clusters, and names that cluster; demo accounts a demo admin added or made never stop it. The live site has the demo switched off (it holds real product data only): the card then says so, demo accounts and tokens stop working, and only "Clear demo data" is offered. Test batteries are made on the real families with test IDs.</dd>
                    </dl>
                </section>

                <section class="bp-card bp-help-part" id="ready">
                    <h2>Before you call a battery ready <span class="bp-soft-tag">Team</span></h2>
                    <ul class="mb-0">
                        <li>The model, batch, site and operator are complete, and the model's three questions are answered.</li>
                        <li>The battery's own values and first live values are in.</li>
                        <li>Nothing blocks publication, and the battery says "Published" with the latest version.</li>
                        <li>The QR code opens the public page.</li>
                    </ul>
                </section>
            }

            @if (signedIn)
            {
                <section class="bp-card bp-help-part" id="api">
                    <h2>API reference and workbench</h2>
                    <p class="mb-2">Every call, with examples for the demo clusters (<code>demo-north</code>, <code>demo-south</code>, <code>demo-fleet</code>), and a workbench to try a call with a token.</p>
                    <a class="bp-secondary-button bp-button-compact" href="/help/api">Open the API reference</a>
                </section>
            }
        </div>
    </div>
</main>
