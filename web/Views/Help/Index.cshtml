                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">GET</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/batteries/{batteryId}/paths?section=full</code><small>Discover readable path names</small></span></td>
                            <td><span class="bp-help-access-pill">Read</span></td>
                            <td>Find reusable paths before calling values.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-paths" aria-expanded="false" aria-controls="api-detail-paths" aria-label="Show readable paths endpoint details" title="Show readable paths endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">POST</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/batteries/{batteryId}/telemetry</code><small>Write operational points</small></span></td>
                            <td><span class="bp-help-access-pill">Read-write</span></td>
                            <td>Append current consumption, charge, voltage, or current.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-telemetry" aria-expanded="false" aria-controls="api-detail-telemetry" aria-label="Show telemetry endpoint details" title="Show telemetry endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">GET</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/batteries/{batteryId}/telemetry/history?hours=24</code><small>Recent operational history</small></span></td>
                            <td><span class="bp-help-access-pill">Read</span></td>
                            <td>Review telemetry history for 1 to 168 hours.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-history" aria-expanded="false" aria-controls="api-detail-history" aria-label="Show telemetry history endpoint details" title="Show telemetry history endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">PATCH</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/batteries/{batteryId}/operations</code><small>Writable operations metadata</small></span></td>
                            <td><span class="bp-help-access-pill">Read-write</span></td>
                            <td>Patch site, contact, or active-state metadata.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-operations" aria-expanded="false" aria-controls="api-detail-operations" aria-label="Show operations endpoint details" title="Show operations endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">PATCH</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/batteries/{batteryId}/battery-model</code><small>New passport required</small></span></td>
                            <td><span class="bp-help-access-pill">Read-write</span></td>
                            <td>Move a battery to another saved Battery Model.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-model" aria-expanded="false" aria-controls="api-detail-model" aria-label="Show battery model endpoint details" title="Show battery model endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">PATCH</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/batteries/{batteryId}/software-version</code><small>New passport may be required</small></span></td>
                            <td><span class="bp-help-access-pill">Read-write</span></td>
                            <td>Move a battery to a software version defined for its Battery Model.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-model" aria-expanded="false" aria-controls="api-detail-model" aria-label="Show software version endpoint details" title="Show software version endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">POST</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/batteries/{batteryId}/passports</code><small>Create a passport snapshot</small></span></td>
                            <td><span class="bp-help-access-pill">Passport Lifecycle</span></td>
                            <td>Create the next passport revision for a Battery ID.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-passports" aria-expanded="false" aria-controls="api-detail-passports" aria-label="Show passport creation endpoint details" title="Show passport creation endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">GET</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/batteries/{batteryId}/passports</code><small>Passport history</small></span></td>
                            <td><span class="bp-help-access-pill">Read</span></td>
                            <td>List non-archived passport snapshots for a Battery ID.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-passport-list" aria-expanded="false" aria-controls="api-detail-passport-list" aria-label="Show passport list endpoint details" title="Show passport list endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">POST</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/passports/{passportId}/validate</code><small>Validation gate</small></span></td>
                            <td><span class="bp-help-access-pill">Passport Lifecycle</span></td>
                            <td>Run trust validation before signing.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-validate" aria-expanded="false" aria-controls="api-detail-validate" aria-label="Show validate endpoint details" title="Show validate endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">POST</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/passports/{passportId}/sign</code><small>Proof creation</small></span></td>
                            <td><span class="bp-help-access-pill">Passport Lifecycle</span></td>
                            <td>Create the signed proof for the current passport core.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-sign" aria-expanded="false" aria-controls="api-detail-sign" aria-label="Show sign endpoint details" title="Show sign endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">POST</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/passports/{passportId}/publish</code><small>Public registry gate</small></span></td>
                            <td><span class="bp-help-access-pill">Passport Lifecycle</span></td>
                            <td>Publish only after validation and signing are current.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-publish" aria-expanded="false" aria-controls="api-detail-publish" aria-label="Show publish endpoint details" title="Show publish endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-api-help-detail-row" data-api-help-detail-row hidden>
                            <td colspan="5">
                                <div class="bp-api-help-selected-panel" aria-live="polite" tabindex="-1" hidden>
                <article id="api-detail-auth" class="bp-help-detail-panel" data-api-help-detail-panel>
                    <div>
                        <span class="bp-summary-title">Authentication</span>
                        <h3>Use the generated Token Value in the Authorization header.</h3>
                        <p>Required header: <code>Authorization: Basic &lt;base64(token:)&gt;</code> or <code>Authorization: Basic &lt;token&gt;</code>. Token Value is the generated API credential shown only when an admin creates or regenerates a token in API Token Management. The token ID shown in tables is not the secret credential.</p>
                    </div>
                    <div class="bp-help-code-grid">
                        <pre class="bp-help-pre"><code>Authorization: Basic &lt;base64(token:)&gt;</code></pre>
                        <ul>
                            <li><code>200 OK</code>: Request succeeded.</li>
                            <li><code>201 Created</code>: Telemetry point(s) were stored.</li>
                            <li><code>400 Bad Request</code>: Invalid input.</li>
                            <li><code>401 Unauthorized</code>: Missing or invalid API token.</li>
                            <li><code>403 Forbidden</code>: Token scope/access is not allowed, or Sign token is required/invalid.</li>
                            <li><code>404 Not Found</code>: Battery passport or requested section/path does not exist.</li>
                            <li><code>500 Server Error</code>: Unexpected server-side failure.</li>
                            <li><code>503 Service Unavailable</code>: Backend dependency is unavailable.</li>
                        </ul>
                    </div>
                </article>

                <article id="api-detail-clusters" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Clusters</span><h3>List the clusters available to the token.</h3><p>Returns cluster IDs and names for the current token scope. Global tokens include every registered cluster.</p></div>
                    <pre class="bp-help-pre"><code>GET @Model.BasePath/clusters</code></pre>
                </article>

                <article id="api-detail-cluster-batteries" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Cluster batteries</span><h3>List battery IDs in one cluster.</h3><p>Use this before reading, patching, or creating passports when an integration only knows the cluster ID.</p></div>
                    <pre class="bp-help-pre"><code>GET @Model.BasePath/clusters/demo-cluster/batteries</code></pre>
                </article>

                <article id="api-detail-battery" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Full battery</span><h3>Read the latest passport snapshot.</h3><p>Returns app metadata, aspects, registry data, schema versions, and validation details for the requested Battery ID.</p></div>
                    <pre class="bp-help-pre"><code>GET @Model.BasePath/batteries/@Model.SampleBatteryId</code></pre>
                </article>

                <article id="api-detail-section" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Sections</span><h3>Read one passport section only.</h3><p>Supported section names: <code>general</code>, <code>materialComposition</code>, <code>performance</code>, <code>circularity</code>, <code>supplyChain</code>, <code>carbonFootprint</code>, <code>compliance</code>, <code>operations</code>, <code>display</code>, <code>full</code>.</p></div>
                    <pre class="bp-help-pre"><code>GET @Model.BasePath/batteries/@Model.SampleBatteryId/section/performance
GET @Model.BasePath/batteries/@Model.SampleBatteryId/section/circularity</code></pre>
                </article>

                <article id="api-detail-values" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div>
                        <span class="bp-summary-title">Values</span>
                        <h3>Read one or more specific values.</h3>
                        <p>Aliases include <code>ratedEnergy</code>, <code>ratedCapacity</code>, <code>ratedMaximumPower</code>, <code>nominalVoltage</code>, <code>nickelMass</code>, <code>currentConsumptionKwh</code>, <code>currentChargeLevelPct</code>, <code>currentVoltageV</code>, <code>currentCurrentA</code>, <code>softwareVersion</code>, <code>softwareReleaseDate</code>, <code>softwareLatestUpdate</code>, <code>locationOfUse</code>, <code>contactPerson</code>, and <code>isActive</code>.</p>
                        <p>Need the full set of readable values? Open <a id="supported-values-link" href="@($"{Model.BasePath}/batteries/{Model.SampleBatteryId}/paths?section=full")&amp;includeContainers=true" target="_blank" rel="noopener noreferrer"><code>@Model.BasePath/batteries/@Model.SampleBatteryId/paths?section=full&amp;includeContainers=true</code></a> in a new tab.</p>
                    </div>
                    <div class="bp-help-code-grid">
                        <pre class="bp-help-pre"><code>GET @Model.BasePath/batteries/@Model.SampleBatteryId/values?path=ratedEnergy&amp;path=ratedCapacity
GET @Model.BasePath/batteries/@Model.SampleBatteryId/values?path=nickelMass
GET @Model.BasePath/batteries/@Model.SampleBatteryId/values?path=aspects.circularity.payload</code></pre>
                        <pre class="bp-help-pre"><code>{
  "message": "Values read successfully",
  "data": {
    "values": [
      { "requestPath": "ratedEnergy", "value": 102 },
      { "requestPath": "ratedCapacity", "value": 218 },
      { "requestPath": "nickelMass", "value": 138.7 }
    ]
  }
}</code></pre>
                    </div>
                </article>

                <article id="api-detail-paths" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Readable paths</span><h3>Discover paths, then reuse them with values.</h3><p>Query options: <code>section</code> and <code>includeContainers=true</code>. Copy any item from the returned <code>paths</code> array and pass it as a repeated <code>path</code> query parameter to <code>/values</code>.</p></div>
                    <pre class="bp-help-pre"><code>GET @Model.BasePath/batteries/@Model.SampleBatteryId/paths
GET @Model.BasePath/batteries/@Model.SampleBatteryId/paths?section=performance
GET @Model.BasePath/batteries/@Model.SampleBatteryId/paths?section=materialComposition&amp;includeContainers=true

# Example: read values returned from /paths?section=performance
GET @Model.BasePath/batteries/@Model.SampleBatteryId/values?path=aspects.performanceAndDurability.payload.batteryTechicalProperties.ratedEnergy&amp;path=aspects.performanceAndDurability.payload.batteryTechicalProperties.ratedCapacity

# Example: read an indexed array value discovered by /paths
GET @Model.BasePath/batteries/@Model.SampleBatteryId/values?path=aspects.materialComposition.payload.batteryMaterials.0.batteryMaterialMass

# Example: read operations objects discovered by /paths?section=operations
GET @Model.BasePath/batteries/@Model.SampleBatteryId/values?path=app.operations.locationOfUse&amp;path=app.operations.contactPerson</code></pre>
                </article>

                <article id="api-detail-telemetry" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Telemetry write</span><h3>Append one or more operational points.</h3><p>Supports a single object, an array, <code>{ "points": [...] }</code>, or a <code>series</code> object for one or more variables. Series points are sorted by timestamp; malformed points are ignored and reported without breaking the request when at least one valid point remains.</p></div>
                    <pre class="bp-help-pre"><code>{
  "points": [
    {
      "currentConsumptionKwh": 154.6,
      "currentChargeLevelPct": 82.1,
      "currentVoltageV": 401.7,
      "currentCurrentA": 49.2,
      "measuredAt": "2026-05-05T10:15:00Z"
    }
  ]
}

{
  "series": {
    "currentConsumptionKwh": [
      { "measuredAt": "2026-05-20T09:00:00Z", "value": 163.4 },
      { "measuredAt": "2026-05-20T09:05:00Z", "value": 164.1 }
    ],
    "currentVoltageV": [
      { "measuredAt": "2026-05-20T09:00:00Z", "value": 398.4 },
      { "measuredAt": "2026-05-20T09:05:00Z", "value": 399.1 }
    ]
  }
}</code></pre>
                </article>

                <article id="api-detail-history" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Telemetry history</span><h3>Read recent telemetry history.</h3><p>The <code>hours</code> value must be in <code>1..168</code>.</p></div>
                    <pre class="bp-help-pre"><code>GET @Model.BasePath/batteries/@Model.SampleBatteryId/telemetry/history?hours=24</code></pre>
                </article>

                <article id="api-detail-operations" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Operations patch</span><h3>Patch writable operations metadata.</h3><p>Writable fields are <code>locationOfUse</code>, <code>contactPerson</code>, and <code>isActive</code>.</p></div>
                    <pre class="bp-help-pre"><code>{
  "isActive": true,
  "locationOfUse": {
    "siteName": "Factory 4",
    "address": "Main street 7",
    "city": "Berlin",
    "country": "DE",
    "latitude": 52.52,
    "longitude": 13.41
  },
  "contactPerson": {
    "name": "Anna Becker",
    "email": "anna@example.test",
    "phone": "+49 30 1234"
  }
}</code></pre>
                </article>

                <article id="api-detail-model" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div>
                        <span class="bp-summary-title">Battery Model</span>
                        <h3>Battery ID, family, and software parameters</h3>
                        <p>Product Template is the internal implementation name for Battery Family. In the UI and tester workflows, Product Template and Battery Family mean the same stored template concept.</p>
                        <p>Each passport is created from a MongoDB Battery Family baseline. Battery families contain Battery Models, and each Battery Model carries software parameters such as software version, released date, and latest update values.</p>
                        <p>The software-version endpoint accepts only a software version defined for the battery's current Battery Model and copies its release date and latest update metadata. Battery Model and software changes may require a new passport when they differ from the latest passport snapshot.</p>
                    </div>
                    <pre class="bp-help-pre"><code>{ "batteryModel": "2.0" }
{ "softwareVersion": "4.0" }</code></pre>
                </article>

                <article id="api-detail-passports" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Passport snapshot</span><h3>Create a new passport snapshot.</h3><p>Create a new passport snapshot for the Battery ID after current battery data differs from the latest passport. This requires the Passport Lifecycle token. The response returns the new Passport ID; use that Passport ID for validate, sign, and publish.</p></div>
                    <pre class="bp-help-pre"><code>POST @Model.BasePath/batteries/@Model.SampleBatteryId/passports</code></pre>
                </article>

                <article id="api-detail-passport-list" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Passport list</span><h3>List battery passport snapshots.</h3><p>Returns non-archived passports for the Battery ID with Passport ID, status, created date, and latest marker.</p></div>
                    <pre class="bp-help-pre"><code>GET @Model.BasePath/batteries/@Model.SampleBatteryId/passports</code></pre>
                </article>

                <article id="api-detail-validate" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Validate</span><h3>Validate with the Passport Lifecycle token.</h3><p>Passport Lifecycle tokens can run trust actions only for their scoped clusters. If you just created a passport, replace the sample Passport ID with the Passport ID returned by create.</p></div>
                    <pre class="bp-help-pre"><code>POST @Model.BasePath/passports/@Model.SamplePassportId/validate</code></pre>
                </article>

                <article id="api-detail-sign" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Sign</span><h3>Sign the current passport core.</h3><p>The first publication still requires explicit publish in the app. After a passport has been published once, later successful signs auto-publish the new revision.</p></div>
                    <pre class="bp-help-pre"><code>POST @Model.BasePath/passports/@Model.SamplePassportId/sign</code></pre>
                </article>

                <article id="api-detail-publish" class="bp-help-detail-panel" data-api-help-detail-panel hidden>
                    <div><span class="bp-summary-title">Publish</span><h3>Publish after validation and signing.</h3><p>Publish with the Passport Lifecycle token after validation and signing are current.</p></div>
                    <pre class="bp-help-pre"><code>POST @Model.BasePath/passports/@Model.SamplePassportId/publish</code></pre>
                </article>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="bp-card bp-help-tester-card bp-api-help-section-card">
            <div class="bp-api-help-doc-heading">
                <div>
                    <span class="bp-summary-title">Sandbox</span>
                    <h2>Request workbench</h2>
                </div>
            </div>

            <div class="bp-form-grid">
                <label>Template
                    <select id="tester-template">
                        <option value="readFull">Read full battery</option>
                        <option value="listClusters">List accessible clusters</option>
                        <option value="listClusterBatteries">List cluster batteries</option>
                        <option value="readSection">Read section</option>
                        <option value="readSectionPerformance">Read section: Performance</option>
                        <option value="readSectionCircularity">Read section: Circularity</option>
                        <option value="readValuesAliases">Read values: ratedEnergy, ratedCapacity, nickelMass</option>
                        <option value="readPathsAll">List readable paths (full)</option>
                        <option value="readBatteryPassports">List battery passports</option>
                        <option value="readHistory24h">Read telemetry history 24h</option>
                        <option value="writeTelemetryPoint">Write telemetry point</option>
                        <option value="writeTelemetrySeries">Write telemetry series</option>
                        <option value="patchOperations">Patch operations metadata</option>
                        <option value="patchBatteryModel">Patch Battery Model</option>
                        <option value="patchSoftwareVersion">Patch Software Version</option>
                        <option value="createPassport">Create passport snapshot</option>
                        <option value="validatePassport">Validate passport</option>
                        <option value="signPassport">Sign passport</option>
                        <option value="publishPassport">Publish passport</option>
                    </select>
                </label>
                <label>HTTP method
                    <select id="tester-method">
                        <option>GET</option>
                        <option>POST</option>
                        <option>PATCH</option>
                    </select>
                </label>
                <label>Auth format
                    <select id="tester-auth-format">
                        <option value="base64">Basic &lt;base64(token:)&gt;</option>
                        <option value="raw">Basic &lt;token&gt;</option>
                    </select>
                </label>
                <label class="bp-span-all">Path
                    <input id="tester-path" value="@Model.BasePath/batteries/@Model.SampleBatteryId" />
                </label>
                <label>Token preset
                    <select id="tester-token-preset">
                        <option value="sample-read">Sample read token</option>
                        <option value="sample-read-write">Sample read-write token</option>
                        <option value="sample-lifecycle">Sample Passport Lifecycle token</option>
                        <option value="custom">Custom token</option>
                    </select>
                </label>
                <label class="bp-span-2">Token value
                    <input id="tester-token" value="@Model.SampleReadToken" />
                </label>
                <label class="bp-span-all">Body JSON
                    <textarea id="tester-body" rows="9"></textarea>
                </label>
                <label class="bp-span-all">Constructed HTTP request
                    <textarea id="tester-raw-request" class="bp-help-request-editor" rows="12"></textarea>
                </label>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-3">
                <button id="tester-load-template" type="button" class="bp-secondary-button">Load template</button>
                <button id="tester-send" type="button" class="bp-primary-button">Send request</button>
                <button id="tester-reset" type="button" class="bp-secondary-button">Reset</button>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="bp-secondary-button bp-button-compact template-shortcut" data-template="readFull">Read battery</button>
                <button type="button" class="bp-secondary-button bp-button-compact template-shortcut" data-template="readHistory24h">History 24h</button>
                <button type="button" class="bp-secondary-button bp-button-compact template-shortcut" data-template="readValuesAliases">Read specific values</button>
                <button type="button" class="bp-secondary-button bp-button-compact template-shortcut" data-template="writeTelemetryPoint">Post telemetry</button>
            </div>

            <div class="mt-3">
                <p class="mb-1"><strong>Status:</strong> <span id="tester-status">-</span></p>
                <pre id="tester-response" class="bp-help-pre"><code>{}</code></pre>
            </div>

            <div class="mt-3">
                <p class="mb-1"><strong>cURL preview</strong></p>
                <pre id="tester-curl" class="bp-help-pre"><code></code></pre>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script>
        (() => {
            const basePath = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BasePath));
            const sampleBatteryId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SampleBatteryId));
            const samplePassportId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SamplePassportId));
            const sampleReadToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SampleReadToken));
            const sampleReadWriteToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SampleReadWriteToken));
            const sampleLifecycleToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SampleLifecycleToken));

            const docSearch = document.getElementById('doc-search');
            const docItems = Array.from(document.querySelectorAll('.bp-help-doc-item'));
            docSearch?.addEventListener('input', () => {
                const query = (docSearch.value || '').toLowerCase().trim();
                docItems.forEach(item => {
                    const text = (item.innerText || '').toLowerCase();
                    item.style.display = text.includes(query) ? '' : 'none';
                });
            });

            const apiDetailButtons = Array.from(document.querySelectorAll('[data-api-help-detail-target]'));
            const apiDetailPanels = Array.from(document.querySelectorAll('[data-api-help-detail-panel]'));
            const apiDetailRegion = document.querySelector('.bp-api-help-selected-panel');
            const apiDetailRow = document.querySelector('[data-api-help-detail-row]');
            const activateApiDetail = (targetId, shouldOpen) => {
                apiDetailPanels.forEach(panel => {
                    panel.hidden = panel.id !== targetId || !shouldOpen;
                });
                apiDetailButtons.forEach(button => {
                    const isActive = shouldOpen && button.getAttribute('data-api-help-detail-target') === targetId;
                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('aria-expanded', isActive ? 'true' : 'false');
                });
                if (apiDetailRegion) {
                    apiDetailRegion.hidden = !shouldOpen;
                }
                if (apiDetailRow) {
                    apiDetailRow.hidden = !shouldOpen;
                }
            };

            apiDetailButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const targetId = button.getAttribute('data-api-help-detail-target');
                    const targetPanel = targetId ? document.getElementById(targetId) : null;
                    const hostRow = button.closest('tr');
                    const isSameVisible = Boolean(targetPanel && apiDetailRow && !targetPanel.hidden && !apiDetailRow.hidden);
                    if (targetId) {
                        if (hostRow && apiDetailRow && hostRow.parentNode) {
                            hostRow.parentNode.insertBefore(apiDetailRow, hostRow.nextSibling);
                        }
                        activateApiDetail(targetId, !isSameVisible);
                        if (!isSameVisible && apiDetailRegion) {
                            apiDetailRegion.focus({ preventScroll: true });
                        }
                    }
                });
            });

            const templateSelect = document.getElementById('tester-template');
            const methodEl = document.getElementById('tester-method');
            const pathEl = document.getElementById('tester-path');
            const authFormatEl = document.getElementById('tester-auth-format');
            const tokenPresetEl = document.getElementById('tester-token-preset');
            const tokenEl = document.getElementById('tester-token');
            const bodyEl = document.getElementById('tester-body');
            const rawRequestEl = document.getElementById('tester-raw-request');
            const statusEl = document.getElementById('tester-status');
            const responseEl = document.getElementById('tester-response');
            const curlEl = document.getElementById('tester-curl');
            let isReflectingRaw = false;

            const renderJsonWindow = (targetWindow, title, bodyText) => {
                const targetDocument = targetWindow.document;
                targetDocument.open();
                targetDocument.write('<!doctype html><html><head><title></title></head><body></body></html>');
                targetDocument.close();
                targetDocument.title = title;

                const style = targetDocument.createElement('style');
                style.textContent = 'body{font-family:ui-monospace,SFMono-Regular,Consolas,Liberation Mono,monospace;margin:0;padding:24px;background:#f8fafc;color:#0f172a;}pre{white-space:pre-wrap;word-break:break-word;margin:0;}';
                targetDocument.head.appendChild(style);

                const pre = targetDocument.createElement('pre');
                pre.textContent = bodyText;
                targetDocument.body.appendChild(pre);
            };

            const templates = {
                readFull: {
                    method: 'GET',
                    path: `${basePath}/batteries/${sampleBatteryId}`,
                    body: '',
                    tokenPreset: 'sample-read'
                },
                listClusters: {
                    method: 'GET',
                    path: `${basePath}/clusters`,
                    body: '',
                    tokenPreset: 'sample-read'
                },
                listClusterBatteries: {
                    method: 'GET',
                    path: `${basePath}/clusters/demo-cluster/batteries`,
                    body: '',
                    tokenPreset: 'sample-read'
                },
                readSection: {
                    method: 'GET',
                    path: `${basePath}/batteries/${sampleBatteryId}/section/general`,
                    body: '',
                    tokenPreset: 'sample-read'
                },
                readSectionPerformance: {
                    method: 'GET',
                    path: `${basePath}/batteries/${sampleBatteryId}/section/performance`,
                    body: '',
                    tokenPreset: 'sample-read'
                },
                readSectionCircularity: {
                    method: 'GET',
                    path: `${basePath}/batteries/${sampleBatteryId}/section/circularity`,
                    body: '',
                    tokenPreset: 'sample-read'
                },
                readValuesAliases: {
                    method: 'GET',
                    path: `${basePath}/batteries/${sampleBatteryId}/values?path=ratedEnergy&path=ratedCapacity&path=nickelMass`,
                    body: '',
                    tokenPreset: 'sample-read'
                },
                readPathsAll: {
                    method: 'GET',
                    path: `${basePath}/batteries/${sampleBatteryId}/paths?section=full`,
                    body: '',
                    tokenPreset: 'sample-read'
                },
                readBatteryPassports: {
                    method: 'GET',
                    path: `${basePath}/batteries/${sampleBatteryId}/passports`,
                    body: '',
                    tokenPreset: 'sample-read'
                },
                readHistory24h: {
                    method: 'GET',
                    path: `${basePath}/batteries/${sampleBatteryId}/telemetry/history?hours=24`,
                    body: '',
                    tokenPreset: 'sample-read'
                },
                writeTelemetryPoint: {
                    method: 'POST',
                    path: `${basePath}/batteries/${sampleBatteryId}/telemetry`,
                    body: JSON.stringify({
                        points: [
                            {
                                currentConsumptionKwh: 163.4,
                                currentChargeLevelPct: 79.8,
                                currentVoltageV: 398.4,
                                currentCurrentA: 52.3
                            }
                        ]
                    }, null, 2),
                    tokenPreset: 'sample-read-write'
                },
                writeTelemetrySeries: {
                    method: 'POST',
                    path: `${basePath}/batteries/${sampleBatteryId}/telemetry`,
                    body: JSON.stringify({
                        series: {
                            currentConsumptionKwh: [
                                { measuredAt: '2026-05-20T09:00:00Z', value: 163.4 },
                                { measuredAt: '2026-05-20T09:05:00Z', value: 164.1 }
                            ],
                            currentChargeLevelPct: [
                                { measuredAt: '2026-05-20T09:00:00Z', value: 79.8 }
                            ],
                            currentVoltageV: [
                                { measuredAt: '2026-05-20T09:00:00Z', value: 398.4 },
                                { measuredAt: '2026-05-20T09:05:00Z', value: 399.1 }
                            ]
                        }
                    }, null, 2),
                    tokenPreset: 'sample-read-write'
                },
                patchOperations: {
                    method: 'PATCH',
                    path: `${basePath}/batteries/${sampleBatteryId}/operations`,
                    body: JSON.stringify({
                        isActive: true,
                        locationOfUse: {
                            siteName: 'Sample Site',
                            city: 'Berlin',
                            country: 'DE'
                        },
                        contactPerson: {
                            name: 'Sample Contact',
                            email: 'sample@example.test'
                        }
                    }, null, 2),
                    tokenPreset: 'sample-read-write'
                },
                patchBatteryModel: {
                    method: 'PATCH',
                    path: `${basePath}/batteries/${sampleBatteryId}/battery-model`,
                    body: JSON.stringify({
                        batteryModel: '2.0'
                    }, null, 2),
                    tokenPreset: 'sample-read-write'
                },
                patchSoftwareVersion: {
                    method: 'PATCH',
                    path: `${basePath}/batteries/${sampleBatteryId}/software-version`,
                    body: JSON.stringify({
                        softwareVersion: '4.0'
                    }, null, 2),
                    tokenPreset: 'sample-read-write'
                },
                createPassport: {
                    method: 'POST',
                    path: `${basePath}/batteries/${sampleBatteryId}/passports`,
                    body: '',
                    tokenPreset: 'sample-lifecycle'
                },
                validatePassport: {
                    method: 'POST',
                    path: `${basePath}/passports/${samplePassportId}/validate`,
                    body: '',
                    tokenPreset: 'sample-lifecycle'
                },
                signPassport: {
                    method: 'POST',
                    path: `${basePath}/passports/${samplePassportId}/sign`,
                    body: '',
                    tokenPreset: 'sample-lifecycle'
                },
                publishPassport: {
                    method: 'POST',
                    path: `${basePath}/passports/${samplePassportId}/publish`,
                    body: '',
                    tokenPreset: 'sample-lifecycle'
                }
            };

            const tokenByPreset = {
                'sample-read': sampleReadToken,
                'sample-read-write': sampleReadWriteToken,
                'sample-lifecycle': sampleLifecycleToken
            };

            const utf8ToBase64 = (value) => {
                const bytes = new TextEncoder().encode(value);
                let binary = '';
                bytes.forEach(byte => {
                    binary += String.fromCharCode(byte);
                });
                return btoa(binary);
            };

            const openSupportedValues = async (event) => {
                event.preventDefault();

                const link = event.currentTarget;
                const targetWindow = window.open('', '_blank') || window;
                if (targetWindow !== window) {
                    targetWindow.opener = null;
                }

                renderJsonWindow(targetWindow, 'Readable battery paths', 'Loading readable values...');

                const authorization = `Basic ${utf8ToBase64(`${sampleReadToken}:`)}`;
                try {
                    const httpResponse = await fetch(link.href, {
                        headers: {
                            Authorization: authorization,
                            Accept: 'application/json'
                        }
                    });

                    const responseText = await httpResponse.text();
                    let formattedResponse = responseText;
                    try {
                        formattedResponse = JSON.stringify(JSON.parse(responseText), null, 2);
                    } catch {
                        // Keep non-JSON error responses readable.
                    }

                    renderJsonWindow(
                        targetWindow,
                        `Readable battery paths - ${httpResponse.status}`,
                        `${httpResponse.status} ${httpResponse.statusText}\n\n${formattedResponse}`);
                } catch (error) {
                    renderJsonWindow(targetWindow, 'Readable battery paths - request failed', String(error));
                }
            };

            document.getElementById('supported-values-link')?.addEventListener('click', openSupportedValues);

            const decodeBase64Token = (value) => {
                try {
                    const decoded = atob(value);
                    const separator = decoded.indexOf(':');
                    return separator > 0 ? decoded.slice(0, separator) : '';
                } catch {
                    return '';
                }
            };

            const resolveAuthHeader = () => {
                const tokenValue = (tokenEl.value || '').trim();
                if (!tokenValue) {
                    return '';
                }

                return authFormatEl.value === 'raw'
                    ? `Basic ${tokenValue}`
                    : `Basic ${utf8ToBase64(`${tokenValue}:`)}`;
            };

            const resolveAbsoluteUrl = (rawPath) => {
                const value = (rawPath || '').trim();
                if (!value) {
                    return '';
                }

                if (/^https?:\/\//i.test(value)) {
                    return value;
                }

                return `${window.location.origin}${value.startsWith('/') ? value : `/${value}`}`;
            };

            const setTokenFromPreset = () => {
                const presetValue = tokenPresetEl.value;
                if (presetValue === 'custom') {
                    return;
                }

                tokenEl.value = tokenByPreset[presetValue] || '';
            };

            const buildRawRequest = () => {
                const method = methodEl.value || 'GET';
                const absoluteUrl = resolveAbsoluteUrl(pathEl.value);
                const url = new URL(absoluteUrl || window.location.href);
                const target = `${url.pathname}${url.search}`;
                const bodyText = method === 'GET' ? '' : (bodyEl.value || '').trim();
                const lines = [
                    `${method} ${target} HTTP/1.1`,
                    `Host: ${url.host}`
                ];

                const authHeader = resolveAuthHeader();
                if (authHeader) {
                    lines.push(`Authorization: ${authHeader}`);
                }
                lines.push('Accept: application/json');

                if (bodyText) {
                    lines.push('Content-Type: application/json');
                }

                lines.push('');
                if (bodyText) {
                    lines.push(bodyText);
                }

                return lines.join('\n');
            };

            const parseRawRequest = (rawValue) => {
                const normalized = (rawValue || '').replace(/\r\n/g, '\n');
                const separator = normalized.indexOf('\n\n');
                const head = separator >= 0 ? normalized.slice(0, separator) : normalized;
                const body = separator >= 0 ? normalized.slice(separator + 2) : '';
                const lines = head.split('\n').map(line => line.trim()).filter(Boolean);
                if (lines.length === 0) {
                    return null;
                }

                const requestLine = lines.shift();
                const requestParts = requestLine.split(/\s+/);
                if (requestParts.length < 2) {
                    return null;
                }

                const method = requestParts[0].toUpperCase();
                const target = requestParts[1];
                const headers = {};
                lines.forEach(line => {
                    const separatorIndex = line.indexOf(':');
                    if (separatorIndex <= 0) {
                        return;
                    }

                    const name = line.slice(0, separatorIndex).trim();
                    const value = line.slice(separatorIndex + 1).trim();
                    if (name) {
                        headers[name] = value;
                    }
                });

                return {
                    requestSource: 'raw',
                    method,
                    target,
                    absoluteUrl: resolveAbsoluteUrl(target),
                    headers,
                    body
                };
            };

            const headerValue = (headers, name) => {
                const match = Object.keys(headers).find(key => key.toLowerCase() === name.toLowerCase());
                return match ? headers[match] : '';
            };

            const fetchHeadersFromRaw = (headers) => {
                const fetchHeaders = {};
                Object.entries(headers).forEach(([name, value]) => {
                    const lower = name.toLowerCase();
                    if (lower === 'host' || lower === 'content-length' || lower === 'connection') {
                        return;
                    }

                    fetchHeaders[name] = value;
                });
                return fetchHeaders;
            };

            const reflectRawRequest = () => {
                const parsed = parseRawRequest(rawRequestEl.value);
                if (!parsed) {
                    return;
                }

                isReflectingRaw = true;
                if (Array.from(methodEl.options).some(option => option.value === parsed.method)) {
                    methodEl.value = parsed.method;
                }
                pathEl.value = parsed.target;
                bodyEl.value = parsed.body || '';

                const authorization = headerValue(parsed.headers, 'Authorization');
                if (authorization.toLowerCase().startsWith('basic ')) {
                    const payload = authorization.slice(6).trim();
                    const decodedToken = decodeBase64Token(payload);
                    tokenPresetEl.value = 'custom';
                    if (decodedToken) {
                        authFormatEl.value = 'base64';
                        tokenEl.value = decodedToken;
                    } else {
                        authFormatEl.value = 'raw';
                        tokenEl.value = payload;
                    }
                }
                isReflectingRaw = false;
            };

            const updateCurlPreview = () => {
                const parsed = parseRawRequest(rawRequestEl.value);
                if (!parsed || !parsed.absoluteUrl) {
                    curlEl.innerText = '';
                    return;
                }

                const lines = [`curl -X ${parsed.method} "${parsed.absoluteUrl}"`];
                Object.entries(fetchHeadersFromRaw(parsed.headers)).forEach(([name, value]) => {
                    lines.push(`  -H "${name}: ${value}"`);
                });
                if (!['GET', 'HEAD'].includes(parsed.method) && parsed.body.trim()) {
                    lines.push(`  --data-raw '${parsed.body.replace(/'/g, "\\'")}'`);
                }

                curlEl.innerText = lines.join(' \\\n');
            };

            const syncRawRequestFromControls = () => {
                if (isReflectingRaw) {
                    return;
                }

                rawRequestEl.value = buildRawRequest();
                updateCurlPreview();
            };

            const applyTemplate = (templateKey) => {
                const template = templates[templateKey];
                if (!template) {
                    return;
                }

                methodEl.value = template.method;
                pathEl.value = template.path;
                bodyEl.value = template.body;
                tokenPresetEl.value = template.tokenPreset;
                setTokenFromPreset();
                syncRawRequestFromControls();
            };

            const setStatus = (text) => {
                statusEl.innerText = text;
            };

            const setResponse = (value) => {
                responseEl.innerText = value;
            };

            templateSelect?.addEventListener('change', () => {
                applyTemplate(templateSelect.value);
            });

            document.getElementById('tester-load-template')?.addEventListener('click', () => {
                applyTemplate(templateSelect.value);
            });

            document.getElementById('tester-reset')?.addEventListener('click', () => {
                templateSelect.value = 'readFull';
                authFormatEl.value = 'base64';
                applyTemplate('readFull');
                setStatus('-');
                setResponse('{}');
            });

            tokenPresetEl?.addEventListener('change', () => {
                setTokenFromPreset();
                syncRawRequestFromControls();
            });

            document.querySelectorAll('.template-shortcut').forEach(button => {
                button.addEventListener('click', () => {
                    const key = button.getAttribute('data-template');
                    if (!key) {
                        return;
                    }

                    templateSelect.value = key;
                    applyTemplate(key);
                });
            });

            [methodEl, pathEl, authFormatEl, tokenEl, bodyEl].forEach(element => {
                element?.addEventListener('input', syncRawRequestFromControls);
                element?.addEventListener('change', syncRawRequestFromControls);
            });

            rawRequestEl?.addEventListener('input', () => {
                reflectRawRequest();
                updateCurlPreview();
            });

            document.getElementById('tester-send')?.addEventListener('click', async () => {
                const parsed = parseRawRequest(rawRequestEl.value);
                if (!parsed || !parsed.absoluteUrl) {
                    setStatus('Validation failed');
                    setResponse('Constructed HTTP request is invalid.');
                    return;
                }

                const requestBody = !['GET', 'HEAD'].includes(parsed.method) && parsed.body.trim()
                    ? parsed.body
                    : undefined;

                setStatus('Sending...');
                try {
                    const httpResponse = await fetch(parsed.absoluteUrl, {
                        method: parsed.method,
                        headers: fetchHeadersFromRaw(parsed.headers),
                        body: requestBody
                    });

                    const text = await httpResponse.text();
                    setStatus(`${httpResponse.status} ${httpResponse.statusText}`);
                    try {
                        setResponse(JSON.stringify(JSON.parse(text), null, 2));
                    } catch {
                        setResponse(text);
                    }
                } catch (error) {
                    setStatus('Request failed');
                    setResponse(String(error));
                } finally {
                    updateCurlPreview();
                }
            });

            applyTemplate(templateSelect.value);
        })();
    </script>
}
