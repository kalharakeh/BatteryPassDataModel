@model BatteryPassWeb.Models.ViewModels.ExternalApiHelpViewModel
@{
    ViewData["Title"] = "External API Help";
}
<main class="bp-page bp-admin-page bp-help-page bp-api-help-page">
    <header class="bp-console-header">
        <div>
            <h1>API help</h1>
            <p class="text-secondary mb-0">Read passport data, update operational values, and run token-protected trust actions.</p>
        </div>
    </header>

    <section class="bp-console-toolbar bp-api-help-meta-strip" aria-label="API connection values">
        <div class="bp-help-kv-grid">
            <div>
                <p class="mb-1 text-secondary small">Base path</p>
                <code>@Model.BasePath</code>
            </div>
            <div>
                <p class="mb-1 text-secondary small">Sample Battery ID for these tokens</p>
                <span class="bp-id-copy-row"><code class="bp-id-value">@Model.SampleBatteryId</code>@await Html.PartialAsync("_CopyIdButton", Model.SampleBatteryId)</span>
            </div>
            <div>
                <p class="mb-1 text-secondary small">Sample Passport ID for trust actions</p>
                <span class="bp-id-copy-row"><code class="bp-id-value">@Model.SamplePassportId</code>@await Html.PartialAsync("_CopyIdButton", Model.SamplePassportId)</span>
            </div>
            <div>
                <p class="mb-1 text-secondary small">Sample read token</p>
                <code>@Model.SampleReadToken</code>
            </div>
            <div>
                <p class="mb-1 text-secondary small">Sample read-write token</p>
                <code>@Model.SampleReadWriteToken</code>
            </div>
            <div>
                <p class="mb-1 text-secondary small">Sample Passport Lifecycle token</p>
                <code>@Model.SampleLifecycleToken</code>
            </div>
        </div>
    </section>

    <div class="bp-help-stack">
        <section class="bp-card bp-api-help-section-card bp-api-help-reference-console">
            <div class="bp-api-help-doc-heading">
                <div>
                    <span class="bp-summary-title">Reference</span>
                    <h2>API documentation</h2>
                </div>
                <input id="doc-search" class="form-control bp-api-help-search" placeholder="Search endpoint, field, alias, section" />
            </div>

            <div class="bp-table-scroll bp-api-help-table-shell">
                <table class="table bp-console-table bp-api-help-endpoint-table">
                    <thead>
                        <tr>
                            <th>Method</th>
                            <th>Endpoint</th>
                            <th>Access</th>
                            <th>Use when</th>
                            <th class="bp-action-cell">Details</th>
                        </tr>
                    </thead>
                    <tbody id="doc-list">
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">AUTH</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>Authorization header</code><small>Basic token credential, not token ID</small></span></td>
                            <td><span class="bp-help-access-pill">All tokens</span></td>
                            <td>Call any external API endpoint.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-auth" aria-expanded="false" aria-controls="api-detail-auth" aria-label="Show authentication details" title="Show authentication details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">GET</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/clusters</code><small>Clusters this token can access</small></span></td>
                            <td><span class="bp-help-access-pill">Read</span></td>
                            <td>Discover cluster IDs before listing batteries.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-clusters" aria-expanded="false" aria-controls="api-detail-clusters" aria-label="Show cluster endpoint details" title="Show cluster endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
                            <td><span class="bp-help-method">GET</span></td>
                            <td><span class="bp-help-endpoint-cell"><code>@Model.BasePath/clusters/{clusterId}/batteries</code><small>Battery IDs in one cluster</small></span></td>
                            <td><span class="bp-help-access-pill">Read</span></td>
                            <td>List batteries before reading or patching one.</td>
                            <td class="bp-action-cell">
                                <button type="button" class="bp-action-button bp-help-detail-toggle" data-api-help-detail-target="api-detail-cluster-batteries" aria-expanded="false" aria-controls="api-detail-cluster-batteries" aria-label="Show cluster batteries endpoint details" title="Show cluster batteries endpoint details" data-tooltip="Details">
                                    <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="bp-help-doc-item">
