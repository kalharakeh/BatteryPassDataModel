@using BatteryPassWeb.Dpp.Identifiers
@model (string Action, string BatteryId)
@* Finding R08: "Remove the passport" of a battery marked for deletion after recycling, confirmed by typing its ID. *@
@{
    var shown = IdentifierForms.Short(Model.BatteryId);
}
<dialog id="remove-passport-dialog" class="bp-modal-panel bp-dialog bp-console-form-card" aria-labelledby="remove-passport-title">
    <form method="post" action="@Model.Action" class="bp-dialog-form">
        @Html.AntiForgeryToken()
        <div>
            <h2 id="remove-passport-title">Remove the passport?</h2>
            <p class="bp-help-text mb-0">The battery was recycled, so its passport ceases to exist. This deletes its versions, its values and live values, and its accident reports with their files. It can't be undone.</p>
            <p class="bp-help-text mb-0">Afterwards its addresses and QR code say the battery was recycled, its ID is never used again, and the audit log keeps who removed it and when.</p>
        </div>
        <label>
            <span>Type the battery's ID, <strong>@shown</strong>, to confirm</span>
            <input type="text" name="confirmId" autocomplete="off" required />
        </label>
        <div class="bp-dialog-actions">
            <button type="submit" formmethod="dialog" formnovalidate class="bp-secondary-button">Cancel</button>
            <button type="submit" class="bp-danger-button">Remove the passport</button>
        </div>
    </form>
</dialog>
