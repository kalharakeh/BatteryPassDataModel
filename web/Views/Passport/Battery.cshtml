@model BatteryPassWeb.Models.ViewModels.BatteryDetailViewModel
@{
    ViewData["Title"] = "Battery passports";
    var battery = Model.Battery;
}

<main class="bp-page bp-admin-page bp-registry-page">
    <header class="bp-console-header">
        <div>
            <p class="bp-passport-id">Battery ID: <span class="bp-id-copy-row"><span class="bp-id-value">@battery.BatteryId</span>@await Html.PartialAsync("_CopyIdButton", battery.BatteryId)</span></p>
            <h1>@battery.BatteryFamily @battery.BatteryModel</h1>
            <p class="text-secondary mb-0">Battery serial number: @battery.BatterySerialNumber</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(battery.LatestPassportId))
        {
            <a class="bp-primary-button" href="/@Uri.EscapeDataString(battery.BatteryId)/latest">Open latest passport</a>
        }
    </header>

    <section class="bp-card bp-table-card">
        <div class="bp-table-scroll">
            <table class="table table-hover align-middle bp-console-table bp-mobile-card-table">
                <thead>
                    <tr>
                        <th>Passport ID</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Marker</th>
                        <th class="bp-action-cell">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in battery.Passports)
                    {
                        <tr>
                            <td class="text-break" data-label="Passport ID"><span class="bp-id-copy-row"><span class="bp-id-value">@row.PassportId</span>@await Html.PartialAsync("_CopyIdButton", row.PassportId)</span></td>
                            <td data-label="Status">@row.PassportStatus</td>
                            <td data-label="Created">@(string.IsNullOrWhiteSpace(row.CreatedAt) ? "-" : row.CreatedAt[..Math.Min(10, row.CreatedAt.Length)])</td>
                            <td data-label="Marker">@(row.IsLatestForBattery ? "Latest" : "Historical")</td>
                            <td class="bp-action-cell" data-label="Actions">
                                <div class="bp-icon-action-row">
                                    <a href="/@Uri.EscapeDataString(row.PassportId)/summary" class="bp-report-action" aria-label="Summary report" title="Summary report" data-tooltip="Summary report" data-action-icon="summary">
                                        <svg class="bp-report-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M6 3h9l3 3v15H6z" />
                                            <path d="M15 3v4h4" />
                                            <path d="M9 11h6M9 15h6M9 19h4" />
                                        </svg>
                                    </a>
                                    <a href="/@Uri.EscapeDataString(row.PassportId)" class="bp-report-action" aria-label="Detailed report" title="Detailed report" data-tooltip="Detailed report" data-action-icon="detail">
                                        <svg class="bp-report-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M6 3h9l3 3v15H6z" />
                                            <path d="M15 3v4h4" />
                                            <path d="M10 12a3 3 0 1 0 4.24 4.24" />
                                            <path d="m14 16 3 3" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
