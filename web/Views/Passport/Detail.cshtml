@using BatteryPassWeb.Dpp.Pages
@model PassportPage
@{
    // The detail page (design 12): for signed-in readers, one tab per audience they may see, then the public data,
    // every value with when it was generated and where it came from.
    ViewData["Title"] = $"Battery passport detail · {Model.Text(11)}";
    ViewData["Detail"] = true;
}
@* The paper version (step 6a-2). *@
<link rel="stylesheet" href="~/css/bp-print.css" media="print" asp-append-version="true" />
<main class="bp-page">
    @if (TempData[BatteryPassWeb.Controllers.PassportController.MarkMessageKey] is string marked)
    {
        <p class="bp-warning" role="status">@marked</p>
    }
    <partial name="_PassportHero" model="Model" view-data="ViewData" />
    @* The same key figures as the summary, under the hero (redesign R5). *@
    @if (Model.KeyFigures is { } keyFigures)
    {
        <partial name="_KeyFigures" model="keyFigures" />
    }
    @* The data, Live values and Modules included, as tabs (redesign R5, the owner's item 8). *@
    <partial name="_PassportTabs" model="Model" view-data="ViewData" />
</main>

@section Scripts {
    <script src="~/js/bp-passport-links.js" asp-append-version="true"></script>
    <script src="~/js/bp-passport-actions.js" asp-append-version="true"></script>
}
