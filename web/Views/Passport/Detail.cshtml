@model BatteryPassWeb.Models.ViewModels.PassportDetailViewModel
@{
    ViewData["Title"] = "Passport Detail";
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3">@Model.Summary.DisplayName</h1>
        <p class="text-break text-secondary">@Model.Summary.PassportId</p>
    </div>
    <a href="/@Uri.EscapeDataString(Model.Summary.PassportId)/summary" class="btn btn-outline-success">Back to summary</a>
</div>
<pre class="bg-light border rounded p-3 json-block">@Model.CanonicalJson</pre>
