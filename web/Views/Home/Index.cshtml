@{
    ViewData["Title"] = "Scania Battery Passport Viewer";
    var samplePassportId = ViewData["SamplePassportId"] as string ?? "did:web:acme.battery.pass:sample-customer-north-001";
}
<main class="bp-landing">
    <div class="bp-landing-content">
        <div>
            <h1>Scania Battery Passport Viewer</h1>
            <p>Enter a battery passport DID to open the public demonstrator view.</p>
        </div>
        <form action="/search" class="bp-search-form">
            <input name="q" placeholder="@samplePassportId" />
            <button type="submit">Search</button>
        </form>
        <div class="bp-landing-links">
            <a href="/search?q=@Uri.EscapeDataString(samplePassportId)">Search sample battery</a>
        </div>
    </div>
</main>
