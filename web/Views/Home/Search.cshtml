@model BatteryPassWeb.Models.ViewModels.SearchPageViewModel
@{
    ViewData["Title"] = "Search Scania battery passport";
}
<main class="bp-search-page">
    <h1>Search battery passport</h1>
    @if (Model.IsAdminSearch)
    {
        <p>Enter a full battery passport ID to open its summary report. General admins can also find draft and unpublished passports.</p>
    }
    else
    {
        <p>Enter a full published and verified battery passport ID to open its summary report.</p>
    }

    @if (Model.NotFound)
    {
        <p class="bp-warning">
            @if (Model.IsAdminSearch)
            {
                <span>No battery passport ID was found for <span class="fw-semibold">@Model.Query</span>.</span>
            }
            else
            {
                <span>No active public battery passport was found for <span class="fw-semibold">@Model.Query</span>. Check the ID, or ask an admin whether the passport is archived, unpublished, or still waiting for signing.</span>
            }
        </p>
    }

    <a href="/" class="bp-primary-button bp-back-link">Return to main search</a>
</main>
