@model BatteryPassWeb.Models.ViewModels.SearchPageViewModel
@{
    ViewData["Title"] = "Search Scania battery passport";
}
<main class="bp-search-page">
    <h1>Search battery passport</h1>
    <p>Enter a full published and verified battery passport ID to open its summary report.</p>

    @if (Model.NotFound)
    {
        <p class="bp-warning">
            No published, verified battery passport ID was found for <span class="fw-semibold">@Model.Query</span>. Check the ID or ask an admin whether the passport is still a draft.
        </p>
    }

    <form action="/search" class="bp-search-form mt-4">
        <input name="q" value="@Model.Query" placeholder="did:web:acme.battery.pass:..." />
        <button type="submit">Search</button>
    </form>

    <a href="/" class="bp-back-link">Back to home</a>
</main>
