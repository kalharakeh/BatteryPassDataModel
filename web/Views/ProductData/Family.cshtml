@using BatteryPassWeb.Dpp.Catalog
@using BatteryPassWeb.Dpp.Editing
@using BatteryPassWeb.Dpp.Pages
@inject Microsoft.Extensions.Options.IOptions<BatteryPassWeb.Configuration.BatteryPassOptions> AppOptions
@model FamilyPage
@{
    var selected = Model.SelectedModel;
    ViewData["Title"] = selected is null ? Model.Family.Name : $"{selected.Name} · {Model.Family.Name}";
    var familyId = Uri.EscapeDataString(Model.Family.Id);
    var hasPicture = Model.Family.PictureFileId is not null;
    var here = ProductDataPages.FamilyHref(Model.Family.Id, selected?.Id);
}

<main class="bp-page bp-admin-page">
    <link rel="stylesheet" href="~/css/bp-product-data.css" asp-append-version="true" />
    <nav class="bp-breadcrumb" aria-label="Breadcrumb">
        <a href="/admin/families">Battery families</a>
        @if (selected is null)
        {
            <span aria-current="page">@Model.Family.Name</span>
        }
        else
        {
            <a href="@ProductDataPages.FamilyHref(Model.Family.Id)">@Model.Family.Name</a>
            <span aria-current="page">@selected.Name</span>
        }
    </nav>

    <section class="bp-card bp-console-form-card bp-product-editor-hero">
        <div class="d-grid gap-3">
            <div>
                <span class="bp-summary-title">Battery family</span>
                <h1>@Model.Family.Name</h1>
                <p class="mb-0">
                    The family's battery models, each with its passport values and its batches. Batteries take their model
                    and batch values from here.
                </p>
            </div>
            <div class="bp-family-identity">
                <form method="post" action="/admin/families/@familyId/name" class="bp-family-identity-field">
                    @Html.AntiForgeryToken()
                    <label for="family-name">Family name <em class="bp-field-marker">Not passport data</em></label>
                    <div class="d-flex gap-2">
                        <input id="family-name" type="text" name="name" value="@Model.Family.Name" required />
                        <button type="submit" class="bp-secondary-button bp-button-compact text-nowrap">Rename</button>
                    </div>
                </form>
                <form method="post" action="/admin/families/@familyId/picture" enctype="multipart/form-data" class="bp-family-identity-field" data-upload-row>
                    @Html.AntiForgeryToken()
                    <span>Picture, shown on the public page (PNG or JPEG)</span>
                    <div class="d-flex gap-2">
                        <input type="text" readonly value="@(hasPicture ? "A picture is set" : "No picture yet")" aria-label="Current picture" data-upload-name />
                        <label class="bp-secondary-button bp-button-compact bp-document-smart-upload position-relative text-nowrap flex-shrink-0 mb-0">
                            Choose picture
                            <input type="file" name="picture" class="bp-document-hidden-file" accept="image/png,image/jpeg" data-kind-words="a PNG or JPEG" data-max-bytes="@AppOptions.Value.MaxUploadBytes" data-upload-file />
                        </label>
                        <button type="submit" class="bp-secondary-button bp-button-compact text-nowrap" data-upload-button>Save picture</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="bp-product-editor-preview">
            @if (hasPicture)
            {
                <img src="/dpp/families/@familyId/picture" alt="@Model.Family.Name battery family picture" />
            }
            else
            {
                <span class="bp-help-text text-center">No picture yet</span>
            }
        </div>
    </section>

    @await Html.PartialAsync("_Messages")

    <section class="bp-card bp-product-version-console bp-console-form-card mt-4">
        <div class="bp-product-version-console-header">
            <div>
                <h2>Battery models</h2>
                <p class="bp-help-text mb-0">Choose a model to edit its passport values and its batches.</p>
            </div>
        </div>

        @if (Model.Models.Count > 0)
        {
            <div class="bp-product-version-tab-rail bp-product-version-chip-rail">
                @foreach (var chip in Model.Models)
                {
                    var isSelected = chip.Model.Id == selected?.Id;
                    <article class="bp-product-version-tab bp-product-version-chip @(isSelected ? "is-active" : string.Empty)">
                        <a class="bp-product-version-tab-main" aria-current="@(isSelected ? "page" : null)" href="@(ProductDataPages.FamilyHref(Model.Family.Id, chip.Model.Id))#editor">
                            <strong>@chip.Model.Name</strong>
                        </a>
                        <small class="bp-chip-meta"
                               title="@(chip.Missing > 0 ? $"{Words.Count(chip.Missing, "value")} needed by Feb 2027 {Words.Is(chip.Missing)} missing" : !chip.Answered ? "Its three questions aren't answered yet" : "Every value needed by Feb 2027 is filled in")">
                            <span class="@(chip.Missing > 0 || !chip.Answered ? "bp-missing-note" : "bp-done-note")">@(chip.Missing > 0 ? $"{chip.Missing} missing" : !chip.Answered ? "Questions to answer" : "Complete")</span>
                            <span>@chip.Filled of @chip.Total filled</span>
                        </small>
                    </article>
                }
            </div>
        }

        <form method="post" action="/admin/families/@familyId/models" class="bp-product-version-selected-panel bp-add-model">
            @Html.AntiForgeryToken()
            <label class="bp-product-version-selected-field">
                <span>@(Model.Models.Count == 0 ? "First battery model" : "New battery model")</span>
                <input type="text" name="name" placeholder="Model name, e.g. EXB-NMC-120" required />
            </label>
            @if (Model.CopySources.Count > 0)
            {
                <label class="bp-product-version-selected-field">
                    <span>Start from</span>
                    <select name="copyFrom">
                        <option value="">Empty</option>
                        @foreach (var group in Model.CopySources.GroupBy(source => source.FamilyName))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var source in group)
                                {
                                    <option value="@source.Model.Id">Copy of @source.Model.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>
            }
            <div class="bp-product-version-selected-actions">
                <button type="submit" class="bp-secondary-button bp-button-compact text-nowrap">Add model</button>
            </div>
        </form>
    </section>

    @if (selected is not null)
    {
        <section class="bp-card bp-product-editor-section bp-console-form-card mt-4" id="modules">
            @* The model's own picture, shown instead of the family's (redesign R2, owner's point 8). *@
            <form method="post" action="/admin/models/@selected.Id/picture" enctype="multipart/form-data" class="bp-model-picture" data-upload-row>
                @Html.AntiForgeryToken()
                <div class="bp-model-picture-preview">
                    @if (selected.PictureFileId is not null)
                    {
                        <img src="/dpp/models/@selected.Id/picture" alt="@selected.Name battery model picture" />
                    }
                    else if (hasPicture)
                    {
                        <img src="/dpp/families/@familyId/picture" alt="@Model.Family.Name battery family picture" />
                    }
                </div>
                <div class="d-grid gap-2">
                    <span><strong>Picture of @selected.Name</strong> <em class="bp-field-marker">Not passport data</em></span>
                    <small class="bp-field-help">@(selected.PictureFileId is null ? "It shows the family's picture. Give it its own when it looks different, for example a double stack." : "Its own picture: its batteries' public page shows it instead of the family's.")</small>
                    <div class="bp-attr-file">
                        <label class="bp-secondary-button bp-button-compact bp-document-smart-upload position-relative text-nowrap mb-0">
                            Choose picture
                            <input type="file" name="picture" class="bp-document-hidden-file" accept="image/png,image/jpeg" data-kind-words="a PNG or JPEG" data-max-bytes="@AppOptions.Value.MaxUploadBytes" data-upload-file />
                        </label>
                        <span class="bp-help-text" data-upload-chosen>No file chosen</span>
                        <button type="submit" class="bp-secondary-button bp-button-compact text-nowrap" data-upload-button>Save picture</button>
                    </div>
                </div>
            </form>
            @if (selected.PictureFileId is not null)
            {
                <form method="post" action="/admin/models/@selected.Id/picture/remove" class="bp-model-picture-remove">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="bp-text-button">Remove its picture and show the family's</button>
                </form>
            }
            <form method="post" action="/admin/models/@selected.Id/module-description" class="bp-module-description">
                @Html.AntiForgeryToken()
                <label for="module-description">Module description of @selected.Name <em class="bp-field-marker">Not passport data</em></label>
                <textarea id="module-description" name="description" rows="2" maxlength="@ModuleList.MaxDescriptionLength" placeholder="e.g. 8 lithium-ion modules, 2 strings of 4">@selected.ModuleDescription</textarea>
                <div class="bp-live-save">
                    <small class="bp-field-help">Shown on the public page of this model's batteries, with each battery's module count. Each battery's modules are listed on its own page.</small>
                    <button type="submit" class="bp-secondary-button bp-button-compact text-nowrap">Save description</button>
                </div>
            </form>
        </section>
    }

    @if (selected is not null)
    {
        @* R01: the three questions that decide which conditional values this model's passports need. App data, not published. *@
        var answers = selected.Answers();
        var pending = (TempData[BatteryPassWeb.Controllers.ProductDataController.PendingAnswersKey] as string)?.Split('|');
        var pendingHere = pending is { Length: 4 } && pending[0] == selected.Id;
        var pendingAffected = TempData[BatteryPassWeb.Controllers.ProductDataController.PendingAffectedKey] as int? ?? 0;
        string PendingValue(string name) => pendingHere ? pending!.Skip(1).Select(part => part.Split('=', 2)).FirstOrDefault(part => part[0] == name)?.ElementAtOrDefault(1) ?? string.Empty : string.Empty;
        <section class="bp-card bp-console-form-card mt-4" id="questions">
            <div class="bp-product-section-heading">
                <div>
                    <h2>Three questions about model @selected.Name</h2>
                    <p class="bp-help-text mb-0">They decide which values its passports need. They aren't passport data: readers don't see them.</p>
                </div>
            </div>
            @if (!answers.AllAnswered)
            {
                <p class="bp-warning mt-2 mb-0" role="status">Not answered yet: this model's batteries can't be published until all three are answered.</p>
            }
            @if (pendingHere)
            {
                <form method="post" action="/admin/models/@Uri.EscapeDataString(selected.Id)/questions" class="bp-warning mt-2" role="alert">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="warranty" value="@PendingValue("warranty")" />
                    <input type="hidden" name="cycling" value="@PendingValue("cycling")" />
                    <input type="hidden" name="cadmiumOrLead" value="@PendingValue("cadmiumOrLead")" />
                    <input type="hidden" name="confirmed" value="true" />
                    <p class="mb-2">@Words.Count(pendingAffected, "published battery", "published batteries") of this model @(pendingAffected == 1 ? "lacks" : "lack") a value these answers ask for. @(pendingAffected == 1 ? "It" : "They") can't get a new version until the value is filled in. Nothing is saved yet.</p>
                    <button type="submit" class="bp-secondary-button bp-button-compact">Save the answers anyway</button>
                    <a href="@here#questions" class="ms-2">Cancel</a>
                </form>
            }
            <form method="post" action="/admin/models/@Uri.EscapeDataString(selected.Id)/questions">
                @Html.AntiForgeryToken()
                @foreach (var question in ModelQuestions.All)
                {
                    var field = ModelQuestions.FieldName(question);
                    var answer = answers.Of(question);
                    <fieldset class="bp-choice-list mt-3">
                        <legend>@ModelQuestions.Text(question) <span class="bp-field-help">@(answer is null ? "Not answered yet" : string.Empty)</span></legend>
                        <label class="bp-choice"><input type="radio" name="@field" value="yes" checked="@(answer == true)" /><strong>Yes</strong><small>Its values are needed: @string.Join(", ", ModelQuestions.Decides[question].Select(number => $"#{number}")).</small></label>
                        <label class="bp-choice"><input type="radio" name="@field" value="no" checked="@(answer == false)" /><strong>No</strong><small>They aren't needed. A value filled in anyway is kept and published.</small></label>
                    </fieldset>
                }
                <button type="submit" class="bp-secondary-button bp-button-compact mt-3">Save answers</button>
            </form>
        </section>
    }

    @if (Model.ModelEditor is { } modelEditor)
    {
        @await Html.PartialAsync("_RecordEditor", modelEditor)
    }

    @if (selected is not null)
    {
        <section class="bp-card bp-product-editor-section bp-console-form-card mt-4" id="batches">
            <div class="bp-product-section-heading">
                <div>
                    <h2>Production batches of model @selected.Name</h2>
                    <p class="bp-help-text mb-0">
                        A batch is every battery of this model made in one calendar year at one manufacturing site. Values that
                        depend on when and where batteries were made are set per batch: carbon footprint, recycled content, the
                        declaration of conformity and test reports.
                    </p>
                </div>
            </div>
            @if (Model.Batches.Count == 0)
            {
                <p class="mb-0">No batches yet.</p>
            }
            else
            {
                <div class="bp-table-scroll">
                    <table class="table table-hover align-middle bp-console-table mb-0">
                        <thead>
                            <tr><th>Year</th><th>Manufacturing site</th><th>Values</th><th>Batteries</th><th class="bp-action-cell">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Batches)
                            {
                                <tr>
                                    <td>@row.Batch.Year</td>
                                    <td>@row.SiteName</td>
                                    <td>@await Html.PartialAsync("_Completeness", new Completeness(row.Filled, row.Total, row.Missing))</td>
                                    <td>@row.Packs (@row.Published published)</td>
                                    <td class="bp-action-cell"><a class="bp-secondary-button bp-button-compact text-nowrap" href="/admin/batches/@Uri.EscapeDataString(row.Batch.Id)#editor">Edit batch</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.Sites.Count == 0)
            {
                <div class="bp-product-version-selected-panel">
                    <div class="bp-product-version-selected-meta">
                        <strong>Add a manufacturing site first</strong>
                        <span>A batch is made at a manufacturing site, and there is none yet. You'll come back here after adding it.</span>
                    </div>
                    <div class="bp-product-version-selected-actions">
                        <a class="bp-secondary-button bp-button-compact text-nowrap" href="/admin/sites-and-operators?returnTo=@Uri.EscapeDataString(here + "#batches")">Add a manufacturing site</a>
                    </div>
                </div>
            }
            else
            {
                <form method="post" action="/admin/models/@Uri.EscapeDataString(selected.Id)/batches" class="bp-product-version-selected-panel">
                    @Html.AntiForgeryToken()
                    <label class="bp-product-version-selected-field">
                        <span>Year of the new batch</span>
                        <input type="text" inputmode="numeric" pattern="[0-9]{4}" name="year" value="@DateTime.UtcNow.Year" required />
                    </label>
                    <label class="bp-product-version-selected-field">
                        <span>Manufacturing site</span>
                        <select name="siteId" required>
                            <option value="">Choose a site…</option>
                            @foreach (var site in Model.Sites)
                            {
                                var siteMissing = RecordEditor.CountMissing(TargetKind.Site, site.Values, ModelAnswers.NotAnswered);
                                <option value="@site.Id">@(siteMissing > 0 ? $"{site.Name} ({siteMissing} missing)" : site.Name)</option>
                            }
                        </select>
                    </label>
                    <div class="bp-product-version-selected-actions">
                        <button type="submit" class="bp-secondary-button bp-button-compact text-nowrap">Add batch</button>
                    </div>
                </form>
            }
        </section>
    }

    <details class="bp-card bp-remove-record mt-4">
        <summary>Remove this battery family</summary>
        @if (Model.Removal.Blocked is { } blocked)
        {
            <p class="mb-0 mt-2">It can't be removed: @blocked</p>
        }
        else
        {
            <form method="post" action="@Model.Removal.Action" class="d-flex flex-wrap align-items-center gap-3 mt-2">
                @Html.AntiForgeryToken()
                <span>It has no models. Removing it deletes its name and picture; this can't be undone.</span>
                <button type="submit" class="bp-danger-button bp-button-compact text-nowrap" data-confirm-action data-confirm-title="Remove battery family" data-confirm-message="Remove this battery family, its name and picture? It can't be undone." data-confirm-submit="Remove">Remove battery family</button>
            </form>
        }
    </details>
    @* Asks before a removal that can't be undone (redesign R6). *@
    @await Html.PartialAsync("_ConfirmModal")
</main>

@section Scripts {
    <script src="~/js/bp-record-editor.js" asp-append-version="true"></script>
    <script src="~/js/bp-confirm.js" asp-append-version="true"></script>
}
