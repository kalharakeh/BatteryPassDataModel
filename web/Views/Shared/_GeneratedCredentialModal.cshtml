@model string
@if (!string.IsNullOrWhiteSpace(Model))
{
    <div class="bp-generated-token-modal" data-generated-token-modal data-generated-token-value="@Model">
        <div class="bp-generated-token-backdrop"></div>
        <section class="bp-generated-token-panel" role="dialog" aria-modal="true" aria-labelledby="bp-generated-token-title">
            <p class="bp-summary-title">Generated token</p>
            <h2 id="bp-generated-token-title">Store this credential now</h2>
            <p class="bp-generated-token-copy">This token is shown only once. Copy it before leaving this page.</p>
            <code class="bp-generated-token-value" data-generated-token-text>@Model</code>
            <div class="bp-generated-token-actions">
                <button type="button" class="bp-secondary-button" data-generated-token-copy>Copy</button>
                <button type="button" class="bp-primary-button" data-generated-token-ok>Okay</button>
            </div>
        </section>
    </div>

    <script>
        (function () {
            const writeClipboard = async (value) => {
                if (!value) {
                    return;
                }

                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(value);
                    return;
                }

                const textarea = document.createElement('textarea');
                textarea.value = value;
                textarea.setAttribute('readonly', '');
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                textarea.remove();
            };

            document.querySelectorAll('[data-generated-token-modal]').forEach((modal) => {
                const value = modal.dataset.generatedTokenValue || '';
                const copyButton = modal.querySelector('[data-generated-token-copy]');
                const okayButton = modal.querySelector('[data-generated-token-ok]');

                copyButton?.addEventListener('click', async () => {
                    await writeClipboard(value);
                    copyButton.textContent = 'Copied';
                });

                okayButton?.addEventListener('click', async () => {
                    await writeClipboard(value);
                    modal.hidden = true;
                });
            });
        })();
    </script>
}
