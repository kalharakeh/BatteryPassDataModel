@model BatteryPassWeb.Models.ViewModels.BatteryTablePageViewModel

@if (!string.IsNullOrWhiteSpace(Model.AccessMessage))
{
    <div class="bp-card bp-alert-card">
        @Model.AccessMessage
    </div>
}

@if (Model.Rows.Count == 0)
{
    <div class="bp-card">
        @Model.EmptyLabel
    </div>
}
else
{
    <div class="bp-card bp-table-card">
        <div class="bp-table-scroll">
            <table class="table table-hover align-middle bp-console-table bp-shared-battery-table bp-mobile-card-table">
                <thead>
                    <tr>
                        <th>Battery serial number</th>
                        <th>Battery ID</th>
                        <th>Family</th>
                        <th>Model</th>
                        @* Battery Model *@
                        <th>Cluster</th>
                        <th>Passports</th>
                        <th>Status</th>
                        <th>Updated</th>
                        <th class="bp-action-cell">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var updated = string.IsNullOrWhiteSpace(row.UpdatedDate)
                            ? "-"
                            : row.UpdatedDate[..Math.Min(10, row.UpdatedDate.Length)];
                        var passportStatusClass = row.DisplayStatus.Equals("Published", StringComparison.OrdinalIgnoreCase)
                            || row.DisplayStatus.Equals("published", StringComparison.OrdinalIgnoreCase)
                                ? "bp-status-pill is-published"
                                : row.DisplayStatus.Equals("Signed", StringComparison.OrdinalIgnoreCase)
                                || row.DisplayStatus.Equals("signed", StringComparison.OrdinalIgnoreCase)
                                    ? "bp-status-pill is-signed"
                                    : "bp-status-pill is-draft";
                        <tr>
                            <td data-label="Battery serial number">@row.BatterySerialNumber</td>
                            <td data-label="Battery ID"><span class="bp-battery-id-cell bp-battery-id-cell-compact bp-id-copy-row"><span class="bp-id-value">@row.BatteryId</span>@await Html.PartialAsync("_CopyIdButton", row.BatteryId)</span></td>
                            <td data-label="Family">@row.BatteryFamily</td>
                            <td data-label="Model">@row.BatteryModel</td>
                            <td data-label="Cluster">
                                <strong>@row.ClusterLabel</strong>
                                @if (!string.IsNullOrWhiteSpace(row.ClusterId))
                                {
                                    <small class="d-block text-secondary">@row.ClusterId</small>
                                }
                            </td>
                            <td data-label="Passports">@row.PassportCount passports</td>
                            <td data-label="Status"><span class="@passportStatusClass" data-latest-passport-status="@row.LatestPassportStatus">@(row.ShowNewPassportRequired ? "New passport needed" : row.DisplayStatus)</span></td>
                            <td data-label="Updated">@updated</td>
                            <td class="bp-action-cell" data-label="Actions">
                                <div class="bp-icon-action-row">
                                    @if (!string.IsNullOrWhiteSpace(row.SummaryUrl))
                                    {
                                        <a href="@row.SummaryUrl" class="bp-report-action" aria-label="Summary report" title="Summary report" data-tooltip="Summary report" data-action-icon="summary">
                                            <svg class="bp-report-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M6 3h9l3 3v15H6z" />
                                                <path d="M15 3v4h4" />
                                                <path d="M9 11h6M9 15h6M9 19h4" />
                                            </svg>
                                        </a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.DetailUrl))
                                    {
                                        <a href="@row.DetailUrl" class="bp-report-action" aria-label="Detailed report" title="Detailed report" data-tooltip="Detailed report" data-action-icon="detail">
                                            <svg class="bp-report-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M6 3h9l3 3v15H6z" />
                                                <path d="M15 3v4h4" />
                                                <path d="M10 12a3 3 0 1 0 4.24 4.24" />
                                                <path d="m14 16 3 3" />
                                            </svg>
                                        </a>
                                    }
                                    @if (row.CanViewHistory && !string.IsNullOrWhiteSpace(row.HistoryUrl))
                                    {
                                        <a href="@row.HistoryUrl" class="bp-report-action" aria-label="Passport history" title="Passport history" data-tooltip="Passport history" data-action-icon="history">
                                            <svg class="bp-report-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M6 3h9l3 3v15H6z" />
                                                <path d="M15 3v4h4" />
                                                <path d="M9 11h6M9 15h6M9 19h4" />
                                            </svg>
                                        </a>
                                    }
                                    @if (row.CanEditBattery && !string.IsNullOrWhiteSpace(row.EditUrl))
                                    {
                                        <a href="@row.EditUrl" class="bp-action-button" aria-label="Edit battery" title="Edit battery" data-tooltip="Edit battery" data-action-icon="edit">
                                            <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M4 20h4l11-11a2.5 2.5 0 0 0-4-4L4 16z" />
                                                <path d="M13.5 6.5l4 4" />
                                            </svg>
                                        </a>
                                    }
                                    @if (row.CanOpenConformance && !string.IsNullOrWhiteSpace(row.ConformanceUrl))
                                    {
                                        <a href="@row.ConformanceUrl" class="bp-action-button" aria-label="Conformance" title="Conformance" data-tooltip="Conformance" data-action-icon="conformance">
                                            <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M12 3l7 3v5c0 4.4-2.8 8.4-7 10-4.2-1.6-7-5.6-7-10V6z" />
                                                <path d="M8.5 12.5l2.2 2.2 4.8-5" />
                                            </svg>
                                        </a>
                                    }
                                    @if (row.CanCreatePassport && !string.IsNullOrWhiteSpace(row.CreatePassportUrl))
                                    {
                                        <form method="post" action="@row.CreatePassportUrl">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@row.ReturnUrl" />
                                            <button type="submit" class="bp-action-button" aria-label="Create passport" title="Create passport" data-tooltip="Create passport" data-action-icon="create-passport">
                                                <svg class="bp-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M6 3h8l4 4v14H6z" />
                                                    <path d="M14 3v5h5" />
                                                    <path d="M12 11v6" />
                                                    <path d="M9 14h6" />
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
