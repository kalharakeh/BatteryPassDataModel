@model string
@inject BatteryPassWeb.Services.AccessControlService Access
@{
    // The cluster admin pages' heading and tabs. The page names the clusters it is about in ViewData["ClusterAdminScope"].
    var activeTab = Model ?? string.Empty;
    string TabClass(string tab) => activeTab.Equals(tab, StringComparison.OrdinalIgnoreCase) ? "bp-tab bp-tab-active" : "bp-tab";
    bool IsSelected(string tab) => activeTab.Equals(tab, StringComparison.OrdinalIgnoreCase);
    var scope = ViewData["ClusterAdminScope"] as string;
    // The customer's own ID, which a hand-over asks for (finding U30); the team runs no customer of its own.
    var customerIds = BatteryPassWeb.Services.AccessControlService.IsAdmin(User)
        ? (IReadOnlyCollection<string>)[]
        : (await Access.GetAdministeredClusterIdsForUserAsync(User)).Order(StringComparer.OrdinalIgnoreCase).ToArray();
}

<div class="bp-admin-heading">
    <h1>Admin</h1>
    <p>Batteries, users and API tokens for @(string.IsNullOrWhiteSpace(scope) ? "the customers you run" : scope).</p>
    @await Html.PartialAsync("_CustomerId", customerIds)
</div>

<form class="bp-admin-mobile-tab-form mt-4" aria-label="Admin section">
    <label for="bp-cluster-admin-mobile-tab-select">Admin section</label>
    <select id="bp-cluster-admin-mobile-tab-select" data-admin-mobile-tab-select>
        <option value="/cluster-admin/batteries" selected="@IsSelected("batteries")">Batteries</option>
        <option value="/cluster-admin/users" selected="@IsSelected("users")">Users</option>
        <option value="/cluster-admin/api-tokens" selected="@IsSelected("api-tokens")">API tokens</option>
    </select>
</form>

<nav class="bp-local-admin-nav" aria-label="Admin tabs">
    <div class="bp-tab-row">
        @* The area opens on its batteries and keeps its tabs on each of its pages (finding U14). *@
        <a class="@TabClass("batteries")" href="/cluster-admin/batteries">Batteries</a>
        <a class="@TabClass("users")" href="/cluster-admin/users">Users</a>
        <a class="@TabClass("api-tokens")" href="/cluster-admin/api-tokens">API tokens</a>
    </div>
</nav>
