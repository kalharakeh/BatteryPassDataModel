@inject BatteryPassWeb.Services.ClusterRepository ClusterRepository
@{
    var title = ViewData["Title"] as string ?? "Scania Battery Passport Viewer";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var showAdminLink = User.IsInRole("admin");
    var showClusterAdminLink = User.IsInRole("clusterAdmin") && !showAdminLink;
    var identityLabel = string.Empty;
    var clusterNames = new List<string>();

    if (isAuthenticated)
    {
        identityLabel = BatteryPassWeb.Services.AccessControlService.CurrentEmail(User);
        var memberships = await ClusterRepository.GetClusterMembershipsForUserAsync(identityLabel);
        var clusters = await ClusterRepository.ListClustersAsync();
        var clusterNameById = clusters
            .Select(cluster => new
            {
                ClusterId = BatteryPassWeb.Services.BsonHelpers.GetString(cluster, "clusterId"),
                Name = BatteryPassWeb.Services.BsonHelpers.GetString(cluster, "name")
            })
            .Where(cluster => !string.IsNullOrWhiteSpace(cluster.ClusterId))
            .ToDictionary(cluster => cluster.ClusterId, cluster => cluster.Name, StringComparer.OrdinalIgnoreCase);

        clusterNames = memberships
            .Select(membership => BatteryPassWeb.Services.BsonHelpers.GetString(membership, "clusterId"))
            .Where(clusterId => !string.IsNullOrWhiteSpace(clusterId))
            .Select(clusterId => clusterNameById.TryGetValue(clusterId, out var name) ? name : clusterId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Scania Battery Passport Viewer</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="bp-shell">
        <header class="bp-header">
            <div class="bp-header-inner">
                <a class="bp-brand" href="/">
                    <img src="~/scanialogo.png" alt="Scania logo" class="bp-brand-logo" />
                    <span class="bp-brand-text">Scania Battery Passport Viewer</span>
                </a>
                <nav class="bp-nav">
                    @if (showAdminLink)
                    {
                        <a href="/admin">Admin</a>
                    }
                    else if (showClusterAdminLink)
                    {
                        <a href="/cluster-admin">Cluster admin</a>
                    }

                    @if (isAuthenticated)
                    {
                        <a href="/help">Help</a>
                    }

                    @if (isAuthenticated)
                    {
                        <div class="bp-identity">
                            <p>@identityLabel</p>
                            <p>@(clusterNames.Count > 0 ? string.Join(", ", clusterNames) : "No cluster")</p>
                        </div>
                        <form method="post" action="/login/logout" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="bp-link-button">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a href="/login">Login</a>
                    }
                </nav>
            </div>
        </header>

        <main class="bp-main">
            @RenderBody()
        </main>

        <footer class="bp-footer">
            Internal demonstrator. Sample values are for demonstration purposes only.
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
