@inject BatteryPassWeb.Services.ClusterRepository ClusterRepository
@{
    var title = ViewData["Title"] as string ?? BatteryPassWeb.Services.TopBar.AppName;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var requestPath = Context.Request.Path;
    // On the error and "not found" pages the theme button leads home, not back to the error (review 1 of N1, point 6).
    var returnUrl = requestPath.Equals(BatteryPassWeb.Configuration.ErrorPages.ErrorPath, StringComparison.OrdinalIgnoreCase)
        || requestPath.Equals(BatteryPassWeb.Configuration.ErrorPages.NotFoundPath, StringComparison.OrdinalIgnoreCase)
            ? $"{Context.Request.PathBase}/"
            : $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var theme = BatteryPassWeb.Controllers.ThemeController.NormalizeTheme(
        Context.Request.Cookies[BatteryPassWeb.Controllers.ThemeController.ThemeCookieName]);
    var nextTheme = theme.Equals("dark", StringComparison.OrdinalIgnoreCase) ? "light" : "dark";
    var themeLabel = nextTheme.Equals("dark", StringComparison.OrdinalIgnoreCase) ? "Switch to dark mode" : "Switch to light mode";
    var mainClass = requestPath.StartsWithSegments("/registry")
        || requestPath.StartsWithSegments("/admin")
        || requestPath.StartsWithSegments("/cluster-admin")
            ? "bp-main-wide"
            : string.Empty;

    // The one top bar (finding L04): the main links by who is signed in, and the account as initials and a name.
    var topLinks = BatteryPassWeb.Services.TopBar.Links(User, requestPath.Value);
    var account = await BatteryPassWeb.Services.TopBar.AccountAsync(User, ClusterRepository);
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(title == BatteryPassWeb.Services.TopBar.AppName ? title : $"{title} - {BatteryPassWeb.Services.TopBar.AppName}")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bp-status.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_Icons")
    <div class="bp-shell">
        @* The one top bar (finding L04, the owner's picture of 13 Nov 2026): the name, the main links, the account menu. On a
           phone the links move into the account menu; a visitor keeps Help, the theme and Log in in the bar. *@
        <header class="bp-topbar@(account is null ? " is-visitor" : string.Empty)">
            <a class="bp-topbar-brand" href="/" aria-label="Battery Passport, home">
                <img src="~/images/scania_wordmark_blue_rgb.svg" alt="Scania" class="bp-topbar-wordmark bp-mark-white" />
                <span class="bp-topbar-divider" aria-hidden="true"></span>
                <span class="bp-topbar-product">Battery Passport</span>
            </a>
            <nav class="bp-topbar-nav" aria-label="Main">
                @foreach (var link in topLinks)
                {
                    <a href="@link.Href" class="@(link.Current ? "is-current" : null)" aria-current="@(link.Current ? "page" : null)">@link.Text@if (link.CountsWaiting){<partial name="_WaitingCount" />}</a>
                }
            </nav>
            @if (account is not null)
            {
                <details class="bp-account" data-account-menu>
                    <summary class="bp-account-button" aria-label="Account menu, @account.Name">
                        <span class="bp-account-initials" aria-hidden="true">@account.Initials</span>
                        <span class="bp-account-name" aria-hidden="true">@account.Name</span>
                        <svg class="bp-account-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
                    </summary>
                    <div class="bp-account-panel">
                        <div class="bp-account-who">
                            <strong>@account.Name</strong>
                            <span>@account.Email</span>
                            <span>@account.Role</span>
                            @if (account.Customer is { } customer)
                            {
                                <span>Customer: @customer</span>
                            }
                        </div>
                        <nav class="bp-account-links" aria-label="Main, in the account menu">
                            @foreach (var link in topLinks)
                            {
                                <a href="@link.Href" aria-current="@(link.Current ? "page" : null)">@link.Text@if (link.CountsWaiting){<partial name="_WaitingCount" />}</a>
                            }
                        </nav>
                        <a class="bp-account-item" href="/account">Your account</a>
                        <form method="post" action="/theme" class="bp-account-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="theme" value="@nextTheme" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="bp-account-item">@(nextTheme == "dark" ? "Dark mode" : "Light mode")</button>
                        </form>
                        <form method="post" action="/login/logout" class="bp-account-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="bp-account-item">Log out</button>
                        </form>
                    </div>
                </details>
            }
            else
            {
                <div class="bp-topbar-visitor">
                    <form method="post" action="/theme" class="bp-theme-toggle-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="theme" value="@nextTheme" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="bp-theme-toggle" aria-label="@themeLabel" title="@themeLabel">
                            @if (theme.Equals("dark", StringComparison.OrdinalIgnoreCase))
                            {
                                <svg class="bp-theme-toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="12" r="4" />
                                    <path d="M12 2v2" />
                                    <path d="M12 20v2" />
                                    <path d="m4.93 4.93 1.41 1.41" />
                                    <path d="m17.66 17.66 1.41 1.41" />
                                    <path d="M2 12h2" />
                                    <path d="M20 12h2" />
                                    <path d="m6.34 17.66-1.41 1.41" />
                                    <path d="m19.07 4.93-1.41 1.41" />
                                </svg>
                            }
                            else
                            {
                                <svg class="bp-theme-toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.5 6.5 0 0 0 9.8 9.8Z" />
                                </svg>
                            }
                        </button>
                    </form>
                    <a class="bp-topbar-login" href="/login">Log in</a>
                </div>
            }
            <script src="~/js/bp-topbar.js" asp-append-version="true" defer></script>
        </header>

        <main class="bp-main @mainClass">
            @RenderBody()
        </main>

        @* One footer for everyone (finding L05): the bar holds the menu; the Help links the API reference. *@
        <footer class="bp-footer">
            <div class="bp-footer-legal">
                <div class="bp-footer-legal-inner">
                    <div class="bp-footer-link-row" aria-label="Footer links">
                        <a href="https://www.scania.com/industrial-batteries/en/home.html" target="_blank" rel="noopener">Scania Industrial Batteries</a>
                        <a href="https://www.scania.com/se/sv/home.html" target="_blank" rel="noopener">Scania</a>
                    </div>
                    <p class="bp-footer-copy">Copyright Scania Industrial Batteries 2026 All rights reserved. Scania Industrial Batteries AB, SE-151 87 Stockholm, Sweden. Tel: +46-8-55 38 10 00</p>
                    <div class="bp-footer-wordmark" aria-label="Scania">
                        <img src="~/images/scania_wordmark_blue_rgb.svg" alt="Scania" class="bp-footer-wordmark-image bp-mark-white" />
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script>
        (function () {
            async function copyText(value) {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(value);
                    return;
                }

                const input = document.createElement('textarea');
                input.value = value;
                input.setAttribute('readonly', '');
                input.style.position = 'fixed';
                input.style.top = '-1000px';
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                input.remove();
            }

            document.addEventListener('click', async function (event) {
                const button = event.target.closest('[data-copy-id-button]');
                if (!button) {
                    return;
                }

                const targetSelector = button.getAttribute('data-copy-target') || '';
                const target = targetSelector ? document.querySelector(targetSelector) : null;
                const value = target && 'value' in target
                    ? target.value
                    : button.getAttribute('data-copy-value') || '';
                if (!value) {
                    return;
                }

                const originalLabel = button.getAttribute('aria-label') || 'Copy ID';
                const originalTooltip = button.getAttribute('data-tooltip') || 'Copy ID';
                try {
                    await copyText(value);
                    button.classList.add('is-copied');
                    button.setAttribute('aria-label', 'Copied');
                    button.setAttribute('title', 'Copied');
                    button.setAttribute('data-tooltip', 'Copied');
                    window.setTimeout(function () {
                        button.classList.remove('is-copied');
                        button.setAttribute('aria-label', originalLabel);
                        button.setAttribute('title', originalTooltip);
                        button.setAttribute('data-tooltip', originalTooltip);
                    }, 1400);
                } catch {
                    button.setAttribute('data-tooltip', 'Copy failed');
                    button.setAttribute('title', 'Copy failed');
                }
            });

            document.addEventListener('change', function (event) {
                const select = event.target.closest('[data-admin-mobile-tab-select]');
                if (!select || !select.value) {
                    return;
                }

                window.location.href = select.value;
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
