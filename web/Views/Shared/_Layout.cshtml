@inject BatteryPassWeb.Services.ClusterRepository ClusterRepository
@{
    var title = ViewData["Title"] as string ?? "Scania Battery Passport Viewer";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var showAdminLink = User.IsInRole("admin");
    var showClusterAdminLink = User.IsInRole("clusterAdmin") && !showAdminLink;
    var identityLabel = string.Empty;
    var customerName = string.Empty;
    var customerRole = string.Empty;
    var clusterNames = new List<string>();
    var requestPath = Context.Request.Path;
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var theme = BatteryPassWeb.Controllers.ThemeController.NormalizeTheme(
        Context.Request.Cookies[BatteryPassWeb.Controllers.ThemeController.ThemeCookieName]);
    var nextTheme = theme.Equals("dark", StringComparison.OrdinalIgnoreCase) ? "light" : "dark";
    var themeLabel = nextTheme.Equals("dark", StringComparison.OrdinalIgnoreCase) ? "Switch to dark mode" : "Switch to light mode";
    var mainClass = requestPath.StartsWithSegments("/registry")
        || requestPath.StartsWithSegments("/admin")
        || requestPath.StartsWithSegments("/cluster-admin")
            ? "bp-main-wide"
            : string.Empty;

    if (isAuthenticated)
    {
        identityLabel = BatteryPassWeb.Services.AccessControlService.CurrentEmail(User);
        customerRole = BatteryPassWeb.Services.AccessControlService.DisplayRoleLabel(User);
        var userDocument = await ClusterRepository.GetUserByEmailAsync(identityLabel);
        customerName = userDocument == null
            ? User.Identity?.Name ?? identityLabel
            : BatteryPassWeb.Services.BsonHelpers.GetString(userDocument, "name");
        if (string.IsNullOrWhiteSpace(customerName))
        {
            customerName = identityLabel;
        }

        var memberships = await ClusterRepository.GetClusterMembershipsForUserAsync(identityLabel);
        var clusters = await ClusterRepository.ListClustersAsync();
        var clusterNameById = clusters
            .Select(cluster => new
            {
                ClusterId = BatteryPassWeb.Services.BsonHelpers.GetString(cluster, "clusterId"),
                Name = BatteryPassWeb.Services.BsonHelpers.GetString(cluster, "name")
            })
            .Where(cluster => !string.IsNullOrWhiteSpace(cluster.ClusterId))
            .ToDictionary(cluster => cluster.ClusterId, cluster => cluster.Name, StringComparer.OrdinalIgnoreCase);

        clusterNames = memberships
            .Select(membership => BatteryPassWeb.Services.BsonHelpers.GetString(membership, "clusterId"))
            .Where(clusterId => !string.IsNullOrWhiteSpace(clusterId))
            .Select(clusterId => clusterNameById.TryGetValue(clusterId, out var name) ? name : clusterId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Scania Battery Passport Viewer</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="bp-shell">
        <header class="bp-header bp-scania-header">
            <div class="bp-header-top-row">
                <div class="bp-header-title-group">
                    <a class="bp-header-wordmark" href="/" aria-label="Scania">
                        <img src="~/images/scania_wordmark_blue_rgb.svg" alt="Scania" class="bp-header-wordmark-image bp-mark-white" />
                    </a>
                    <span class="bp-header-divider" aria-hidden="true"></span>
                    <span class="bp-market-label">Battery Passport</span>
                </div>
                <a class="bp-header-symbol-link" href="/" aria-label="Scania Battery Passport home">
                    <img src="~/images/scania_symbol_L_rgb.svg" alt="Scania symbol" class="bp-header-symbol-logo" />
                </a>
            </div>
            <div class="bp-header-nav-row">
                <nav class="bp-nav bp-header-actions" aria-label="Main navigation">
                    <div class="bp-header-right-group">
                        <div class="bp-header-primary-links">
                        @if (isAuthenticated)
                        {
                            <a href="/registry">Open Registry</a>
                        }

                        @if (showAdminLink)
                        {
                            <a href="/admin">Admin</a>
                        }
                        else if (showClusterAdminLink)
                        {
                            <a href="/cluster-admin">Cluster admin</a>
                        }

                        @if (isAuthenticated)
                        {
                            <a href="/help">Help</a>
                            <a href="/account">Account</a>
                        }
                        </div>
                        @if (isAuthenticated)
                        {
                            <div class="bp-identity">
                                <p>@identityLabel</p>
                                <p>@customerName / @customerRole</p>
                                <p>@(clusterNames.Count > 0 ? string.Join(", ", clusterNames) : "No cluster")</p>
                            </div>
                        }
                        <div class="bp-header-account-links">
                            <form method="post" action="/theme" class="bp-theme-toggle-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="theme" value="@nextTheme" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="bp-theme-toggle" aria-label="@themeLabel" title="@themeLabel" data-tooltip="@themeLabel">
                                    @if (theme.Equals("dark", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <svg class="bp-theme-toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <circle cx="12" cy="12" r="4" />
                                            <path d="M12 2v2" />
                                            <path d="M12 20v2" />
                                            <path d="m4.93 4.93 1.41 1.41" />
                                            <path d="m17.66 17.66 1.41 1.41" />
                                            <path d="M2 12h2" />
                                            <path d="M20 12h2" />
                                            <path d="m6.34 17.66-1.41 1.41" />
                                            <path d="m19.07 4.93-1.41 1.41" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="bp-theme-toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.5 6.5 0 0 0 9.8 9.8Z" />
                                        </svg>
                                    }
                                </button>
                            </form>
                        @if (isAuthenticated)
                        {
                            <form method="post" action="/login/logout" class="bp-header-logout-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="bp-link-button">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a href="/login">Login</a>
                        }
                        </div>
                    </div>
                </nav>
            </div>
        </header>

        <main class="bp-main @mainClass">
            @RenderBody()
        </main>

        <footer class="bp-footer">
            <div class="bp-footer-extended">
                <div class="bp-footer-columns">
                    <section class="bp-footer-column" aria-labelledby="bp-footer-passport">
                        <h2 id="bp-footer-passport">BATTERY PASSPORT</h2>
                        <ul>
                            <li><a href="/">Search passport</a></li>
                            @if (isAuthenticated)
                            {
                                <li><a href="/registry">Open registry</a></li>
                            }
                        </ul>
                    </section>
                    <section class="bp-footer-column" aria-labelledby="bp-footer-tools">
                        <h2 id="bp-footer-tools">TOOLS</h2>
                        <ul>
                            @if (showAdminLink)
                            {
                                <li><a href="/admin">Admin workspace</a></li>
                            }
                            else if (showClusterAdminLink)
                            {
                                <li><a href="/cluster-admin">Cluster workspace</a></li>
                            }
                            @if (isAuthenticated)
                            {
                                <li><a href="/help">Developer help</a></li>
                            }
                            @if (!isAuthenticated)
                            {
                                <li><a href="/login">Account access</a></li>
                            }
                        </ul>
                    </section>
                </div>
            </div>
            <div class="bp-footer-legal">
                <div class="bp-footer-legal-inner">
                    <div class="bp-footer-link-row" aria-label="Footer links">
                        <a href="https://www.scania.com/industrial-batteries/en/home.html" target="_blank" rel="noopener">Scania Industrial Batteries</a>
                        <a href="https://www.scania.com/se/sv/home.html" target="_blank" rel="noopener">Scania</a>
                    </div>
                    <p class="bp-footer-copy">Copyright Scania Industrial Batteries 2026 All rights reserved. Scania Industrial Batteries AB, SE-151 87 Stockholm, Sweden. Tel: +46-8-55 38 10 00</p>
                    <div class="bp-footer-wordmark" aria-label="Scania">
                        <img src="~/images/scania_wordmark_blue_rgb.svg" alt="Scania" class="bp-footer-wordmark-image bp-mark-white" />
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            async function copyText(value) {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(value);
                    return;
                }

                const input = document.createElement('textarea');
                input.value = value;
                input.setAttribute('readonly', '');
                input.style.position = 'fixed';
                input.style.top = '-1000px';
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                input.remove();
            }

            document.addEventListener('click', async function (event) {
                const button = event.target.closest('[data-copy-id-button]');
                if (!button) {
                    return;
                }

                const value = button.getAttribute('data-copy-value') || '';
                if (!value) {
                    return;
                }

                const originalLabel = button.getAttribute('aria-label') || 'Copy ID';
                const originalTooltip = button.getAttribute('data-tooltip') || 'Copy ID';
                try {
                    await copyText(value);
                    button.classList.add('is-copied');
                    button.setAttribute('aria-label', 'Copied');
                    button.setAttribute('title', 'Copied');
                    button.setAttribute('data-tooltip', 'Copied');
                    window.setTimeout(function () {
                        button.classList.remove('is-copied');
                        button.setAttribute('aria-label', originalLabel);
                        button.setAttribute('title', originalTooltip);
                        button.setAttribute('data-tooltip', originalTooltip);
                    }, 1400);
                } catch {
                    button.setAttribute('data-tooltip', 'Copy failed');
                    button.setAttribute('title', 'Copy failed');
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
