@model string
@{
    var copyValue = Model ?? string.Empty;
}
@if (!string.IsNullOrWhiteSpace(copyValue))
{
    <button type="button" class="bp-copy-id-button" aria-label="Copy ID" title="Copy ID" data-tooltip="Copy ID" data-copy-id-button data-copy-value="@copyValue">
        <svg class="bp-copy-id-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="10" height="10" rx="2" />
            <path d="M6 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1" />
        </svg>
    </button>
}
