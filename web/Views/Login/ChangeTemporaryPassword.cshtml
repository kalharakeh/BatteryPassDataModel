@model BatteryPassWeb.Models.ViewModels.TemporaryPasswordChangeViewModel
@{
    ViewData["Title"] = "Change temporary password";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Change temporary password</h1>
                @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                {
                    <div class="alert alert-info">@Model.StatusMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form method="post" action="/login/change-temporary-password">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label" for="Email">Email</label>
                        <input class="form-control" type="email" id="Email" name="Email" value="@Model.Email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="TemporaryPassword">Temporary password</label>
                        <input class="form-control" type="password" id="TemporaryPassword" name="TemporaryPassword" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Password">New password</label>
                        <input class="form-control" type="password" id="Password" name="Password" minlength="8" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="PasswordConfirmation">Confirm new password</label>
                        <input class="form-control" type="password" id="PasswordConfirmation" name="PasswordConfirmation" minlength="8" required />
                    </div>
                    <button type="submit" class="btn btn-success w-100">Save new password</button>
                </form>
                <p class="small text-secondary mt-3 mb-0">
                    Temporary passwords expire after 60 minutes. You must choose a new password before continuing.
                </p>
            </div>
        </div>
    </div>
</div>
